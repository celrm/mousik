%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Tools

\newcounter{Mevaluate}

\newcounter{Mmodulo}
\newcommand{\MModulo}[2]{
	\setcounter{Mmodulo}{#1}
	\setcounter{Mevaluate}{#2}
	\addtocounter{Mevaluate}{-1}
	\loop
	\ifnum\theMmodulo>\theMevaluate
		\addtocounter{Mmodulo}{-#2}
		\repeat
	\ifnum\theMmodulo<0
		\addtocounter{Mmodulo}{#2}
		\repeat
}

\newcounter{Mmax}
\newcommand{\MMax}[2][\theMmax]{
	\setcounter{Mmax}{#1}
	\ifnum#2>#1
		\setcounter{Mmax}{#2}
	\fi
}

\newcounter{Mmin}
\newcommand{\MMin}[2][\theMmin]{
	\setcounter{Mmin}{#1}
	\ifnum#2<#1
		\setcounter{Mmin}{#2}
	\fi
}

\newcounter{Mcount}
\newcommand{\MCount}[1]{
	\setcounter{Mcount}{0}
	\foreach\IND in {#1} {\ifthenelse{\equal{\IND}{!}}{}{\stepcounter{Mcount}}}
}

\newcommand{\MStringz}[3]{
\ifthenelse{\equal{#1}{#2}}
{#3}{}
}

\newcommand{\MString}[3]{
\ifthenelse{\equal{#1}{\string #2}}
{#3}{}
}

\newcommand{\MNEmpty}[2]{
	\ifthenelse{\equal{#1}{}}
	{}{#2}
}

\newcommand{\MX}{0.0625}
\newcommand{\XM}{16}

