% Notes : everything together

\newif\ifMnoteBack
\pgfkeys{
	/Mnote/.is family
	, /Mnote
	, default/.style = 
	{	back = false
		, beam = 1
		, stem = 0.5
		, head = .
		, swap = false
		, tuplet = 0
		, xshift = 0
		, yshift = 0
	}
	, back/.is if=MnoteBack
	, beam/.estore in=\M@beam
	, stem/.estore in=\M@stem
	, head/.estore in=\M@head
	, tuplet/.estore in=\M@tuplet
	, swap/.is if=Mswap
	, xshift/.estore in=\M@shiftX
	, yshift/.estore in=\MshiftY
}
\newcounter{M@duration}
\newcommand{\Note}[3][]{ % #1 = options, #2 = duration, #3 = note(s)
	\pgfkeys{/Mnote, default, #1}%
	\Adv \noMswaptrue
	\ifMswap \Swap \fi
	\setcounter{M@aux}{\theMX}	
\begin{scope}[xshift=\M@shiftX cm,yshift=\MshiftY cm]
	\M@Count{#2}\setcounter{M@duration}{\theM@count}
	\M@Count{#3}
\ifnum\theM@duration=1 % only one duration
	\ifnum#2=1 \foreach\IND in {#3} {\Semibreve{\IND}\M@addMX} \else
	\ifnum#2=2 \foreach\IND in {#3} {\Minim{\IND}\M@addMX} \else
	\ifnum#2=4 \foreach\IND in {#3} {\Crotchet{\IND}\M@addMX} \else
	\ifnum\theM@count=1 % single note (8 and above)
		\ifnum#2=8 \Quaver{#3} \else
		\ifnum#2=16 \Semiquaver{#3} \else
		\ifnum#2=32 \Demisemiquaver{#3} \fi\fi\fi
	\else \ifnum\theM@count=2 % two notes together
			\M@TwoNote{#2}{#3}
		\else \ifnum\theM@count>2 % more than two notes together
			\M@FlatNote{#2}{#3}
		\fi\fi\fi
	\fi\fi\fi
	
\else \M@MixedNote{#2}{#3} \fi % more than one duration

	\setcounter{MX}{\theM@aux}\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
	\foreach \IND in {#3} {
		\ifthenelse{\equal{\IND}{!}}{\M@addhalfMX}{
		\M@NotEmpty{\IND}{\Ledger{\IND}}
		\M@addMX}
	}
	\M@addMX
	
	\ifthenelse{\equal{\M@tuplet}{0}}{}{\Tuplet[\M@tuplet]}
	\end{scope}
}

\newcommand{\M@MixedNote}[2]{
	\setcounter{M@duration}{8}
	\foreach\INDd in {#1} {
		\ifnum\theM@duration<16
			\M@EqStr{\INDd}{=}{\setcounter{M@duration}{16}}
			\M@EqStr{\INDd}{=|}{\setcounter{M@duration}{16}}
			\M@EqStr{\INDd}{|=}{\setcounter{M@duration}{16}}
			\M@EqStr{\INDd}{//}{\setcounter{M@duration}{16}}
			\M@EqStr{\INDd}{//|}{\setcounter{M@duration}{16}}
			\M@EqStr{\INDd}{|//}{\setcounter{M@duration}{16}}
		\fi\ifnum\theM@duration<32
			\M@EqStr{\INDd}{≡}{\setcounter{M@duration}{32}}
			\M@EqStr{\INDd}{≡|}{\setcounter{M@duration}{32}}
			\M@EqStr{\INDd}{|≡}{\setcounter{M@duration}{32}}
			\M@EqStr{\INDd}{///}{\setcounter{M@duration}{32}}
			\M@EqStr{\INDd}{///|}{\setcounter{M@duration}{32}}
			\M@EqStr{\INDd}{|///}{\setcounter{M@duration}{32}}
		\fi
	}
	
	\M@Heads{#2}
	\ifnum\theM@max<6
		\ifnoMswap \pgfmathsetmacro{\M@heightBeam}{\theM@max}
		\else \pgfmathsetmacro{\M@heightBeam}{\theM@min} \fi
	\else 
		\Swap
		\ifnoMswap \pgfmathsetmacro{\M@heightBeam}{\theM@min}
		\else \pgfmathsetmacro{\M@heightBeam}{\theM@max} \fi
	\fi
	
	\setcounter{MX}{\theM@aux}
	\ifnum\theM@duration<16
	\pgfmathsetmacro\M@Sstem{\M@stem+0.1}
	\fi\ifnum\theM@duration=16
	\pgfmathsetmacro\M@Sstem{\M@stem+0.2}
	\fi\ifnum\theM@duration=32
	\pgfmathsetmacro\M@Sstem{\M@stem+0.3}
	\fi
	\foreach\IND in {#2} {
		\ifthenelse{\equal{\IND}{!}}{\M@addhalfMX}{
		\M@NotEmpty{\IND}{\M@enlarge[\M@Sstem]{\IND}{\M@heightBeam}}
		\M@addMX}
	}

\ifnoMswap {\pgfmathparse{1}} \else {\pgfmathparse{-1}} \fi
\pgfmathsetmacro\M@High{int(\pgfmathresult * 10*\M@Sstem + \M@heightBeam*0.0625*10)}
\setcounter{M@height}{\M@High}
	\setcounter{Mlast}{-1}
	\ifnum\theM@duration<16
		\pgfmathsetmacro\M@Sstem{\M@stem+0.1}
		\Be@m{\theM@aux}{\M@heightBeam}{\M@heightBeam}{+\M@Sstem}
	\fi\ifnum\theM@duration=16
		\pgfmathsetmacro\M@Sstem{\M@stem+0.2}
		\Be@m{\theM@aux}{\M@heightBeam}{\M@heightBeam}{+\M@Sstem}
	
		\setcounter{MX}{\theM@aux}\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
		\setcounter{M@first}{-50}
		\pgfmathsetmacro\M@Sstem{\M@stem+0.05}
		\foreach\INDd in {#1} {
			\ifthenelse{\equal{\INDd}{!}}
			{\M@addhalfMX}
			{\M@addMX}
			\MM@ixedBeam{\INDd}
		}
	
	\fi\ifnum\theM@duration=32
		\pgfmathsetmacro\M@Sstem{\M@stem+0.3}
		\Be@m{\theM@aux}{\M@heightBeam}{\M@heightBeam}{+\M@Sstem}
		
		\setcounter{MX}{\theM@aux}\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
		\setcounter{M@first}{-50}
		\pgfmathsetmacro\M@Sstem{\M@stem+0.15}
		\foreach\INDd in {#1} {
			\ifthenelse{\equal{\INDd}{!}}
				{\M@addhalfMX}
				{\M@addMX}
				\MM@ixedBeam{\INDd}
		}
	\fi
}
\newcounter{Mlast}
\newcounter{Mlasted}
\newcommand{\MM@ixedBeam}[1]{
	\M@EqStr{#1}{!}{\setcounter{Mlasted}{\theMlast}}
	\M@EqStr{#1}{}{\setcounter{Mlasted}{-1*\theMlast}}
	%
	\setcounter{Mlast}{8}
	\M@EqStr{#1}{=}
		{\setcounter{Mlast}{16}
		\Be@m[-0.275+\theMX]{-0.247+\theMX}{\M@heightBeam}{\M@heightBeam}{+\M@Sstem}}
	\M@EqStr{#1}{//}
		{\setcounter{Mlast}{16}
		\Be@m[-0.275+\theMX]{-0.247+\theMX}{\M@heightBeam}{\M@heightBeam}{+\M@Sstem}}
	\M@EqStr{#1}{=|}
		{\setcounter{Mlast}{16}
		\Be@m[-0.275+\theMX]{-0.5+\theMX}{\M@heightBeam}{\M@heightBeam}{+\M@Sstem}}
	\M@EqStr{#1}{//|}
		{\setcounter{Mlast}{16}
		\Be@m[-0.275+\theMX]{-0.5+\theMX}{\M@heightBeam}{\M@heightBeam}{+\M@Sstem}}
	\M@EqStr{#1}{|=}
		{\setcounter{Mlast}{16}
		\Be@m[\theMX]{-0.247+\theMX}{\M@heightBeam}{\M@heightBeam}{+\M@Sstem}}
	\M@EqStr{#1}{|//}
		{\setcounter{Mlast}{16}
		\Be@m[\theMX]{-0.247+\theMX}{\M@heightBeam}{\M@heightBeam}{+\M@Sstem}}
	%
	\M@EqStr{#1}{≡}
		{\setcounter{Mlast}{32}
		\Be@m[-0.275+\theMX]{-0.247+\theMX}{\M@heightBeam}{\M@heightBeam}{+\M@Sstem}
		\Be@m[-0.275+\theMX]{-0.247+\theMX}{\M@heightBeam}{\M@heightBeam}{+\M@stem}}
	\M@EqStr{#1}{///}
		{\setcounter{Mlast}{32}
		\Be@m[-0.275+\theMX]{-0.247+\theMX}{\M@heightBeam}{\M@heightBeam}{+\M@Sstem}
		\Be@m[-0.275+\theMX]{-0.247+\theMX}{\M@heightBeam}{\M@heightBeam}{+\M@stem}}
	\M@EqStr{#1}{≡|}
		{\setcounter{Mlast}{32}
		\Be@m[-0.275+\theMX]{-0.5+\theMX}{\M@heightBeam}{\M@heightBeam}{+\M@Sstem}
		\Be@m[-0.275+\theMX]{-0.5+\theMX}{\M@heightBeam}{\M@heightBeam}{+\M@stem}}
	\M@EqStr{#1}{///|}
		{\setcounter{Mlast}{32}
		\Be@m[-0.275+\theMX]{-0.5+\theMX}{\M@heightBeam}{\M@heightBeam}{+\M@Sstem}
		\Be@m[-0.275+\theMX]{-0.5+\theMX}{\M@heightBeam}{\M@heightBeam}{+\M@stem}}
	\M@EqStr{#1}{|≡}
		{\setcounter{Mlast}{32}
		\Be@m[\theMX]{-0.247+\theMX}{\M@heightBeam}{\M@heightBeam}{+\M@Sstem}
		\Be@m[\theMX]{-0.247+\theMX}{\M@heightBeam}{\M@heightBeam}{+\M@stem}}
	\M@EqStr{#1}{|///}
		{\setcounter{Mlast}{32}
		\Be@m[\theMX]{-0.247+\theMX}{\M@heightBeam}{\M@heightBeam}{+\M@Sstem}
		\Be@m[\theMX]{-0.247+\theMX}{\M@heightBeam}{\M@heightBeam}{+\M@stem}}
	%
	\ifnum\theMlast>\theMlasted \else
		\ifnum\theMlast=16
			\Be@m[-0.275+\theMX]{-1.047+\theMX}{\M@heightBeam}{\M@heightBeam}{+\M@Sstem}
		\fi\ifnum\theMlast=32
			\Be@m[-0.275+\theMX]{-1.047+\theMX}{\M@heightBeam}{\M@heightBeam}{+\M@Sstem}
			\Be@m[-0.275+\theMX]{-1.047+\theMX}{\M@heightBeam}{\M@heightBeam}{+\M@stem}
		\fi
	\fi\ifnum\theMlast=32 \ifnum\theMlasted=16
		\Be@m[-0.275+\theMX]{-1.047+\theMX}{\M@heightBeam}{\M@heightBeam}{+\M@Sstem}
	\fi\fi
	\ifnum\theMlast>-\theMlasted \else
		\ifnum\theMlast=16
			\Be@m[-0.275+\theMX]{-1.247+\theMX}{\M@heightBeam}{\M@heightBeam}{+\M@Sstem}
		\fi\ifnum\theMlast=32
			\Be@m[-0.275+\theMX]{-1.247+\theMX}{\M@heightBeam}{\M@heightBeam}{+\M@Sstem}
			\Be@m[-0.275+\theMX]{-1.247+\theMX}{\M@heightBeam}{\M@heightBeam}{+\M@stem}
		\fi
	\fi
	\ifthenelse{\equal{#1}{}}{}{\ifthenelse{\equal{#1}{!}}{}{\setcounter{Mlasted}{-2}}}
}

\newcommand{\M@TwoNote}[2]{
	\M@Heads{#2}

	\ifnum\theM@max<6
		\ifnoMswap \pgfmathsetmacro{\M@heightBeam}{\theM@min}
		\else \pgfmathsetmacro{\M@heightBeam}{\theM@max} \fi
	\else 
		\Swap
		\ifnoMswap \pgfmathsetmacro{\M@heightBeam}{\theM@max}
		\else \pgfmathsetmacro{\M@heightBeam}{\theM@min} \fi
	\fi

	\setcounter{MX}{\theM@aux}\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
	\ifnum#1<16
		\pgfmathsetmacro\M@Sstems{\M@stem+0.1}
	\fi\ifnum#1=16
		\pgfmathsetmacro\M@Sstems{\M@stem+0.2}	
	\fi\ifnum#1=32
		\pgfmathsetmacro\M@Sstems{\M@stem+0.3}
	\fi
	\foreach\IND in {#2} {\ifthenelse{\equal{\IND}{!}}{\M@addhalfMX}{
		\M@enlarge[\M@Sstems]{\IND}{\IND}\M@addMX}
	}

	\ifnoMswap {\pgfmathparse{1}} \else {\pgfmathparse{-1}} \fi
	\pgfmathsetmacro\M@High{int(\pgfmathresult *10*\M@Sstems + \M@heightBeam*0.0625*10)}
	\setcounter{M@height}{\M@High}
	\M@remMX
	\ifnum#1=8
		\pgfmathsetmacro\M@Sstem{\M@stem+0.1}
		\Be@mS{+\M@Sstem}
	\fi\ifnum#1=16
		\pgfmathsetmacro\M@Sstem{\M@stem+0.2}
		\Be@mS{+\M@Sstem}
		\pgfmathsetmacro\M@Sstem{\M@stem+0.05}
		\Be@mS{+\M@Sstem}
	\fi\ifnum#1=32
		\pgfmathsetmacro\M@Sstem{\M@stem+0.3}
		\Be@mS{+\M@Sstem}
		\pgfmathsetmacro\M@Sstem{\M@stem+0.15}
		\Be@mS{+\M@Sstem}
		\Be@mS{+\M@stem}
	\fi
}

\newcommand{\M@FlatNote}[2]{
	\M@Heads{#2}
	
	\ifnum\theM@max<6
		\ifnoMswap \pgfmathsetmacro{\M@heightBeam}{\theM@min}
		\else \pgfmathsetmacro{\M@heightBeam}{\theM@max} \fi
	\else 
		\Swap
		\ifnoMswap \pgfmathsetmacro{\M@heightBeam}{\theM@max}
		\else \pgfmathsetmacro{\M@heightBeam}{\theM@min} \fi
	\fi
	
	\setcounter{MX}{\theM@aux}\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
	\ifnum#1<16
	\pgfmathsetmacro\M@Sstem{\M@stem+0.1}
	\fi\ifnum#1=16
	\pgfmathsetmacro\M@Sstem{\M@stem+0.2}
	\fi\ifnum#1=32
	\pgfmathsetmacro\M@Sstem{\M@stem+0.3}
	\fi
	\foreach\IND in {#2} {\ifthenelse{\equal{\IND}{!}}{\M@addhalfMX}{
		\M@enlarge[\M@Sstem]{\IND}{\M@heightBeam}
		\M@addMX}
	}

	\ifnoMswap \pgfmathparse{1} \else \pgfmathparse{-1} \fi
	\pgfmathsetmacro\M@High{int(\pgfmathresult * 10*\M@Sstem + #1*0.0625*10)}
	\setcounter{M@height}{\M@High}

	\ifnum#1=8
		\pgfmathsetmacro\M@Sstem{\M@stem+0.1}
		\Be@m{\theM@aux}{\M@heightBeam}{\M@heightBeam}{+\M@Sstem}
	\fi\ifnum#1=16
		\pgfmathsetmacro\M@Sstem{\M@stem+0.2}
		\Be@m{\theM@aux}{\M@heightBeam}{\M@heightBeam}{+\M@Sstem}
		\pgfmathsetmacro\M@Sstem{\M@stem+0.05}
		\Be@m{\theM@aux}{\M@heightBeam}{\M@heightBeam}{+\M@Sstem}
	\fi\ifnum#1=32
		\pgfmathsetmacro\M@Sstem{\M@stem+0.3}
		\Be@m{\theM@aux}{\M@heightBeam}{\M@heightBeam}{+\M@Sstem}
		\pgfmathsetmacro\M@Sstem{\M@stem+0.15}
		\Be@m{\theM@aux}{\M@heightBeam}{\M@heightBeam}{+\M@Sstem}
		\Be@m{\theM@aux}{\M@heightBeam}{\M@heightBeam}{+\M@stem}
	\fi
}

