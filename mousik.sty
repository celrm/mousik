			\node [opacity=0.0] (tmp) at (\theMxpos*0.5,-\theMypos*2+#2*0.1) {};
			\clip (\theMxpos*0.5-0.125,-\theMypos*2+#2*0.1-0.55-#1) rectangle (\theMxpos*0.5+0.09,-\theMypos*2+#2*0.1+0.15-#1);
			\node[rotate around={180:(tmp.center)}] at (\theMxpos*0.5+0.175,-\theMypos*2+0.165+#2*0.1+#1) {\reflectbox{\resizebox{0.55cm}{0.65cm}{\Acht}}};
		\end{scope}
		\fill[white] (\theMxpos*0.5-0.035,-\theMypos*2-0.161+#2*0.1-#1) circle (2pt);
	\fi
	\ifswap\Mswap\fi
}

\newcommand{\Quaver}[1]{
	\Head{#1}
	\ifnum#1<6\else
		\Mswap
	\fi	
	\Enlarge[0.4]{#1}{#1}
	\Flag[0.4]{#1}
}
\newcommand{\Semiquaver}[1]{
	\Head{#1}
	\ifnum#1<6\else
		\Mswap
	\fi	
	\Enlarge[0.5]{#1}{#1}
	\Flag[0.5]{#1}
	\Flag[0.35]{#1}
}
\newcommand{\Demisemiquaver}[1]{
	\Head{#1}
	\ifnum#1<6\else
		\Mswap
	\fi	
	\Enlarge[0.6]{#1}{#1}
	\Flag[0.6]{#1}
	\Flag[0.45]{#1}
	\Flag[0.3]{#1}
}
\newcommand{\Note}[2]{
	\Adv\noswaptrue
	
	\ifnum#1=1
		\Semibreve{#2}
	\fi\ifnum#1=2
		\Minim{#2}
	\fi\ifnum#1=4
		\Crotchet{#2}
	\fi\ifnum#1=8
		\Quaver{#2}
	\fi\ifnum#1=16
		\Semiquaver{#2}
	\fi\ifnum#1=32
		\Demisemiquaver{#2}
	\fi
	
	\Ledger{#2}
	\addtocounter{Mxpos}{2}
	\swapfalse
}

\newcommand{\PolyNote}[2]{
	\Adv
	\setcounter{Mfirst}{-50}
	\setcounter{Mmax}{-50}
	\setcounter{Mmin}{50}
	\setcounter{Maux}{\theMxpos}
	
	\ifnum#1=1
	\foreach\n in {#2} {
		\Semibreve{\n}\stepcounter{Mxpos}}
	\fi\ifnum#1=2
	\foreach\n in {#2} {
		\Minim{\n}\stepcounter{Mxpos}}	
	\fi\ifnum#1=4
	\foreach\n in {#2} {
		\Crotchet{\n}\stepcounter{Mxpos}}
\fi\ifnum#1>4
	\foreach\n in {#2} {
		\Head{\n}\stepcounter{Mxpos}
		\MMax{\n}\MMin{\n} % max, min, first
		\ifnum\theMfirst=-50\setcounter{Mfirst}{\n}\fi
	}
	\noswaptrue
	\ifnum\theMmax<6\else
		\noswapfalse\fi
	\setcounter{Mevaluate}{\theMxpos}\addtocounter{Mevaluate}{-\theMaux}
	\setcounter{Mxpos}{\theMaux}
	\ifnum\theMevaluate=2 % only two notes
		\foreach\n in {#2} {
			\ifnum#1=8
			\Enlarge[0.4]{\n}{\n}
			\fi\ifnum#1=16
			\Enlarge[0.5]{\n}{\n}
			\fi\ifnum#1=32
			\Enlarge[0.6]{\n}{\n}
			\fi
			\stepcounter{Mxpos}
		}
		\addtocounter{Mxpos}{-1}
		\ifnum#1=8
			\BeamS{+0.4}
		\fi\ifnum#1=16
			\BeamS{+0.5}
			\BeamS{+0.35}
		\fi\ifnum#1=32
			\BeamS{+0.6}
			\BeamS{+0.45}
			\BeamS{+0.3}
		\fi
	\else
		\ifswap\Mswap\fi
		\ifnoswap
		\setcounter{Mevaluate}{\theMmax}
		\else
		\setcounter{Mevaluate}{\theMmin}
		\fi\ifswap\Mswap\fi
		\foreach\n in {#2} {
			\ifnum#1=8
			\Enlarge[0.4]{\n}{\theMevaluate}
			\fi\ifnum#1=16
			\Enlarge[0.5]{\n}{\theMevaluate}
			\fi\ifnum#1=32
			\Enlarge[0.6]{\n}{\theMevaluate}
			\fi
			\stepcounter{Mxpos}
		}
		\ifnum#1=8
			\Beam{\theMaux}{\theMevaluate}{\theMevaluate}{+0.4}
		\fi\ifnum#1=16
			\Beam{\theMaux}{\theMevaluate}{\theMevaluate}{+0.5}
			\Beam{\theMaux}{\theMevaluate}{\theMevaluate}{+0.35}
		\fi\ifnum#1=32
			\Beam{\theMaux}{\theMevaluate}{\theMevaluate}{+0.6}
			\Beam{\theMaux}{\theMevaluate}{\theMevaluate}{+0.45}
			\Beam{\theMaux}{\theMevaluate}{\theMevaluate}{+0.3}
		\fi
	\fi
\fi
	\setcounter{Mxpos}{\theMaux}
	\foreach\n in {#2} {
		\Ledger{\n}\stepcounter{Mxpos}}
	\addtocounter{Mxpos}{1}
	\swapfalse
}

