			\clip (\theMxpos*0.5-0.645,-\theMypos*2+\theMmin*0.1-0.5-#1) rectangle (\theMxpos*0.5-0.129,-\theMypos*2+\theMmax*0.1);
			\draw[line width=1mm] (\theMxpos*0.5-0.7,-\theMypos*2+\theMmin*0.1-#1-0.48) -- (\theMxpos*0.5-0.1,-\theMypos*2+\theMmax*0.1-#1-0.48);
		\end{scope}
