\pgfkeys{
	/MClef/.is family
	, /MClef
	, default/.style = 
	{	t = 2
		, octave = 0
	}
	, t/.estore in=\MclefT
	, octave/.estore in=\MclefOct
}
\newcommand{\Clef}[1][]{
	\pgfkeys{/MClef, default, #1}%
	\setcounter{Mclef}{\MclefT}
	\Adv
	
	\Octave{\MclefOct}
	
	\ifnum\theMclef=1
		\node at (\theMX*\MX+0.1,-\theMY*2+0.15)
		{\trebleclef};
	\fi\ifnum\theMclef=2
		\node at (\theMX*\MX+0.1,-\theMY*2+0.35)
		{\trebleclef};
	\fi\ifnum\theMclef=3
		\node at (\theMX*\MX+0.1,-\theMY*2+0.8)
		{{\resizebox{0.7cm}{0.8cm}{\bassclef}}};
	\fi\ifnum\theMclef=4
		\node at (\theMX*\MX+0.1,-\theMY*2+1)
		{{\resizebox{0.7cm}{0.8cm}{\bassclef}}};
	\fi\ifnum\theMclef=11
		\node at (\theMX*\MX+0.1,-\theMY*2+0.4)
		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
	\fi\ifnum\theMclef=12
		\node at (\theMX*\MX+0.1,-\theMY*2+0.6)
		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
	\fi\ifnum\theMclef=13
		\node at (\theMX*\MX+0.1,-\theMY*2+0.8)
		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
	\fi\ifnum\theMclef=14
		\node at (\theMX*\MX+0.1,-\theMY*2+1)
		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
	\fi\ifnum\theMclef=15
		\node at (\theMX*\MX+0.1,-\theMY*2+1.2)
		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
	\fi\ifnum\theMclef=0
		\draw[line width=1.5mm] (\theMX*\MX,-\theMY*2+0.2) -- (\theMX*\MX,-\theMY*2+0.6);
		\draw[line width=1.5mm] (\theMX*\MX+0.3,-\theMY*2+0.2) -- (\theMX*\MX+0.3,-\theMY*2+0.6);
	\fi
	\addtocounter{MX}{\XM}
}

\newlength{\MWidth}
\newlength{\MHeight}
\newcommand{\MResize}[1]{
	\settowidth{\MWidth}{#1}
	\settoheight{\MHeight}{#1}
	\resizebox{1.5\MWidth}{1.5\MHeight}{#1}
}
\newcommand{\TimeSig}[2]{
	\Adv
	\ifx&#2&
		\ifthenelse{\equal{#1}{C}}%
			{\node at (\theMX*\MX-0.25,-\theMY*2+0.5) {\meterC};}%
		{\ifthenelse{\equal{#1}{C|}}%
			{\node at (\theMX*\MX-0.25,-\theMY*2+0.575) {\allabreve};}%
		{\node at (\theMX*\MX-0.25,-\theMY*2+0.4) {\bf \MResize{#1}};}%
		}
	\else
		\node at (\theMX*\MX-0.25,-\theMY*2+0.6) {\bf \MResize{#1}};
		\node at (\theMX*\MX-0.25,-\theMY*2+0.2) {\bf \MResize{#2}};
	\fi
	\addtocounter{MX}{\XM}
}

\newcommand{\Dot}[2][1]{
	\foreach \IND in {1,...,#1}
	{\MPlaceNR[+0.15*\IND]{#2}{\resizebox{0.1cm}{0.1cm}{$\bullet$}};}
}

\newcounter{Maux}
\newcounter{MauxB}
\newcommand{\Tuplet}[2][]{
	\addtocounter{MX}{-1*\XM}
	\setcounter{Mevaluate}{\theMX}
	\addtocounter{Mevaluate}{-\theMaux}
	\setcounter{MauxB}{0}
	\ifnum\theMevaluate=2\else
	\setcounter{MauxB}{21}
	\fi
	\node at (\theMaux*\MX+\theMevaluate*0.25-0.15-\theMauxB*0.01,-\theMY*2+#2*0.1)
	{\ifx&#1&\theMevaluate\else#1\fi};
	\addtocounter{MX}{\XM/2}
}

