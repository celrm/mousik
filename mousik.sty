\newif\ifMswap\Mswapfalse
\newif\ifnoMswap\noMswaptrue

\newcommand{\@Mswap}{
	\ifnoMswap\noMswapfalse
	\else\noMswaptrue
	\fi
}
\newcommand{\@outMswap}{
	\ifMswap\Mswapfalse
	\else\Mswaptrue
	\fi
