\newcommand{\@Staff}{
	\foreach\INDi in {0,...,\theMY} {
		\foreach\INDj in {0,...,4} {
			\ifnum\INDi=\theMY
				\ifnum\INDi=0
					\draw (-0.25+\@Mindent,-\INDi*\MY+\INDj*0.2)
					-- (\theMX*0.0625,-\INDi*\MY+\INDj*0.2);
				\else
					\draw (-0.25,-\INDi*\MY+\INDj*0.2)
					-- (\theMX*0.0625,-\INDi*\MY+\INDj*0.2);
				\fi
			\else\ifnum\INDi=0
				\draw (-0.25+\@Mindent,-\INDi*\MY+\INDj*0.2)
				-- (\Mlong*0.12,-\INDi*\MY+\INDj*0.2);
				\else
				\draw (-0.25,-\INDi*\MY+\INDj*0.2)
				-- (\Mlong*0.12,-\INDi*\MY+\INDj*0.2);
			\fi\fi
		}
	}
}
