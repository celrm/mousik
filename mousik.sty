\newcommand{\Head}[1]{
	\@EqStr{.}{\@Mhead}{\RoundHead{#1}}
	\@EqStr{o}{\@Mhead}{\HollowHead{#1}}
	\@EqStr{x}{\@Mhead}{\CrossHead{#1}}}

\newcommand{\RoundHead}[1]{
	\ifMnoteBack
		\node [opacity=0.0] (tmp) at (\theMX*0.0625-0.265,-\theMY*\MY-0.2+#1*0.1) {};
		\fill[rotate around={16:(tmp.center)}] (\theMX*0.0625-0.01-0.265,-\theMY*\MY-0.195+#1*0.1) ellipse (4pt and 2.75pt);
	\else 
		\node [opacity=0.0] (tmp) at (\theMX*0.0625,-\theMY*\MY-0.2+#1*0.1) {};
		\fill[rotate around={16:(tmp.center)}] (\theMX*0.0625-0.01,-\theMY*\MY-0.195+#1*0.1) ellipse (4pt and 2.75pt);
	\fi
}

\newcommand{\CrossHead}[1]{
	\ifMnoteBack
		\draw (\theMX*0.0625 -0.125-0.265,-\theMY*\MY+#1*0.1 -0.1) --
		(\theMX*0.0625 +0.1-0.265,-\theMY*\MY+#1*0.1 -0.3);
		\draw (\theMX*0.0625 +0.1-0.265,-\theMY*\MY+#1*0.1 -0.1) --
		(\theMX*0.0625 -0.125-0.265,-\theMY*\MY+#1*0.1 -0.3);
	\else 
		\draw (\theMX*0.0625 -0.125,-\theMY*\MY+#1*0.1 -0.1) --
		(\theMX*0.0625 +0.1,-\theMY*\MY+#1*0.1 -0.3);
		\draw (\theMX*0.0625 +0.1,-\theMY*\MY+#1*0.1 -0.1) --
		(\theMX*0.0625 -0.125,-\theMY*\MY+#1*0.1 -0.3);
	\fi
}

\newcommand{\HollowHead}[1]{
	\ifMnoteBack
		\node [opacity=0.0] (tmp) at (\theMX*0.0625-0.265,-\theMY*\MY-0.2+#1*0.1) {};
		\fill[black,rotate around={16:(tmp.center)}] (\theMX*0.0625-0.01-0.265,-\theMY*\MY-0.195+#1*0.1) ellipse (4pt and 2.75pt);
		\fill[\@Mcolor,rotate around={19:(tmp.center)}] (\theMX*0.0625-0.01-0.265,-\theMY*\MY-0.195+#1*0.1) ellipse (3.2pt and 1.35pt);
	\else 
		\node [opacity=0.0] (tmp) at (\theMX*0.0625,-\theMY*\MY-0.2+#1*0.1) {};
		\fill[black,rotate around={16:(tmp.center)}] (\theMX*0.0625-0.01,-\theMY*\MY-0.195+#1*0.1) ellipse (4pt and 2.75pt);
		\fill[\@Mcolor,rotate around={19:(tmp.center)}] (\theMX*0.0625-0.01,-\theMY*\MY-0.195+#1*0.1) ellipse (3.2pt and 1.35pt);
	\fi
}

\newcommand{\@Menlarge}[3][\@Mstem]{
	\ifMswap\@Mswap\fi
	\ifnoMswap
		\draw[line width=0.25mm]  (\theMX*0.0625+0.115,-\theMY*\MY+#2*0.1-0.2) --
			(\theMX*0.0625+0.115,-\theMY*\MY+#3*0.1+#1-0.2);
		
	\else
		\draw[line width=0.25mm]  (\theMX*0.0625-0.14,-\theMY*\MY+#2*0.1-0.2) --
			(\theMX*0.0625-0.14,-\theMY*\MY+#3*0.1-0.4-#1+0.2);
		
	\fi
	\ifMswap\@Mswap\fi
}

\newcommand{\Ledger}[1]{
	\ifnum1>#1
	\foreach\INDi in {0,...,#1} {
		\ifthenelse{\isodd{\INDi}}{}%
		{\draw (\theMX*0.0625-0.25,-\theMY*\MY-0.2+\INDi*0.1) --
		(\theMX*0.0625+0.25,-\theMY*\MY-0.2+\INDi*0.1);}
	}
	\fi\ifnum11<#1
	\foreach\INDi in {12,...,#1} {
		\ifthenelse{\isodd{\INDi}}{}%
		{\draw (\theMX*0.0625-0.25,-\theMY*\MY-0.2+\INDi*0.1) --
		(\theMX*0.0625+0.25,-\theMY*\MY-0.2+\INDi*0.1);}
	}
	\fi
}
