\pgfkeys{
	/Mtext/.is family
	, /Mtext
	, default/.style = 
	{	xshift = 0
		, yshift = 0
	}
	, xshift/.estore in=\MshiftX
	, yshift/.estore in=\MshiftY
}
\newcommand{\Text}[2][]{
	\pgfkeys{/Mtext, default, #1}%
	\begin{scope}[xshift=\MshiftX cm,yshift=\MshiftY cm]
	\node at (\theMX*\MX,-\theMY*2-0.7) {#2};
	\end{scope}
}

\newcommand{\muskern}{\kern-.15ex }
\makeatletter
\newcommand\dynmark[1]{{\normalfont\bfseries\itshape
		\@tfor\next:=#1\do{\put@muskern\next}\/}}
\newcommand{\put@muskern}{\let\put@muskern\muskern}
\makeatother
\newcommand{\Dynamics}[2][0]{\Text[#1]{\dynmark{#2}}}

\newcommand{\Back}[1][1]{
	\addtocounter{MX}{-\XM/2}
	\addtocounter{MX}{-#1*\XM/2}}

\newcommand{\Space}[1][1]{
	\Adv
	\pgfmathsetmacro\SPac{int((#1) * \XM)}
	\addtocounter{MX}{\SPac}}

\pgfkeys{
	/MBar/.is family
	, /MBar
	, default/.style = 
	{	t = |
		, xshift = 0
		, yshift = 0
	}
	, t/.estore in=\MBarT
	, xshift/.estore in=\MshiftX
	, yshift/.estore in=\MshiftY
}
\newcommand{\Bar}[1][]{
	\pgfmathsetmacro\COmp{int(\theMX*\MX*100-\Mlong*12)}
	\ifnum\COmp>0
		\addtocounter{MX}{-\XM/2}
	\fi
	\pgfkeys{/MBar, default, #1}%
	\begin{scope}[xshift=\MshiftX cm,yshift=\MshiftY cm]
	\MString{\MBarT}{|}
		{\draw (\theMX*\MX,-\theMY*2+0.8) -- (\theMX*\MX,-\theMY*2);}
	\MString{\MBarT}{:}
		{\draw[dashed] (\theMX*\MX,-\theMY*2+0.8) -- (\theMX*\MX,-\theMY*2);}
	\MString{\MBarT}{||}
		{\draw (\theMX*\MX-0.06,-\theMY*2+0.8) -- (\theMX*\MX-0.06,-\theMY*2);
		\draw (\theMX*\MX+0.06,-\theMY*2+0.8) -- (\theMX*\MX+0.06,-\theMY*2);}
	\MString{\MBarT}{|.}
		{\draw (\theMX*\MX-0.12,-\theMY*2+0.8) -- (\theMX*\MX-0.12,-\theMY*2);
		\draw[line width=1mm] (\theMX*\MX,-\theMY*2+0.807) -- (\theMX*\MX,-\theMY*2-0.007);}
	\MString{\MBarT}{:|}
		{\node at (\theMX*\MX-0.24,0.4-\theMY*2) {\resizebox{0.175cm}{0.25cm}{:}};
		\draw (\theMX*\MX-0.12,-\theMY*2+0.8) -- (\theMX*\MX-0.12,-\theMY*2);
		\draw[line width=1mm] (\theMX*\MX,-\theMY*2+0.807) -- (\theMX*\MX,-\theMY*2-0.007);}
	\MString{\MBarT}{|:}
		{\draw[line width=1mm] (\theMX*\MX,-\theMY*2+0.807) -- (\theMX*\MX,-\theMY*2-0.007);
		\node at (\theMX*\MX+0.24,0.4-\theMY*2) {\resizebox{0.175cm}{0.25cm}{:}};
		\draw (\theMX*\MX+0.12,-\theMY*2+0.8) -- (\theMX*\MX+0.12,-\theMY*2);}
	\MString{\MBarT}{:|:}
		{\node at (\theMX*\MX-0.24,0.4-\theMY*2) {\resizebox{0.175cm}{0.25cm}{:}};
		\draw (\theMX*\MX-0.12,-\theMY*2+0.8) -- (\theMX*\MX-0.12,-\theMY*2);
		\draw[line width=1mm] (\theMX*\MX,-\theMY*2+0.807) -- (\theMX*\MX,-\theMY*2-0.007);
		\node at (\theMX*\MX+0.24,0.4-\theMY*2) {\resizebox{0.175cm}{0.25cm}{:}};
		\draw (\theMX*\MX+0.12,-\theMY*2+0.8) -- (\theMX*\MX+0.12,-\theMY*2);}
	\addtocounter{MX}{\XM}
	\end{scope}
}

\newcommand{\Adv}{
	\addtocounter{MX}{\XM/2}
	\pgfmathsetmacro\COmp{int(\theMX*\MX*100-\Mlong*12)}
	\ifnum\COmp>0
		\addtocounter{MY}{1}
		\setcounter{MX}{0}
		\ifnum\theMclef=0\else
		\Clef{\theMclef}
		\fi
		\Key{\theMkey}
	\else
	\addtocounter{MX}{-\XM/2}
	\fi
}

\newcommand{\Tempo}[3][]{
	\ifnum#2=1
	\Text[yshift=2.5,#1]{\tikz[baseline]{\Note{#2}{3}}\Large\textbf{ = #3}}
	\else
	\Text[yshift=2.5,#1]{\tikz{\Note{#2}{1}}\Large\textbf{ = #3}}
	\fi
	\Space[-1]
}

\newcommand{\Tie}[2][1]{
	\Slur[#1*0.5]{#2}{#2}
}
\newcommand{\Slur}[3][1]{
	\ifnum#2<6
	\noswaptrue\else\noswapfalse\fi
	\ifswap\Mswap\fi
	\ifnoswap
		\draw (-1+\theMX*\MX,-\theMY*2+0.1*#2-0.35) to[out=-20,in=-160] (-0.5+#1+\theMX*\MX,-\theMY*2+0.1*#3-0.35);
	\else
		\draw (-1+\theMX*\MX,-\theMY*2+0.1*#2-0.05) to[out=20,in=160] (-0.5+#1+\theMX*\MX,-\theMY*2+0.1*#3-0.05);
	\fi
	\swapfalse
}

\newcounter{Mslurred}
\newcounter{MslurredA}
\newcounter{MslurredB}
\newenvironment{Slurred}[2]
{\setcounter{Mslurred}{\theMX}
\addtocounter{Mslurred}{\XM}
\setcounter{MslurredA}{#1}
\setcounter{MslurredB}{#2}}
{\setcounter{Maux}{\theMX}
\setcounter{MX}{\theMslurred}
\setcounter{Mslurred}{\theMaux}\addtocounter{Mslurred}{-\theMX}
\ifnum\theMslurredA<6\Swap\fi
\Slur[\theMslurred*\MX-0.5]{\theMslurredA}{\theMslurredB}
\setcounter{MX}{\theMaux}
}

\newcounter{Mcres}
\newcounter{McresP}
\newenvironment{Crescendo}[1][0]
{\setcounter{Mcres}{\theMX}\setcounter{McresP}{#1}}
{\draw (0.1+\theMcres*\MX,-\theMY*2+\theMcresP*0.1-0.5) 
-- (-1.1+\theMX*\MX,-\theMY*2+0.1*\theMcresP+0.2-0.5);
\draw (0.1+\theMcres*\MX,-\theMY*2+0.1*\theMcresP-0.5) 
-- (-1.1+\theMX*\MX,-\theMY*2+0.1*\theMcresP-0.2-0.5);}


\newenvironment{Decrescendo}[1][0]
{\setcounter{Mcres}{\theMX}\setcounter{McresP}{#1}}
{\draw (0.1+\theMcres*\MX,-\theMY*2+\theMcresP*0.1+0.2-0.5) 
-- (-1.1+\theMX*\MX,-\theMY*2+0.1*\theMcresP-0.5);
\draw (0.1+\theMcres*\MX,-\theMY*2+0.1*\theMcresP-0.2-0.5) 
-- (-1.1+\theMX*\MX,-\theMY*2+0.1*\theMcresP-0.5);}

