\newcommand{\Head}[1]{
	\MStringz{.}{\Mhead}{\RoundHead{#1}}
	\MStringz{o}{\Mhead}{\HollowHead{#1}}
	\MStringz{x}{\Mhead}{\CrossHead{#1}}}

\newcommand{\RoundHead}[1]{
	\node [opacity=0.0] (tmp) at (\theMX*\MX,-\theMY*2-0.2+#1*0.1) {};
	\fill[rotate around={16:(tmp.center)}] (\theMX*\MX-0.01,-\theMY*2-0.195+#1*0.1) ellipse (4pt and 2.75pt);}

\newcommand{\CrossHead}[1]{
	\draw (\theMX*\MX -0.125,-\theMY*2+#1*0.1 -0.1) --
	(\theMX*\MX +0.1,-\theMY*2+#1*0.1 -0.3);
	\draw (\theMX*\MX +0.1,-\theMY*2+#1*0.1 -0.1) --
	(\theMX*\MX -0.125,-\theMY*2+#1*0.1 -0.3);
}

\newcommand{\HollowHead}[1]{
	\node [opacity=0.0] (tmp) at (\theMX*\MX,-\theMY*2-0.2+#1*0.1) {};
	\fill[black,rotate around={16:(tmp.center)}] (\theMX*\MX-0.01,-\theMY*2-0.195+#1*0.1) ellipse (4pt and 2.75pt);
	\fill[white,rotate around={19:(tmp.center)}] (\theMX*\MX-0.01,-\theMY*2-0.195+#1*0.1) ellipse (3.2pt and 1.35pt);
}

\newcommand{\Menlarge}[3][\Mstem]{
	\ifswap\Mswap\fi
	\ifnoswap
		\draw[line width=0.25mm]  (\theMX*\MX+0.115,-\theMY*2+#2*0.1-0.2) --
			(\theMX*\MX+0.115,-\theMY*2+#3*0.1+#1);
	\else
		\draw[line width=0.25mm]  (\theMX*\MX-0.14,-\theMY*2+#2*0.1-0.2) --
			(\theMX*\MX-0.14,-\theMY*2+#3*0.1-0.5-#1);
	\fi
	\ifswap\Mswap\fi
}
\newcommand{\Enlarge}[2]{
\Menlarge{#1}{#2}
\swapfalse
}

\newcommand{\Ledger}[1]{
	\ifnum1>#1
	\foreach\INDi in {0,...,#1} {
		\ifthenelse{\isodd{\INDi}}{}%
		{\draw (\theMX*\MX-0.25,-\theMY*2-0.2+\INDi*0.1) --
		(\theMX*\MX+0.25,-\theMY*2-0.2+\INDi*0.1);}
	}
	\fi\ifnum11<#1
	\foreach\INDi in {12,...,#1} {
		\ifthenelse{\isodd{\INDi}}{}%
		{\draw (\theMX*\MX-0.25,-\theMY*2-0.2+\INDi*0.1) --
		(\theMX*\MX+0.25,-\theMY*2-0.2+\INDi*0.1);}
	}
	\fi
}

\newcommand{\Beam}[5][\theMX]{
	\ifswap\Mswap\fi
	\ifnoswap
		\draw[line width=\Mbeam mm] (#2*\MX+0.103,-\theMY*2+#3*0.1#5) -- (#1*\MX-0.372,-\theMY*2+#4*0.1#5);
	\else
		\draw[line width=\Mbeam mm] (#2*\MX-0.153,-\theMY*2+#3*0.1-0.5-#5) -- (#1*\MX-0.625,-\theMY*2+#4*0.1-0.5-#5);
	\fi	
	\ifswap\Mswap\fi
}

\newcommand{\BeamS}[1]{
	\ifswap\Mswap\fi
	\ifnoswap
		\ifnum\theMfirst=\theMmin
		\begin{scope}
			\clip (\theMX*\MX-0.4,-\theMY*2+\theMmin*0.1-0.3) rectangle (\theMX*\MX+0.125,-\theMY*2+0.05+\theMmax*0.1#1);
			\draw[line width=\Mbeam mm] (\theMX*\MX-0.411,-\theMY*2+\theMmin*0.1#1) -- (\theMX*\MX+0.147,-\theMY*2+\theMmax*0.1#1);
		\end{scope}
		\else
		\begin{scope}
			\clip (\theMX*\MX-0.4,-\theMY*2+0.05+\theMmax*0.1#1) rectangle (\theMX*\MX+0.125,-\theMY*2+0.05+\theMmin*0.1-0.3);
			\draw[line width=\Mbeam mm] (\theMX*\MX-0.411,-\theMY*2+\theMmax*0.1#1) -- (\theMX*\MX+0.147,-\theMY*2+\theMmin*0.1#1);
		\end{scope}
		\fi
	\else
		\ifnum\theMfirst=\theMmin
		\begin{scope}
			\clip (\theMX*\MX-0.645,-\theMY*2+\theMmin*0.1-0.55-#1) rectangle (\theMX*\MX-0.129,-\theMY*2+\theMmax*0.1);
			\draw[line width=\Mbeam mm] (\theMX*\MX-0.7,-\theMY*2+\theMmin*0.1-#1-0.48) -- (\theMX*\MX-0.1,-\theMY*2+\theMmax*0.1-#1-0.48);
		\end{scope}
		\else
		\begin{scope}
			\clip (\theMX*\MX-0.65,-\theMY*2+\theMmin*0.1-0.55-#1) rectangle (\theMX*\MX-0.129,-\theMY*2+\theMmax*0.1);
			\draw[line width=\Mbeam mm] (\theMX*\MX-0.7,-\theMY*2+\theMmax*0.1-#1-0.48) -- (\theMX*\MX-0.1,-\theMY*2+\theMmin*0.1-#1-0.48);
		\end{scope}
		\fi
	\fi
	\ifswap\Mswap\fi
}

\newcommand{\Flag}[2][0]{
	\ifswap\Mswap\fi
	\ifnoswap
	\begin{scope}
		\clip (\theMX*\MX+0.13,-\theMY*2+#2*0.1-0.75+#1) rectangle (\theMX*\MX+0.35,-\theMY*2+#2*0.1+0.05+#1);
		\node at (\theMX*\MX+0.05,-\theMY*2-0.3+#2*0.1+#1) {\resizebox{0.55cm}{0.65cm}{\Acht}};
	\end{scope}
	\fill[white] (\theMX*\MX+0.205,-\theMY*2-0.308+#2*0.1+#1) circle (1.75pt);
	\else
	\begin{scope}
		\node [opacity=0.0] (tmp) at (\theMX*\MX,-\theMY*2+#2*0.1) {};
		\clip (\theMX*\MX-0.125,-\theMY*2+#2*0.1-0.55-#1) rectangle (\theMX*\MX+0.09,-\theMY*2+#2*0.1+0.15-#1);
		\node[rotate around={180:(tmp.center)}] at (\theMX*\MX+0.175,-\theMY*2+0.165+#2*0.1+#1) {\reflectbox{\resizebox{0.55cm}{0.65cm}{\Acht}}};
	\end{scope}
	\fill[white] (\theMX*\MX-0.035,-\theMY*2-0.161+#2*0.1-#1) circle (2pt);
	\fi
	\ifswap\Mswap\fi
}

\newcommand{\Semibreve}[1]{
	\node at (\theMX*\MX,-\theMY*2-0.2+#1*0.1) {\resizebox{0.3cm}{0.2cm}{\Ganz}};
}
\newcommand{\Minim}[1]{
	\HollowHead{#1}
	\ifnum#1<6\else
		\Mswap
	\fi
	\Menlarge[\Mstem]{#1}{#1}
}
\newcommand{\Crotchet}[1]{
	\Head{#1}
	\ifnum#1<6\else
		\Mswap
	\fi
	\Menlarge[\Mstem]{#1}{#1}
}

\newcommand{\Quaver}[1]{
	\Head{#1}
	\ifnum#1<6\else
		\Mswap
	\fi
	\pgfmathsetmacro\Sstem{\Mstem+0.1}
	\Menlarge[\Sstem]{#1}{#1}
	\Flag[\Sstem]{#1}
}
\newcommand{\Semiquaver}[1]{
	\Head{#1}
	\ifnum#1<6\else
		\Mswap
	\fi	
	\pgfmathsetmacro\Sstem{\Mstem+0.2}
	\Menlarge[\Sstem]{#1}{#1}
	\Flag[\Sstem]{#1}
	\pgfmathsetmacro\Sstem{\Mstem+0.05}
	\Flag[\Sstem]{#1}
}
\newcommand{\Demisemiquaver}[1]{
	\Head{#1}
	\ifnum#1<6\else
		\Mswap
	\fi	
	\pgfmathsetmacro\Sstem{\Mstem+0.3}
	\Menlarge[\Sstem]{#1}{#1}
	\Flag[\Sstem]{#1}
	\pgfmathsetmacro\Sstem{\Mstem+0.15}
	\Flag[\Sstem]{#1}
	\Flag[\Mstem]{#1}
}

\newcommand{\MHeads}[1]{
	\setcounter{Mfirst}{-50}
	\setcounter{Mmax}{-50}
	\setcounter{Mmin}{50}
	\foreach\IND in {#1} {
		\MNEmpty{\IND}{
			\Head{\IND} 
			\MMax{\IND}\MMin{\IND} % max, min, first
			\ifnum\theMfirst=-50\setcounter{Mfirst}{\IND}\fi
		}
		\addtocounter{MX}{\XM/2}
	}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Notes : everything together

\pgfkeys{
	/Mnote/.is family
	, /Mnote
	, default/.style = 
	{	beam = 1
		, stem = 0.3
		, head = .
		, swap = false
	}
	, beam/.estore in=\Mbeam
	, stem/.estore in=\Mstem
	, head/.estore in=\Mhead
	, swap/.is if=swap
}
\newcounter{Mduration}
\newcommand{\Note}[3][]{
	\pgfkeys{/Mnote, default, #1}%
	\Adv\noswaptrue
	\setcounter{Maux}{\theMX}
	
	\MCount{#2}\setcounter{Mduration}{\theMcount}
\ifnum\theMduration=1
	
	\ifnum#2=1
		\foreach\IND in {#3} {\Semibreve{\IND}\addtocounter{MX}{\XM/2}}
	\else\ifnum#2=2
		\foreach\IND in {#3} {\Minim{\IND}\addtocounter{MX}{\XM/2}}
	\else\ifnum#2=4
		\foreach\IND in {#3} {\Crotchet{\IND}\addtocounter{MX}{\XM/2}}
	\else
		\MCount{#3}
		\ifnum\theMcount=1
			\ifnum#2=8 \Quaver{#3} \else
			\ifnum#2=16 \Semiquaver{#3} \else
			\ifnum#2=32 \Demisemiquaver{#3} \fi\fi\fi
		\else\ifnum\theMcount=2
			\MTwoNote{#2}{#3}
		\else\ifnum\theMcount>2
			\MFlatNote{#2}{#3}
		\fi\fi\fi
	\fi\fi\fi
	
\else\MCount{#3}\ifnum\theMduration=\theMcount
	\MMixedNote{#2}{#3}
\fi\fi

	\setcounter{MX}{\theMaux}
	\foreach \IND in {#3} {
		\MNEmpty{\IND}{\Ledger{\IND}}
		\addtocounter{MX}{\XM/2}
	}
	\addtocounter{MX}{\XM/2}
	\swapfalse
}

\newcounter{MMdur}
\newcommand{\MMixedNote}[2]{
	\setcounter{Mduration}{8}
	\foreach\INDd in {#1} {
		\ifnum\theMduration<16
			\MStringz{\INDd}{=}{\setcounter{Mduration}{16}}
			\MStringz{\INDd}{=|}{\setcounter{Mduration}{16}}
			\MStringz{\INDd}{|=}{\setcounter{Mduration}{16}}
			\MStringz{\INDd}{//}{\setcounter{Mduration}{16}}
			\MStringz{\INDd}{//|}{\setcounter{Mduration}{16}}
			\MStringz{\INDd}{|//}{\setcounter{Mduration}{16}}
		\fi\ifnum\theMduration<32
			\MStringz{\INDd}{≡}{\setcounter{Mduration}{32}}
			\MStringz{\INDd}{≡|}{\setcounter{Mduration}{32}}
			\MStringz{\INDd}{|≡}{\setcounter{Mduration}{32}}
			\MStringz{\INDd}{///}{\setcounter{Mduration}{32}}
			\MStringz{\INDd}{///|}{\setcounter{Mduration}{32}}
			\MStringz{\INDd}{|///}{\setcounter{Mduration}{32}}
		\fi
	}
	
	\MHeads{#2}
	\ifnum\theMmax<6
		\ifswap\setcounter{Mevaluate}{\theMmin}
		\else\setcounter{Mevaluate}{\theMmax}\fi
	\else\Mswap
		\ifswap\setcounter{Mevaluate}{\theMmax}
		\else\setcounter{Mevaluate}{\theMmin}\fi
	\fi
	
	\setcounter{MX}{\theMaux}
	\foreach\IND in {#2} {
		\MNEmpty{\IND}{
			\ifnum\theMduration<16
			\pgfmathsetmacro\Sstem{\Mstem+0.1}
			\fi\ifnum\theMduration=16
			\pgfmathsetmacro\Sstem{\Mstem+0.2}
			\fi\ifnum\theMduration=32
			\pgfmathsetmacro\Sstem{\Mstem+0.3}
			\fi
			\Menlarge[\Sstem]{\IND}{\theMevaluate}
		}
		\addtocounter{MX}{\XM/2}
	}
	
	\ifnum\theMduration<16
		\pgfmathsetmacro\Sstem{\Mstem+0.1}
		\Beam{\theMaux}{\theMevaluate}{\theMevaluate}{+\Sstem}
	\fi\ifnum\theMduration=16
		\pgfmathsetmacro\Sstem{\Mstem+0.2}
		\Beam{\theMaux}{\theMevaluate}{\theMevaluate}{+\Sstem}
	
		\setcounter{MX}{\theMaux}
		\setcounter{Mfirst}{-50}
		\pgfmathsetmacro\Sstem{\Mstem+0.05}
		\foreach\INDd in {#1} {
			\addtocounter{MX}{\XM/2}
