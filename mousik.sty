\newcommand{\Init}[1][]{%
\pgfkeys{/mousik, default, #1}%
\setcounter{MX}{0}%
\setcounter{MY}{0}%
\setcounter{Mclef}{-1}%
\setcounter{Mkey}{0}}

\newenvironment{mousik}[1][]{%
\Init[#1]%
\noindent\begin{tikzpicture}[
background rectangle/.style={fill=\@Mcolor},
show background rectangle,\@MTIKz]
\Space[\@Mindent]
}{%
\pgfmathsetmacro{\@Finsep}{int(\Mhsep*2)}
