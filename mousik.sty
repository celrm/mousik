\RequirePackage[minimal]{leadsheets}
\useleadsheetslibraries{musicsymbols}

\RequirePackage{musixtex}

\RequirePackage{harmony}
\RequirePackage{tikz}

\RequirePackage{xstring}
\RequirePackage{xparse}
\ExplSyntaxOn
\DeclareExpandableDocumentCommand{\Eval}{m}{\int_eval:n {#1}}
\ExplSyntaxOff

\newcounter{modulo}
\newcommand{\Modulo}[2]{%
	\setcounter{modulo}{#1}%
	\loop%
	\ifnum\themodulo>\Eval{#2-1}%		
	\setcounter{modulo}{\Eval{\themodulo-#2}}%
	\repeat%
	\ifnum\themodulo<0%
	\setcounter{modulo}{\Eval{\themodulo+#2}}%
	\repeat%
%	\themodulo%
}

\newcounter{max}
\newcommand{\Max}[2][\themax]{%
	\setcounter{max}{#1}%
	\ifnum#2>#1
	\setcounter{max}{#2}%
	\fi
}

\newcounter{min}
\newcommand{\Min}[2][\themin]{%
	\setcounter{min}{#1}%
	\ifnum#2<#1
	\setcounter{min}{#2}%
	\fi
}
\newcounter{first}

\newcounter{xpos}
\newcounter{ypos}
\newcounter{clef}
\newcounter{key}

\newcommand{\Staff}{
	\foreach\i in {0,...,\theypos} {
		\foreach\j in {0,...,4} {
			\ifnum\i=\theypos
				\draw (-0.25,-\i*2+\j*0.2) -- (\thexpos*0.5,-\i*2+\j*0.2);
			\else
				\draw (-0.25,-\i*2+\j*0.2) -- (11,-\i*2+\j*0.2);
			\fi
		}
	}
}

\newcommand{\Clef}[1]{
	\setcounter{clef}{#1}
	\Adv
	%
	\ifnum#1=1
		\node at (\thexpos*0.5+0.1,-\theypos*2+0.15) 
		{\trebleclef};
	\fi\ifnum#1=2
		\node at (\thexpos*0.5+0.1,-\theypos*2+0.35) 
		{\trebleclef};
	\fi\ifnum#1=3
		\node at (\thexpos*0.5+0.1,-\theypos*2+0.8)
		{{\resizebox{0.7cm}{0.8cm}{\bassclef}}};
	\fi\ifnum#1=4
		\node at (\thexpos*0.5+0.1,-\theypos*2+1)
		{{\resizebox{0.7cm}{0.8cm}{\bassclef}}};
	\fi\ifnum#1=11
		\node at (\thexpos*0.5+0.1,-\theypos*2+0.4) 
		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
	\fi\ifnum#1=12
		\node at (\thexpos*0.5+0.1,-\theypos*2+0.6) 
		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
	\fi\ifnum#1=13
		\node at (\thexpos*0.5+0.1,-\theypos*2+0.8) 
		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
	\fi\ifnum#1=14
		\node at (\thexpos*0.5+0.1,-\theypos*2+1) 
		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
	\fi\ifnum#1=15
		\node at (\thexpos*0.5+0.1,-\theypos*2+1.2) 
		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
	\fi
	\addtocounter{xpos}{2}
}

\input{mousik-key.sty}

\newlength{\TSLen}
\newlength{\TSHei}
\newcommand{\AboveDec}[1]{%
	\settowidth{\TSLen}{#1}
	\settoheight{\TSHei}{#1}
	\resizebox{1.5\TSLen}{1.5\TSHei}{#1}
}
\newcommand{\TimeS}[3][0]{
	\Adv
	\ifnum#1=0
		\node at (\thexpos*0.5,-\theypos*2+0.6) {\bf \AboveDec{#2}};
		\node at (\thexpos*0.5,-\theypos*2+0.2) {\bf \AboveDec{#3}};
	\fi\ifnum#1=1
		\node at (\thexpos*0.5,-\theypos*2+0.5) {\meterC};
	\fi\ifnum#1=2
		\node at (\thexpos*0.5,-\theypos*2+0.575) {\allabreve};
	\fi
	\addtocounter{xpos}{3}
}

\newcommand{\Dot}[2][1]{%
	\foreach \d in {1,...,#1}
	{\node at (\thexpos*0.5+0.1+0.15*\d,-\theypos*2-0.21+0.1*#2)
	{{\resizebox{0.1cm}{0.1cm}{$\bullet$}}};}
}

\input{mousik-note.sty}

\newcommand{\Text}[2][0]{
\node at (\thexpos*0.5,-\theypos*2-0.7+#1) {#2};
}

\newcommand{\Chord}[1][1]{\addtocounter{xpos}{\Eval{-1-#1}}}
\newcommand{\Space}[1][2]{\Adv\addtocounter{xpos}{#1}}

\newcommand{\Bar}{%
	\ifnum\thexpos=23
	\addtocounter{xpos}{-1}
	\fi
	\draw (\thexpos*0.5,-\theypos*2+0.8) -- (\thexpos*0.5,-\theypos*2);
	\addtocounter{xpos}{2}}

\newcommand{\FinalBar}{%
	\ifnum\thexpos=23
		\addtocounter{xpos}{-1}
	\fi
	\draw[line width=1mm] (\thexpos*0.5,-\theypos*2+0.805) -- (\thexpos*0.5,-\theypos*2-0.005);
	\draw (\thexpos*0.5-0.12,-\theypos*2+0.8) -- (\thexpos*0.5-0.12,-\theypos*2);
	\addtocounter{xpos}{2}
}

\newcommand{\RepeatBar}{%
	\ifnum\thexpos=23
		\addtocounter{xpos}{-1}
	\fi
	\node at (\thexpos*0.5-0.25,0.4-\theypos*2) {\resizebox{0.175cm}{0.25cm}{:}};
	\draw[line width=1mm] (\thexpos*0.5,-\theypos*2+0.805) -- (\thexpos*0.5,-\theypos*2-0.005);
	\draw (\thexpos*0.5-0.12,-\theypos*2+0.8) -- (\thexpos*0.5-0.12,-\theypos*2);
	\addtocounter{xpos}{2}
}

\newcommand{\Adv}{%
	\ifnum\thexpos>20
		\addtocounter{ypos}{1}
		\setcounter{xpos}{0}
		\ifnum\theclef=0\else
		\Clef{\theclef}
		\fi
		\ifnum\thekey=0\else
		\Key{\thekey}
		\fi
	\fi
}

\newenvironment{mousik}
{\noindent\begin{tikzpicture}}
{\addtocounter{xpos}{-2}\Staff%
\setcounter{xpos}{0}
\setcounter{ypos}{0}
\setcounter{clef}{0}
\setcounter{key}{0}
\end{tikzpicture}}