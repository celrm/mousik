\newcounter{modulo}
\newcommand{\Modulo}[2]{%
	\setcounter{modulo}{#1}%
	\loop%
	\ifnum\themodulo>\Eval{#2-1}%		
	\setcounter{modulo}{\Eval{\themodulo-#2}}%
	\repeat%
	\ifnum\themodulo<0%
	\setcounter{modulo}{\Eval{\themodulo+#2}}%
	\repeat%
%	\themodulo%
}

