\newcommand{\Accs}[2][]{
	\pgfkeys{/MAccs, default, #1}%
	\begin{scope}[xshift=\MshiftX cm,yshift=\MshiftY cm]
	\Adv
	\setcounter{Maux}{\theMX}
	\foreach\INDi/\INDj in {#2} {
		\ifthenelse{\equal{\INDi}{!}}{\addtocounter{MX}{\XM/4}}{
		\MNEmpty{\INDi}{
			\MAcc{\INDi}{\INDj}
		}
		\addtocounter{MX}{\XM/2}
	}}
	\setcounter{MX}{\theMaux}
	\end{scope}
}

\newcommand{\KB}[2]{
	\setcounter{Maux}{#1}
	\ifnum#2<0\setcounter{Mmax}{3}\else\setcounter{Mmax}{5}\fi
	\addtocounter{Maux}{-\theMmax}
	\pgfmathsetmacro\res{int(2.74545*\theMclef-5.01818))}
	\addtocounter{Maux}{\res}
	\MModulo{\theMaux}{7}
	\setcounter{Maux}{\theMmodulo}
	\addtocounter{Maux}{\theMmax}
}

\newcommand{\Key}[1]{
	\setcounter{Mkey}{#1}
	\ifnum#1>0
	
	\pgfmathsetmacro\result{int(10*(#1-1)^(1/2)+20)}
	\setcounter{Mmin}{\result}
	
	\pgfmathsetmacro\result{int(#1*2-23)}
	
	\foreach\IND [count=\INDi] in {10,7,11,8,5,9,6} {
		\ifnum\INDi>#1\else
			
		\KB{\IND}{#1}
		\MAcc[-0.01*\theMmin]{1}{\theMaux}
		
		\addtocounter{Mmin}{\result}
		\fi
	}
	\else\ifnum#1<0
	
	\pgfmathsetmacro\result{int(10*(-#1-1)^(1/2)+20)}
	\setcounter{Mmin}{\result}
	
	\pgfmathsetmacro\result{int(-#1*2-23)}
	
	\foreach\IND [count=\INDi] in {6,9,5,8,4,7,3} {
		\ifnum\INDi>-#1\else
		
		\KB{\IND}{#1}
		\MAcc[-0.01*\theMmin]{-1}{\theMaux}
		
		\addtocounter{Mmin}{\result}
		\fi
	}
	\fi\fi
	\ifnum#1=0\else\addtocounter{MX}{\XM/2}\fi
}
\newcommand{\NoKey}[1]{
	\ifnum#1>0
	
	\pgfmathsetmacro\result{int(10*(#1-1)^(1/2)+20)}
	\setcounter{Mmin}{\result}
	
	\pgfmathsetmacro\result{int(#1*2-23)}
	
	\foreach\IND [count=\INDi] in {10,7,11,8,5,9,6} {
		\ifnum\INDi>#1\else
		
		\KB{\IND}{1}
		\MAcc[-0.01*\theMmin]{0}{\theMaux}
		
		\addtocounter{Mmin}{\result}
		\fi
	}
	\else\ifnum#1<0
	
	\pgfmathsetmacro\result{int(10*(-#1-1)^(1/2)+20)}
	\setcounter{Mmin}{\result}
	
	\pgfmathsetmacro\result{int(-#1*2-23)}
	
	\foreach\IND [count=\INDi] in {6,9,5,8,4,7,3} {
		\ifnum\INDi>-#1\else
		
		\KB{\IND}{-1}
		\MAcc[-0.01*\theMmin]{0}{\theMaux}
		
		\addtocounter{Mmin}{\result}
		\fi
	}
	\fi\fi
	\ifnum#1=0\else\addtocounter{MX}{\XM/2}\fi
}


