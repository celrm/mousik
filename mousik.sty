\DeclareFontFamily{U}{musix}{}%
\DeclareFontShape{U}{musix}{m}{n}{%
  <-12>   s * [1.5] musix11
  <12-15> s * [1.5] musix13
  <15-18> s * [1.5] musix16
  <18-23> s * [1.5] musix20
  <23->   s * [1.5] musix29
}{}%
\DeclareRobustCommand*\M@musix{\usefont{U}{musix}{m}{n}\selectfont}%
\DeclareTextFontCommand{\M@textmusix}{\M@musix}%
\DeclareRobustCommand*\M@musicsymbol[2][0pt]{%
  \raisebox{\dimexpr.45ex+(#1)\relax}{\M@textmusix{#2}}%
}
\DeclareRobustCommand*\M@sharpGlyph{\kern.05em\M@musicsymbol[.2ex]{4}\kern-.05em}%
\DeclareRobustCommand*\M@flatGlyph{\kern-.05em\M@musicsymbol{2}\kern-.06em}%
\DeclareRobustCommand*\M@naturalGlyph{\M@musicsymbol{6}\kern-.06em}%
\DeclareRobustCommand*\M@doubleSharpGlyph{\kern.05em\M@musicsymbol{5}\kern-.05em}%
\DeclareRobustCommand*\M@doubleFlatGlyph{\kern-.05em\M@musicsymbol{3}\kern-.06em}%


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Tools

\newcounter{M@modulo}
\newcommand{\M@odulo}[2]{
	\setcounter{M@modulo}{#1}
	\pgfmathparse{int(#2-#1)}
	\loop
	\ifnum\theM@modulo>\pgfmathresult
		\addtocounter{M@modulo}{-#2}
	\repeat
	\ifnum\theM@modulo<0
		\addtocounter{M@modulo}{#2}
	\repeat
}

\newcounter{M@max}
\newcommand{\M@ax}[2][\theM@max]{
	\setcounter{M@max}{#1}
	\ifnum#2>#1
		\setcounter{M@max}{#2}
	\fi
}

\newcounter{M@min}
\newcommand{\M@in}[2][\theM@min]{
	\setcounter{M@min}{#1}
	\ifnum#2<#1
		\setcounter{M@min}{#2}
	\fi
}

\newcounter{M@count}
\newcommand{\M@Count}[1]{
	\setcounter{M@count}{0}
	\foreach\IND in {#1} {\ifthenelse{\equal{\IND}{!}}{}{\stepcounter{M@count}}}
}

\newcommand{\M@EqStr}[3]{\ifthenelse{\equal{#1}{#2}}{#3}{}}
\newcommand{\M@NotEmpty}[2]{\ifthenelse{\equal{#1}{}}{}{#2}}

\newcounter{M@afterBar}
\newcommand{\M@moveMX}[1]{%
    \setcounter{M@afterBar}{0}%
    \pgfmathparse{int((#1)*\M@hsep)}%
    \addtocounter{MX}{\pgfmathresult}%
    \pgfmathsetmacro{\M@realX}{\theMX*0.0625}%
}
\newcommand{\M@addMX}{\M@moveMX{1}}
\newcommand{\M@addhalfMX}{\M@moveMX{0.5}}
\newcommand{\M@addquarterMX}{\M@moveMX{0.25}}
\newcommand{\M@remMX}{\M@moveMX{-1}}
\newcommand{\M@remhalfMX}{\M@moveMX{-0.5}}
\newcommand{\M@remquarterMX}{\M@moveMX{-0.25}}

