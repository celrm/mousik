\newlength{\MWidth}
\newlength{\MHeight}
\newcommand{\MResize}[1]{
	\settowidth{\MWidth}{#1}
	\settoheight{\MHeight}{#1}
	\resizebox{1.5\MWidth}{1.5\MHeight}{#1}
}
\newcommand{\TimeSig}[2]{
	\Adv
	\ifx&#2&
		\ifthenelse{\equal{#1}{C}}%
			{\node at (\theMX*0.5,-\theMY*2+0.5) {\meterC};}%
		{\ifthenelse{\equal{#1}{C|}}%
			{\node at (\theMX*0.5,-\theMY*2+0.575) {\allabreve};}%
		{\node at (\theMX*0.5,-\theMY*2+0.4) {\bf \MResize{#1}};}%
		}
	\else
		\node at (\theMX*0.5,-\theMY*2+0.6) {\bf \MResize{#1}};
		\node at (\theMX*0.5,-\theMY*2+0.2) {\bf \MResize{#2}};
	\fi
	\addtocounter{MX}{3}
}

\newcommand{\Dot}[2][1]{
	\foreach \IND in {1,...,#1}
	{\MPlaceNR[+0.15*\IND]{#2}{\resizebox{0.1cm}{0.1cm}{$\bullet$}};}
}

\newcounter{Maux}
\newcounter{MauxB}
\newcommand{\Tuplet}[2][]{
	\addtocounter{MX}{-1}
	\setcounter{Mevaluate}{\theMX}
	\addtocounter{Mevaluate}{-\theMaux}
	\setcounter{MauxB}{0}
	\ifnum\theMevaluate=2\else
	\setcounter{MauxB}{21}
	\fi
	\node at (\theMaux*0.5+\theMevaluate*0.25-0.15-\theMauxB*0.01,-\theMY*2+#2*0.1)
	{\ifx&#1&\theMevaluate\else#1\fi};
	\addtocounter{MX}{1}
}

