			(\theMxpos*0.5+0.115,-\theMypos*2+#3*0.1+#1);
	\else
		\draw[line width=0.25mm]  (\theMxpos*0.5-0.14,-\theMypos*2+#2*0.1-0.2) --
			(\theMxpos*0.5-0.14,-\theMypos*2+#3*0.1-0.5-#1);
	\fi
	\ifswap\Mswap\fi
}

\newcommand{\Ledger}[1]{
	\ifnum1>#1
	\foreach\i in {0,...,#1} {
		\ifthenelse{\isodd{\i}}{}
		{\draw (\theMxpos*0.5-0.25,-\theMypos*2-0.2+\i*0.1) -- (\theMxpos*0.5+0.25,-\theMypos*2-0.2+\i*0.1);}
	}
	\fi\ifnum11<#1
	\foreach\i in {12,...,#1} {
		\ifthenelse{\isodd{\i}}{}
		{\draw (\theMxpos*0.5-0.25,-\theMypos*2-0.2+\i*0.1) -- (\theMxpos*0.5+0.25,-\theMypos*2-0.2+\i*0.1);}
	}
	\fi
}

