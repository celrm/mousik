\newcommand{\Head}[1]{
	\node [opacity=0.0] (tmp) at (\theMxpos*0.5,-\theMypos*2-0.2+#1*0.1) {};
	\fill[rotate around={16:(tmp.center)}] (\theMxpos*0.5-0.01,-\theMypos*2-0.195+#1*0.1) ellipse (4pt and 2.75pt);}

\newcommand{\HollowHead}[1]{
	\node [opacity=0.0] (tmp) at (\theMxpos*0.5,-\theMypos*2-0.2+#1*0.1) {};
	\fill[black,rotate around={16:(tmp.center)}] (\theMxpos*0.5-0.01,-\theMypos*2-0.195+#1*0.1) ellipse (4pt and 2.75pt);
	\fill[white,rotate around={19:(tmp.center)}] (\theMxpos*0.5-0.01,-\theMypos*2-0.195+#1*0.1) ellipse (3.2pt and 1.35pt);
}


\newcommand{\Enlarge}[3][0]{
