}

\newcommand{\Init}[1][]{%
\pgfkeys{/mousik, default, #1}%
\ifM@piano
	\pgfmathsetmacro{\M@vsep}{\M@vsep+\M@pianoSep}%
\fi
\setcounter{MX}{0}\setcounter{MY}{0}%
\setcounter{M@clef}{-1}\setcounter{M@key}{0}%
\setcounter{M@staff}{1}%
\setcounter{M@upperMX}{0}\setcounter{M@lowerMX}{0}%
\setcounter{M@upperMY}{0}\setcounter{M@lowerMY}{0}%
\setcounter{M@upperClef}{-1}\setcounter{M@lowerClef}{-1}%
\setcounter{M@upperKey}{0}\setcounter{M@lowerKey}{0}%
\setcounter{M@afterBar}{0}%
\setcounter{M@upperAfterBar}{0}\setcounter{M@lowerAfterBar}{0}%
\M@lengthSetfalse
\ifM@single
	\def\M@staffBottom{0.2}\def\M@staffTop{0.6}\def\M@staffMid{0.4}%
\else
	\def\M@staffBottom{0}\def\M@staffTop{0.8}\def\M@staffMid{0.4}%
\fi
\pgfmathsetmacro{\M@barBottom}{\M@staffBottom-0.007}%
\pgfmathsetmacro{\M@barTop}{\M@staffTop+0.007}%
}

\newcommand{\M@SaveStaffState}{%
\ifnum\theM@staff=1
	\setcounter{M@upperMX}{\theMX}\setcounter{M@upperMY}{\theMY}%
	\setcounter{M@upperClef}{\theM@clef}\setcounter{M@upperKey}{\theM@key}%
	\setcounter{M@upperAfterBar}{\theM@afterBar}%
\else
	\setcounter{M@lowerMX}{\theMX}\setcounter{M@lowerMY}{\theMY}%
	\setcounter{M@lowerClef}{\theM@clef}\setcounter{M@lowerKey}{\theM@key}%
	\setcounter{M@lowerAfterBar}{\theM@afterBar}%
\fi}

\newcommand{\M@RestoreStaffState}[1]{%
\ifnum#1=1
	\setcounter{MX}{\theM@upperMX}\setcounter{MY}{\theM@upperMY}%
	\setcounter{M@clef}{\theM@upperClef}\setcounter{M@key}{\theM@upperKey}%
	\setcounter{M@afterBar}{\theM@upperAfterBar}%
\else
	\setcounter{MX}{\theM@lowerMX}\setcounter{MY}{\theM@lowerMY}%
	\setcounter{M@clef}{\theM@lowerClef}\setcounter{M@key}{\theM@lowerKey}%
	\setcounter{M@afterBar}{\theM@lowerAfterBar}%
\fi
\pgfmathsetmacro{\M@realX}{\theMX*0.0625}}

\newcommand{\M@SwitchStaff}[1]{%
\ifM@piano
	\ifnum#1=\theM@staff\else
		\M@SaveStaffState
		\ifnum\theM@staff=2 \pgftransformyshift{\M@pianoSep cm}\fi
		\setcounter{M@staff}{#1}%
		\ifnum#1=2 \pgftransformyshift{-\M@pianoSep cm}\fi
		\M@RestoreStaffState{#1}%
	\fi
\else
	\PackageWarning{mousik}{\string\UpperStaff/\string\LowerStaff\space require the piano option}%
\fi}

\newcommand{\UpperStaff}{\M@SwitchStaff{1}}
\newcommand{\LowerStaff}{\M@SwitchStaff{2}}

\newcommand{\M@PreparePianoStaff}{%
\M@SaveStaffState
\ifnum\theM@staff=2 \pgftransformyshift{\M@pianoSep cm}\fi
\pgfmathparse{int(2*\M@hsep)}\setcounter{M@aux}{\pgfmathresult}%
\addtocounter{M@upperMX}{-\theM@aux}\addtocounter{M@lowerMX}{-\theM@aux}%
\ifnum\theM@upperMX<0 \setcounter{M@upperMX}{0}\fi
\ifnum\theM@lowerMX<0 \setcounter{M@lowerMX}{0}\fi
\ifnum\theM@upperMY>\theM@lowerMY
	\setcounter{MY}{\theM@upperMY}\setcounter{MX}{\theM@upperMX}%
\else\ifnum\theM@lowerMY>\theM@upperMY
	\setcounter{MY}{\theM@lowerMY}\setcounter{MX}{\theM@lowerMX}%
\else
	\setcounter{MY}{\theM@upperMY}%
	\ifnum\theM@upperMX>\theM@lowerMX
		\setcounter{MX}{\theM@upperMX}%
	\else
		\setcounter{MX}{\theM@lowerMX}%
	\fi
\fi\fi
\pgfmathsetmacro{\M@realX}{\theMX*0.0625}%
}

\newenvironment{mousik}[1][]{%
\Init[#1]%
\noindent\begin{tikzpicture}[
	background rectangle/.style={fill=\M@color},
	show background rectangle,\M@TIKz]
\Space[\M@indent]
\ifM@piano
	\setcounter{M@upperMX}{\theMX}\setcounter{M@lowerMX}{\theMX}%
\fi
}{%
\ifM@piano
	\M@PreparePianoStaff
\else
	\M@remMX\M@remMX
\fi
\M@Staff % paint the staff at the end
\setcounter{MX}{0}\setcounter{MY}{0}
\setcounter{M@clef}{-1}\setcounter{M@key}{0}
\end{tikzpicture}}

% Mswap is used to swap the stem of the note
\newif\ifMswap\Mswapfalse % the user defined
\newif\ifnoMswap\noMswapfalse % the internal
\newcommand{\Swap}{\ifnoMswap \noMswapfalse \else \noMswaptrue \fi}

\newcommand{\M@DrawStaffAt}[2]{%
\pgfmathsetmacro{\M@XcoordOne}{%
	\ifnum#1=0 {-0.25+\M@indent} \else {-0.25} \fi}%
\pgfmathsetmacro{\M@XcoordTwo}{%
	\ifnum#1=\theMY {\theMX*0.0625} \else {\M@long*0.12} \fi}%
\ifM@single
	\pgfmathsetmacro{\M@Ycoord}{-#1*\M@vsep+(#2)+0.4}%
	\draw (\M@XcoordOne,\M@Ycoord) -- (\M@XcoordTwo,\M@Ycoord);%
\else
	\foreach\INDj in {0,...,4} {%
		\pgfmathsetmacro{\M@Ycoord}{-#1*\M@vsep+(#2)+\INDj*0.2}%
		\draw (\M@XcoordOne,\M@Ycoord) -- (\M@XcoordTwo,\M@Ycoord);%
	}%
\fi}

\newcommand{\M@Staff}{%
\foreach\INDi in {0,...,\theMY} {% amount of score systems
	\M@DrawStaffAt{\INDi}{0}%
	\ifM@piano \M@DrawStaffAt{\INDi}{-\M@pianoSep}\fi
}}

