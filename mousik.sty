\newif\ifM@mixedCancel
\newcommand{\MixedKey}[2]{
	\ifnum#1=0 \ifnum#2=0 \setcounter{M@afterBar}{0}%
		\else \M@BarKeyKern \fi
	\else \M@BarKeyKern \fi
	\M@mixedCancelfalse
	\pgfmathtruncatemacro{\M@oldkeyabs}{abs(#1)}
	\pgfmathtruncatemacro{\M@newkeyabs}{abs(#2)}
	\def\M@mixedKeep{0}
	\ifnum#1=0 \else
		\ifnum#2=0
			\M@mixedCanceltrue
		\else\ifnum\numexpr#1*#2\relax<0
			\M@mixedCanceltrue
		\else\ifnum\M@newkeyabs<\M@oldkeyabs
			\M@mixedCanceltrue
			\edef\M@mixedKeep{\M@newkeyabs}
		\fi\fi\fi
	\fi
	\ifM@mixedCancel
		\M@DrawKeyCancellation{#1}{\M@mixedKeep}
		\M@addMX
	\fi
	\ifnum#2=0 \else
		\M@DrawKey{#2}
		\M@addMX
	\fi
	\setcounter{M@key}{#2}
}


