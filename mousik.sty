\newif\ifswap\swapfalse
\newif\ifnoswap\noswaptrue

\newcommand{\Mswap}{
	\ifnoswap\noswapfalse
	\else\noswaptrue
	\fi
}
\newcommand{\Swap}{
	\ifswap\swapfalse
	\else\swaptrue
	\fi
}

\newcommand{\MStaff}{
	\foreach\INDi in {0,...,\theMY} {
		\foreach\INDj in {0,...,4} {
			\ifnum\INDi=\theMY
				\ifnum\INDi=0
					\draw (-0.25+\Mindent,-\INDi*2+\INDj*0.2)
					-- (\theMX*\MX,-\INDi*2+\INDj*0.2);
				\else
					\draw (-0.25,-\INDi*2+\INDj*0.2)
					-- (\theMX*\MX,-\INDi*2+\INDj*0.2);
				\fi
			\else\ifnum\INDi=0
				\draw (-0.25+\Mindent,-\INDi*2+\INDj*0.2)
				-- (\Mlong*0.12,-\INDi*2+\INDj*0.2);
				\else
				\draw (-0.25,-\INDi*2+\INDj*0.2)
				-- (\Mlong*0.12,-\INDi*2+\INDj*0.2);
			\fi\fi
		}
	}
}
\newcommand{\Octave}[1]{
\ifnum#1=8
	\ifnum\theMclef=1
	\node at (\theMX*\MX+0.15,-\theMY*2+0.95) {\scriptsize\bf 8};
	\fi\ifnum\theMclef=2
	\node at (\theMX*\MX+0.15,-\theMY*2+1.1) {\scriptsize\bf 8};
	\fi\ifnum\theMclef=3
	\node at (\theMX*\MX+0.05,-\theMY*2+0.7) {\scriptsize\bf 8};
	\fi\ifnum\theMclef=4
	\node at (\theMX*\MX+0.05,-\theMY*2+0.95) {\scriptsize\bf 8};
	\fi\ifnum\theMclef=11
	\node at (\theMX*\MX+0.1,-\theMY*2+0.6) {\scriptsize\bf 8};
	\fi\ifnum\theMclef=12
	\node at (\theMX*\MX+0.1,-\theMY*2+0.8) {\scriptsize\bf 8};
	\fi\ifnum\theMclef=13
	\node at (\theMX*\MX+0.1,-\theMY*2+1) {\scriptsize\bf 8};
	\fi\ifnum\theMclef=14
	\node at (\theMX*\MX+0.1,-\theMY*2+1.2) {\scriptsize\bf 8};
	\fi\ifnum\theMclef=15
	\node at (\theMX*\MX+0.1,-\theMY*2+1.4) {\scriptsize\bf 8};
	\fi
\fi\ifnum#1=-8
	\ifnum\theMclef=1
	\node at (\theMX*\MX+0.05,-\theMY*2-0.6) {\scriptsize\bf 8};
	\fi\ifnum\theMclef=2
	\node at (\theMX*\MX+0.05,-\theMY*2-0.4) {\scriptsize\bf 8};
	\fi\ifnum\theMclef=3
	\node at (\theMX*\MX+0.05,-\theMY*2-0.2) {\scriptsize\bf 8};
	\fi\ifnum\theMclef=4
	\node at (\theMX*\MX+0.05,-\theMY*2) {\scriptsize\bf 8};
	\fi\ifnum\theMclef=11
	\node at (\theMX*\MX+0.1,-\theMY*2-0.6) {\scriptsize\bf 8};
	\fi\ifnum\theMclef=12
	\node at (\theMX*\MX+0.1,-\theMY*2-0.4) {\scriptsize\bf 8};
	\fi\ifnum\theMclef=13
	\node at (\theMX*\MX+0.1,-\theMY*2-0.2) {\scriptsize\bf 8};
	\fi\ifnum\theMclef=14
	\node at (\theMX*\MX+0.1,-\theMY*2) {\scriptsize\bf 8};
	\fi\ifnum\theMclef=15
	\node at (\theMX*\MX+0.1,-\theMY*2+0.2) {\scriptsize\bf 8};
	\fi
\fi
}

\pgfkeys{
	/MClef/.is family
	, /MClef
	, default/.style = 
	{	t = 2
		, octave = 0
		, xshift = 0
		, yshift = 0
	}
	, t/.estore in=\MclefT
	, octave/.estore in=\MclefOct
	, xshift/.estore in=\MshiftX
	, yshift/.estore in=\MshiftY
}
\newcommand{\Clef}[1][]{
	\pgfkeys{/MClef, default, #1}%
	\setcounter{Mclef}{\MclefT}
	\Adv
\begin{scope}[xshift=\MshiftX cm,yshift=\MshiftY cm]
	
	\Octave{\MclefOct}
	
	\ifnum\theMclef=1
		\node at (\theMX*\MX+0.1,-\theMY*2+0.15)
		{\trebleclef};
	\fi\ifnum\theMclef=2
		\node at (\theMX*\MX+0.1,-\theMY*2+0.35)
		{\trebleclef};
	\fi\ifnum\theMclef=3
		\node at (\theMX*\MX+0.1,-\theMY*2+0.8)
		{{\resizebox{0.7cm}{0.8cm}{\bassclef}}};
	\fi\ifnum\theMclef=4
		\node at (\theMX*\MX+0.1,-\theMY*2+1)
		{{\resizebox{0.7cm}{0.8cm}{\bassclef}}};
	\fi\ifnum\theMclef=11
		\node at (\theMX*\MX+0.1,-\theMY*2+0.4)
		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
	\fi\ifnum\theMclef=12
		\node at (\theMX*\MX+0.1,-\theMY*2+0.6)
		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
	\fi\ifnum\theMclef=13
		\node at (\theMX*\MX+0.1,-\theMY*2+0.8)
		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
	\fi\ifnum\theMclef=14
		\node at (\theMX*\MX+0.1,-\theMY*2+1)
		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
	\fi\ifnum\theMclef=15
		\node at (\theMX*\MX+0.1,-\theMY*2+1.2)
		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
	\fi\ifnum\theMclef=0
		\draw[line width=1.5mm] (\theMX*\MX,-\theMY*2+0.2) -- (\theMX*\MX,-\theMY*2+0.6);
		\draw[line width=1.5mm] (\theMX*\MX+0.3,-\theMY*2+0.2) -- (\theMX*\MX+0.3,-\theMY*2+0.6);
	\fi
	\addtocounter{MX}{\XM}
\end{scope}
}

\newlength{\MWidth}
\newlength{\MHeight}
\newcommand{\MResize}[1]{
	\settowidth{\MWidth}{#1}
	\settoheight{\MHeight}{#1}
	\resizebox{1.5\MWidth}{1.5\MHeight}{#1}
}
\pgfkeys{
	/MTimeSig/.is family
	, /MTimeSig
	, default/.style = 
	{	xshift = 0
		, yshift = 0
	}
	, xshift/.estore in=\MshiftX
	, yshift/.estore in=\MshiftY
}
\newcommand{\TimeSig}[3][]{
	\pgfkeys{/MTimeSig, default, #1}%
	\Adv
	\begin{scope}[xshift=\MshiftX cm,yshift=\MshiftY cm]
	\normalsize
	\ifx&#3&
		\ifthenelse{\equal{#2}{C}}%
			{\node at (\theMX*\MX-0.25,-\theMY*2+0.5) {\meterC};}%
		{\ifthenelse{\equal{#2}{C|}}%
			{\node at (\theMX*\MX-0.25,-\theMY*2+0.575) {\allabreve};}%
		{\node at (\theMX*\MX-0.25,-\theMY*2+0.4) {\bf \MResize{#2}};}%
		}
	\else
		\node at (\theMX*\MX-0.25,-\theMY*2+0.6) {\bf \MResize{#2}};
		\node at (\theMX*\MX-0.25,-\theMY*2+0.2) {\bf \MResize{#3}};
	\fi
	\addtocounter{MX}{\XM}
	\end{scope}
}

\newcommand{\MDot}[2][1]{
	\foreach \IND in {1,...,#1}
	{\MPlaceNR[+0.15*\IND]{#2}{\resizebox{0.1cm}{0.1cm}{$\bullet$}};}
}

\pgfkeys{
	/MDot/.is family
	, /MDot
	, default/.style = 
	{	t = *
		, xshift = 0
		, yshift = 0
	}
	, t/.estore in=\MDotT
	, xshift/.estore in=\MshiftX
	, yshift/.estore in=\MshiftY
}
\newcommand{\Dot}[2][]{
	\pgfkeys{/MDot, default, #1}%
	\begin{scope}[xshift=\MshiftX cm,yshift=\MshiftY cm]
	\MStringz{\MDotT}{*}{\MDot[1]{#2}}
	\MStringz{\MDotT}{.}{\MDot[1]{#2}}
	\MStringz{\MDotT}{**}{\MDot[2]{#2}}
	\MStringz{\MDotT}{..}{\MDot[2]{#2}}
	\end{scope}
}

\pgfkeys{
	/MDots/.is family
	, /MDots
	, default/.style = 
	{	xshift = 0
		, yshift = 0
	}
	, xshift/.estore in=\MshiftX
	, yshift/.estore in=\MshiftY
}
\newcommand{\Dots}[2][]{
	\pgfkeys{/MDots, default, #1}%
	\Adv
	\begin{scope}[xshift=\MshiftX cm,yshift=\MshiftY cm]
	\setcounter{Maux}{\theMX}
	\foreach\INDp/\INDh in {#2} {
		\ifthenelse{\equal{\INDp}{!}}{\addtocounter{MX}{\XM/4}}{
		\MNEmpty{\INDp}{
			\Dot[t=\INDp]{\INDh}
		}
		\addtocounter{MX}{\XM/2}
	}}
	\setcounter{MX}{\theMaux}
	\end{scope}
}

\newcounter{Maux}
\newcounter{MauxB}
\newcounter{Mheight}
\newcommand{\Tuplet}[1][]{
	\addtocounter{MX}{-\XM/2}
	\setcounter{MauxB}{\theMX}\addtocounter{MauxB}{-\theMaux-\XM/2}
	\node at (\theMaux*\MX+\theMauxB*\MX*0.5+0.1*\ifnoswap 1 \else -1\fi,
	-\theMY*2+\theMheight*0.1+0.3*\ifnoswap 1 \else -1\fi)
	{\ifthenelse{\equal{#1}{}}%
		{\theMcount}{#1}%
	};
	\addtocounter{MX}{\XM/2}
}

