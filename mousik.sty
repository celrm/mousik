\newcommand{\Note}[2]{
	\Adv
	
	\ifnum#1=1
	\Semibreve{#2}
	\fi\ifnum#1=2
	\Minim{#2}
	\fi\ifnum#1=4
	\Crotchet{#2}
	\fi\ifnum#1=8 %%%%%% TODO
	\node at (\theMxpos*0.5+0.09,-\theMypos*2+0.02+#2*0.1) {\resizebox{0.45cm}{0.65cm}{\Acht}};
	\fi\ifnum#1=16
	\node at (\theMxpos*0.5+0.09,-\theMypos*2+0.02+#2*0.1) {\resizebox{0.45cm}{0.65cm}{\Sech}};
	\fi\ifnum#1=32
	\node at (\theMxpos*0.5+0.09,-\theMypos*2+0.095+#2*0.1) {\resizebox{0.45cm}{0.8cm}{\Zwdr}};
	\fi
	
	\Ledger{#2}
	\addtocounter{Mxpos}{2}
}

\newcommand{\PolyNote}[2]{
	\Adv
	\setcounter{Mfirst}{-50}
	\setcounter{Mmax}{-50}
	\setcounter{Mmin}{50}
	\setcounter{aux}{\theMxpos}
	
	\ifnum#1=1
	\foreach\n in {#2} {
		\Semibreve{\n}
		\stepcounter{Mxpos}}
	\else\ifnum#1=2
	\foreach\n in {#2} {
		\node at (\theMxpos*0.5,-\theMypos*2-0.2+\n*0.1) {\resizebox{0.3cm}{0.2cm}{\Halb}};
		\stepcounter{Mxpos}}	
	\else\ifnum#1=4
	\foreach\n in {#2} {
		\Crotchet{\n}
		\stepcounter{Mxpos}}
\else
	\foreach\n in {#2} {
		\Head{\n}
		\stepcounter{Mxpos}
		\MMax{\n}\MMin{\n}
		\ifnum\theMfirst=-50\setcounter{Mfirst}{\n}\fi
	}
	\setcounter{Mevaluate}{\theMxpos}\addtocounter{Mevaluate}{-\theaux}
	\setcounter{Mxpos}{\theaux}
	\ifnum\theMevaluate=2
		\foreach\n in {#2} {
			\ifnum\theMmax<6
				\ifnum#1=8
					\Enlarge[0.4]{\n}{\n}
				\fi\ifnum#1=16
					\Enlarge[0.5]{\n}{\n}
				\fi\ifnum#1=32
					\Enlarge[0.6]{\n}{\n}
				\fi
			\else
				\ifnum#1=8
					\EnlargeDown[0.4]{\n}{\n}
				\fi\ifnum#1=16
					\EnlargeDown[0.5]{\n}{\n}
				\fi\ifnum#1=32
					\EnlargeDown[0.6]{\n}{\n}
				\fi
			\fi
			\stepcounter{Mxpos}
		}
		\addtocounter{Mxpos}{-1}
		
		\ifnum\theMmax<6
			\ifnum#1=8
				\BeamS{+0.4}
			\fi\ifnum#1=16
				\BeamS{+0.5}
				\BeamS{+0.35}
			\fi\ifnum#1=32
				\BeamS{+0.6}
				\BeamS{+0.45}
				\BeamS{+0.3}
			\fi
		\else
			\ifnum#1=8
				\BeamSDown{+0.4}
			\fi\ifnum#1=16
				\BeamSDown{+0.5}
				\BeamSDown{+0.35}
			\fi\ifnum#1=32
				\BeamSDown{+0.6}
				\BeamSDown{+0.45}
				\BeamSDown{+0.3}
			\fi
		\fi
	\else
		\foreach\n in {#2} {
			\ifnum\theMmax<6
				\ifnum#1=8
					\Enlarge[0.4]{\n}{\theMmax}
				\fi\ifnum#1=16
					\Enlarge[0.5]{\n}{\theMmax}
				\fi\ifnum#1=32
					\Enlarge[0.6]{\n}{\theMmax}
				\fi
			\else
				\ifnum#1=8
					\EnlargeDown[0.3]{\n}{\theMmin}
				\fi\ifnum#1=16
					\EnlargeDown[0.4]{\n}{\theMmin}
				\fi\ifnum#1=32
					\EnlargeDown[0.5]{\n}{\theMmin}
				\fi
			\fi
			\stepcounter{Mxpos}
		}
		\ifnum\theMmax<6
			\ifnum#1=8
				\Beam{\theaux}{\theMmax}{\theMmax}{+0.4}
			\fi\ifnum#1=16
				\Beam{\theaux}{\theMmax}{\theMmax}{+0.5}
				\Beam{\theaux}{\theMmax}{\theMmax}{+0.35}
			\fi\ifnum#1=32
				\Beam{\theaux}{\theMmax}{\theMmax}{+0.6}
				\Beam{\theaux}{\theMmax}{\theMmax}{+0.45}
				\Beam{\theaux}{\theMmax}{\theMmax}{+0.3}
			\fi
		\else
			\ifnum#1=8
				\BeamDown{\theaux}{\theMmin}{\theMmin}{+0.3}
			\fi\ifnum#1=16
				\BeamDown{\theaux}{\theMmin}{\theMmin}{+0.4}
				\BeamDown{\theaux}{\theMmin}{\theMmin}{+0.25}
			\fi\ifnum#1=32
				\BeamDown{\theaux}{\theMmin}{\theMmin}{+0.5}
				\BeamDown{\theaux}{\theMmin}{\theMmin}{+0.35}
				\BeamDown{\theaux}{\theMmin}{\theMmin}{+0.2}
			\fi
		\fi
	\fi
\fi\fi\fi
	\setcounter{Mxpos}{\theaux}
	\foreach\n in {#2} {
		\Ledger{\n}
		\stepcounter{Mxpos}
	}
	\addtocounter{Mxpos}{1}
}

