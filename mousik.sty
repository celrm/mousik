\newcommand{\@MAcc}[3][-0.25]{
	\@EqStr{#2}{-2}{\@MPlaceNL[#1-0.07]{#3+0.1}{{\resizebox{0.3cm}{0.35cm}{\doubleflat}}}}
	\@EqStr{#2}{-1.5}{\@MPlaceNL[#1-0.07]{#3+0.1}{{\resizebox{0.3cm}{0.35cm}{\sflat}}}}
	\@EqStr{#2}{-1}{\@MPlaceNL[#1]{#3+0.1}{{\resizebox{0.15cm}{0.35cm}{\flat}}}}
	\@EqStr{#2}{b}{\@MPlaceNL[#1]{#3+0.1}{{\resizebox{0.15cm}{0.35cm}{\flat}}}}
	\@EqStr{#2}{-0.5}{\@MPlaceNL[#1]{#3+0.1}{{\resizebox{0.15cm}{0.35cm}{\dflat}}}}
	\@EqStr{#2}{0}{\@MPlaceNL[#1]{#3}{{\resizebox{0.15cm}{0.35cm}{\natural}}}}
	\@EqStr{#2}{0.5}{\@MPlaceNL[#1+0.07]{#3-0.015}{{\resizebox{0.2cm}{0.35cm}{\dsharp}}}}
	\@EqStr{#2}{1}{\@MPlaceNL[#1]{#3}{{\resizebox{0.15cm}{0.35cm}{\sharp}}}}
	\@EqStr{#2}{\#}{\@MPlaceNL[#1]{#3}{{\resizebox{0.15cm}{0.35cm}{\sharp}}}}
	\@EqStr{#2}{1.5}{\@MPlaceNL[#1+0.02]{#3}{{\resizebox{0.3cm}{0.35cm}{\ssharp}}}}
	\@EqStr{#2}{2}{\@MPlaceNL[#1]{#3}{{\resizebox{0.15cm}{0.15cm}{\doublesharp}}}}
}
