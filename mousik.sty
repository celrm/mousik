\newcommand{\Clef}[1][2]{
	\setcounter{Mclef}{#1}
	\Adv
	
	\ifnum#1=1
		\node at (\theMX*0.5+0.1,-\theMY*2+0.15)
		{\trebleclef};
	\fi\ifnum#1=2
		\node at (\theMX*0.5+0.1,-\theMY*2+0.35)
		{\trebleclef};
	\fi\ifnum#1=3
		\node at (\theMX*0.5+0.1,-\theMY*2+0.8)
		{{\resizebox{0.7cm}{0.8cm}{\bassclef}}};
	\fi\ifnum#1=4
		\node at (\theMX*0.5+0.1,-\theMY*2+1)
		{{\resizebox{0.7cm}{0.8cm}{\bassclef}}};
	\fi\ifnum#1=11
		\node at (\theMX*0.5+0.1,-\theMY*2+0.4)
		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
	\fi\ifnum#1=12
		\node at (\theMX*0.5+0.1,-\theMY*2+0.6)
		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
	\fi\ifnum#1=13
		\node at (\theMX*0.5+0.1,-\theMY*2+0.8)
		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
