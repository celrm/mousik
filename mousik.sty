\newcommand{\Head}[1]{
	\node [opacity=0.0] (tmp) at (\theMX*0.5,-\theMY*2-0.2+#1*0.1) {};
	\fill[rotate around={16:(tmp.center)}] (\theMX*0.5-0.01,-\theMY*2-0.195+#1*0.1) ellipse (4pt and 2.75pt);}

\newcommand{\HollowHead}[1]{
	\node [opacity=0.0] (tmp) at (\theMX*0.5,-\theMY*2-0.2+#1*0.1) {};
	\fill[black,rotate around={16:(tmp.center)}] (\theMX*0.5-0.01,-\theMY*2-0.195+#1*0.1) ellipse (4pt and 2.75pt);
	\fill[white,rotate around={19:(tmp.center)}] (\theMX*0.5-0.01,-\theMY*2-0.195+#1*0.1) ellipse (3.2pt and 1.35pt);
}

\newcommand{\Menlarge}[3][0]{
	\ifswap\Mswap\fi
	\ifnoswap
		\draw[line width=0.25mm]  (\theMX*0.5+0.115,-\theMY*2+#2*0.1-0.2) --
			(\theMX*0.5+0.115,-\theMY*2+#3*0.1+#1);
	\else
		\draw[line width=0.25mm]  (\theMX*0.5-0.14,-\theMY*2+#2*0.1-0.2) --
			(\theMX*0.5-0.14,-\theMY*2+#3*0.1-0.5-#1);
	\fi
	\ifswap\Mswap\fi
}
\newcommand{\Enlarge}[2]{
\Menlarge{#1}{#2}
\swapfalse
}

\newcommand{\Ledger}[1]{
	\ifnum1>#1
	\foreach\INDi in {0,...,#1} {
		\ifthenelse{\isodd{\INDi}}{}%
		{\draw (\theMX*0.5-0.25,-\theMY*2-0.2+\INDi*0.1) --
		(\theMX*0.5+0.25,-\theMY*2-0.2+\INDi*0.1);}
	}
	\fi\ifnum11<#1
	\foreach\INDi in {12,...,#1} {
		\ifthenelse{\isodd{\INDi}}{}%
		{\draw (\theMX*0.5-0.25,-\theMY*2-0.2+\INDi*0.1) --
		(\theMX*0.5+0.25,-\theMY*2-0.2+\INDi*0.1);}
	}
	\fi
}

\newcommand{\Beam}[5][\theMX]{
	\ifswap\Mswap\fi
	\ifnoswap
		\draw[line width=1mm] (#2*0.5+0.103,-\theMY*2+#3*0.1#5) -- (#1*0.5-0.372,-\theMY*2+#4*0.1#5);
	\else
		\draw[line width=1mm] (#2*0.5-0.153,-\theMY*2+#3*0.1-0.5-#5) -- (#1*0.5-0.625,-\theMY*2+#4*0.1-0.5-#5);
	\fi	
	\ifswap\Mswap\fi
}

\newcommand{\BeamS}[1]{
	\ifswap\Mswap\fi
	\ifnoswap
		\ifnum\theMfirst=\theMmin
		\begin{scope}
			\clip (\theMX*0.5-0.4,-\theMY*2+\theMmin*0.1-0.3) rectangle (\theMX*0.5+0.125,-\theMY*2+0.05+\theMmax*0.1#1);
			\draw[line width=1mm] (\theMX*0.5-0.411,-\theMY*2+\theMmin*0.1#1) -- (\theMX*0.5+0.147,-\theMY*2+\theMmax*0.1#1);
		\end{scope}
		\else
		\begin{scope}
			\clip (\theMX*0.5-0.4,-\theMY*2+0.05+\theMmax*0.1#1) rectangle (\theMX*0.5+0.125,-\theMY*2+0.05+\theMmin*0.1-0.3);
			\draw[line width=1mm] (\theMX*0.5-0.411,-\theMY*2+\theMmax*0.1#1) -- (\theMX*0.5+0.147,-\theMY*2+\theMmin*0.1#1);
		\end{scope}
		\fi
	\else
		\ifnum\theMfirst=\theMmin
		\begin{scope}
			\clip (\theMX*0.5-0.645,-\theMY*2+\theMmin*0.1-0.5-#1) rectangle (\theMX*0.5-0.129,-\theMY*2+\theMmax*0.1);
			\draw[line width=1mm] (\theMX*0.5-0.7,-\theMY*2+\theMmin*0.1-#1-0.48) -- (\theMX*0.5-0.1,-\theMY*2+\theMmax*0.1-#1-0.48);
		\end{scope}
		\else
		\begin{scope}
			\clip (\theMX*0.5-0.65,-\theMY*2+\theMmin*0.1-0.5-#1) rectangle (\theMX*0.5-0.129,-\theMY*2+\theMmax*0.1);
			\draw[line width=1mm] (\theMX*0.5-0.7,-\theMY*2+\theMmax*0.1-#1-0.48) -- (\theMX*0.5-0.1,-\theMY*2+\theMmin*0.1-#1-0.48);
		\end{scope}
		\fi
	\fi
	\ifswap\Mswap\fi
}

\newcommand{\Flag}[2][0]{
	\ifswap\Mswap\fi
	\ifnoswap
	\begin{scope}
		\clip (\theMX*0.5+0.13,-\theMY*2+#2*0.1-0.75+#1) rectangle (\theMX*0.5+0.35,-\theMY*2+#2*0.1+0.05+#1);
		\node at (\theMX*0.5+0.05,-\theMY*2-0.3+#2*0.1+#1) {\resizebox{0.55cm}{0.65cm}{\Acht}};
	\end{scope}
	\fill[white] (\theMX*0.5+0.205,-\theMY*2-0.308+#2*0.1+#1) circle (1.75pt);
	\else
	\begin{scope}
		\node [opacity=0.0] (tmp) at (\theMX*0.5,-\theMY*2+#2*0.1) {};
		\clip (\theMX*0.5-0.125,-\theMY*2+#2*0.1-0.55-#1) rectangle (\theMX*0.5+0.09,-\theMY*2+#2*0.1+0.15-#1);
		\node[rotate around={180:(tmp.center)}] at (\theMX*0.5+0.175,-\theMY*2+0.165+#2*0.1+#1) {\reflectbox{\resizebox{0.55cm}{0.65cm}{\Acht}}};
	\end{scope}
	\fill[white] (\theMX*0.5-0.035,-\theMY*2-0.161+#2*0.1-#1) circle (2pt);
	\fi
	\ifswap\Mswap\fi
}

\newcommand{\Semibreve}[1]{
	\node at (\theMX*0.5,-\theMY*2-0.2+#1*0.1) {\resizebox{0.3cm}{0.2cm}{\Ganz}};
}
\newcommand{\Minim}[1]{
	\HollowHead{#1}
	\ifnum#1<6\else
		\Mswap
	\fi
	\Menlarge[0.3]{#1}{#1}
}
\newcommand{\Crotchet}[1]{
	\Head{#1}
	\ifnum#1<6\else
		\Mswap
	\fi
	\Menlarge[0.3]{#1}{#1}
}

\newcommand{\Quaver}[1]{
	\Head{#1}
	\ifnum#1<6\else
		\Mswap
	\fi	
	\Menlarge[0.4]{#1}{#1}
	\Flag[0.4]{#1}
}
\newcommand{\Semiquaver}[1]{
	\Head{#1}
	\ifnum#1<6\else
		\Mswap
	\fi	
	\Menlarge[0.5]{#1}{#1}
	\Flag[0.5]{#1}
	\Flag[0.35]{#1}
}
\newcommand{\Demisemiquaver}[1]{
	\Head{#1}
	\ifnum#1<6\else
		\Mswap
	\fi	
	\Menlarge[0.6]{#1}{#1}
	\Flag[0.6]{#1}
	\Flag[0.45]{#1}
	\Flag[0.3]{#1}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Notes : everything together

\newcounter{Mduration}
\newcommand{\Note}[2]{
	\Adv\noswaptrue
	\setcounter{Maux}{\theMX}
	
	\MCount{#1}\setcounter{Mduration}{\theMcount}
\ifnum\theMduration=1
	
	\ifnum#1=1
		\foreach\IND in {#2} {\Semibreve{\IND}\stepcounter{MX}}
	\else\ifnum#1=2
		\foreach\IND in {#2} {\Minim{\IND}\stepcounter{MX}}
	\else\ifnum#1=4
		\foreach\IND in {#2} {\Crotchet{\IND}\stepcounter{MX}}
	\else
		\MCount{#2}
		\ifnum\theMcount=1
			\ifnum#1=8 \Quaver{#2} \else
			\ifnum#1=16 \Semiquaver{#2} \else
			\ifnum#1=32 \Demisemiquaver{#2} \fi\fi\fi
		\else\ifnum\theMcount=2
			\MTwoNote{#1}{#2}
		\else\ifnum\theMcount>2
			\MFlatNote{#1}{#2}
		\fi\fi\fi
	\fi\fi\fi
	
\else\MCount{#2}\ifnum\theMduration=\theMcount
	\MMixedNote{#1}{#2}
\fi\fi

	\setcounter{MX}{\theMaux}
	\foreach\IND in {#2} {
		\Ledger{\IND}\stepcounter{MX}}
	\addtocounter{MX}{1}
	\swapfalse
}

\newcounter{MMdur}
\newcommand{\MMixedNote}[2]{
	\setcounter{Mduration}{8}
	\foreach\INDd in {#1} {
		\ifnum\theMduration<16
			\MStringz{\INDd}{=}{\setcounter{Mduration}{16}}
			\MStringz{\INDd}{=|}{\setcounter{Mduration}{16}}
			\MStringz{\INDd}{|=}{\setcounter{Mduration}{16}}
		\fi\ifnum\theMduration<32
			\MStringz{\INDd}{≡}{\setcounter{Mduration}{32}}
			\MStringz{\INDd}{≡|}{\setcounter{Mduration}{32}}
			\MStringz{\INDd}{|≡}{\setcounter{Mduration}{32}}
		\fi
	}
	
	\MHeads{#2}
	\ifnum\theMmax<6
		\ifswap\setcounter{Mevaluate}{\theMmin}
		\else\setcounter{Mevaluate}{\theMmax}\fi
	\else\Mswap
		\ifswap\setcounter{Mevaluate}{\theMmax}
		\else\setcounter{Mevaluate}{\theMmin}\fi
	\fi
	
	\setcounter{MX}{\theMaux}
	\foreach\IND in {#2} {
		\ifnum\theMduration<16
			\Menlarge[0.4]{\IND}{\theMevaluate}
		\fi\ifnum\theMduration=16
			\Menlarge[0.5]{\IND}{\theMevaluate}
		\fi\ifnum\theMduration=32
			\Menlarge[0.6]{\IND}{\theMevaluate}
		\fi
		\stepcounter{MX}
	}
	
	\ifnum\theMduration<16
		\Beam{\theMaux}{\theMevaluate}{\theMevaluate}{+0.4}
	\fi\ifnum\theMduration=16
		\Beam{\theMaux}{\theMevaluate}{\theMevaluate}{+0.5}
	
		\setcounter{MX}{\theMaux}
		\setcounter{Mfirst}{-50}
		\foreach\INDd in {#1} {
			\stepcounter{MX}
			\MStringz{\INDd}{=}{\Beam[-0.275+\theMX]{-0.25+\theMX}{\theMevaluate}{\theMevaluate}{+0.35}}
			\MStringz{\INDd}{=|}{\Beam[-0.275+\theMX]{-0.5+\theMX}{\theMevaluate}{\theMevaluate}{+0.35}}
			\MStringz{\INDd}{|=}{\Beam[\theMX]{-0.25+\theMX}{\theMevaluate}{\theMevaluate}{+0.35}}
		}
	
	\fi\ifnum\theMduration=32
		\Beam{\theMaux}{\theMevaluate}{\theMevaluate}{+0.6}
		
		\setcounter{MX}{\theMaux}
		\setcounter{Mfirst}{-50}
		\foreach\INDd in {#1} {
			\stepcounter{MX}
			\MStringz{\INDd}{=}{\Beam[-0.275+\theMX]{-0.25+\theMX}{\theMevaluate}{\theMevaluate}{+0.45}}
			\MStringz{\INDd}{=|}{\Beam[-0.275+\theMX]{-0.5+\theMX}{\theMevaluate}{\theMevaluate}{+0.45}}
			\MStringz{\INDd}{|=}{\Beam[\theMX]{-0.25+\theMX}{\theMevaluate}{\theMevaluate}{+0.45}}
			\MStringz{\INDd}{≡}
			{\Beam[-0.275+\theMX]{-0.25+\theMX}{\theMevaluate}{\theMevaluate}{+0.45}
				\Beam[-0.275+\theMX]{-0.25+\theMX}{\theMevaluate}{\theMevaluate}{+0.3}}
			\MStringz{\INDd}{≡|}
			{\Beam[-0.275+\theMX]{-0.5+\theMX}{\theMevaluate}{\theMevaluate}{+0.45}
				\Beam[-0.275+\theMX]{-0.5+\theMX}{\theMevaluate}{\theMevaluate}{+0.3}}
			\MStringz{\INDd}{|≡}{\Beam[\theMX]{-0.25+\theMX}{\theMevaluate}{\theMevaluate}{+0.45}
				\Beam[\theMX]{-0.25+\theMX}{\theMevaluate}{\theMevaluate}{+0.3}}
		}
	\fi
}

\newcommand{\MHeads}[1]{	
	\setcounter{Mfirst}{-50}
	\setcounter{Mmax}{-50}
	\setcounter{Mmin}{50}
	\foreach\IND in {#1} {
		\Head{\IND}\stepcounter{MX}
		\MMax{\IND}\MMin{\IND} % max, min, first
		\ifnum\theMfirst=-50\setcounter{Mfirst}{\IND}\fi
	}
}

\newcommand{\MTwoNote}[2]{
	\MHeads{#2}
	\ifnum\theMmax<6\else\Mswap\fi
	\setcounter{MX}{\theMaux}
	\foreach\IND in {#2} {
		\ifnum#1<16
		\Menlarge[0.4]{\IND}{\IND}
		\fi\ifnum#1=16
		\Menlarge[0.5]{\IND}{\IND}
		\fi\ifnum#1=32
		\Menlarge[0.6]{\IND}{\IND}
		\fi
		\stepcounter{MX}
	}
	\addtocounter{MX}{-1}
	\ifnum#1=8
		\BeamS{+0.4}
	\fi\ifnum#1=16
		\BeamS{+0.5}
		\BeamS{+0.35}
	\fi\ifnum#1=32
		\BeamS{+0.6}
		\BeamS{+0.45}
		\BeamS{+0.3}
	\fi
}
\newcommand{\MFlatNote}[2]{
	\MHeads{#2}
	\ifnum\theMmax<6
		\ifswap\setcounter{Mevaluate}{\theMmin}
		\else\setcounter{Mevaluate}{\theMmax}
		\fi
	\else\Mswap
		\ifswap\setcounter{Mevaluate}{\theMmax}
		\else\setcounter{Mevaluate}{\theMmin}
		\fi
	\fi
	
	\setcounter{MX}{\theMaux}
	\foreach\IND in {#2} {
		\ifnum#1<16
		\Menlarge[0.4]{\IND}{\theMevaluate}
		\fi\ifnum#1=16
		\Menlarge[0.5]{\IND}{\theMevaluate}
