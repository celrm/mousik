\newcounter{M@aux}
\newcommand{\M@ParallelList}[2]{% #1 symbol/height list, #2 action(symbol,height)
	\setcounter{M@aux}{\theMX}%
	\foreach\INDp/\INDh in {#1} {%
		\ifthenelse{\equal{\INDp}{!}}{\M@addhalfMX}{%
			\M@NotEmpty{\INDp}{#2{\INDp}{\INDh}}%
			\M@addMX
		}%
	}%
	\setcounter{MX}{\theM@aux}\pgfmathsetmacro{\M@realX}{\theMX*0.0625}%
}
\newcommand{\M@ParallelDot}[2]{\MDot[t=#1]{#2}}
\newcommand{\MDots}[2][]{
	\pgfkeys{/MDots, default, #1}%
	\Adv
\begin{scope}[xshift=\M@shiftX cm,yshift=\MshiftY cm]
	\M@ParallelList{#2}{\M@ParallelDot}%
\end{scope}
}

\newcounter{M@height}
\newif\ifM@tupletBracket
\newcommand{\Tuplet}[1][]{
	\pgfmathsetmacro{\M@TupletNoteMid}{
		\theM@aux*0.0625 + int(\theMX-\theM@aux-\M@hsep*2)*0.0625*0.5}
	\ifnum\theM@count>2
		\ifnoMswap
			\pgfmathsetmacro{\M@TupletBeamLeft}{\theM@aux*0.0625 + 0.103}
			\pgfmathsetmacro{\M@TupletBeamRight}{(\theMX-2*\M@hsep)*0.0625 + 0.128}
		\else
			\pgfmathsetmacro{\M@TupletBeamLeft}{\theM@aux*0.0625 - 0.153}
			\pgfmathsetmacro{\M@TupletBeamRight}{(\theMX-2*\M@hsep)*0.0625 - 0.125}
		\fi
		\pgfmathsetmacro{\M@TupletX}{0.5*(\M@TupletBeamLeft+\M@TupletBeamRight)}
		\pgfmathsetmacro{\M@TupletLeft}{\M@TupletBeamLeft-0.08}
		\pgfmathsetmacro{\M@TupletRight}{\M@TupletBeamRight+0.08}
	\else
		\pgfmathsetmacro{\M@TupletX}{\M@TupletNoteMid}
		\pgfmathsetmacro{\M@TupletLeft}{\theM@aux*0.0625 - 0.08}
		\pgfmathsetmacro{\M@TupletRight}{2*\M@TupletNoteMid-\theM@aux*0.0625 + 0.08}
	\fi

	\pgfmathsetmacro{\M@TupletBeamY}{-\theMY*\M@vsep-0.2+\theM@height*0.1}
	\ifnoMswap
		\pgfmathsetmacro{\M@TupletY}{\M@TupletBeamY+0.35}
	\else
		\pgfmathsetmacro{\M@TupletY}{\M@TupletBeamY-0.35}
	\fi

	\begin{scope}[xshift=\M@tupletXshift cm,yshift=\M@tupletYshift cm]
		\ifM@tupletBracket
			\draw[line width=0.15mm] (\M@TupletLeft,\M@TupletY) -- (\M@TupletRight,\M@TupletY);
			\ifnoMswap
				\draw[line width=0.15mm] (\M@TupletLeft,\M@TupletY) -- +(0,-0.10);
				\draw[line width=0.15mm] (\M@TupletRight,\M@TupletY) -- +(0,-0.10);
			\else
				\draw[line width=0.15mm] (\M@TupletLeft,\M@TupletY) -- +(0,0.10);
				\draw[line width=0.15mm] (\M@TupletRight,\M@TupletY) -- +(0,0.10);
			\fi
		\fi
		\node[fill=\M@color,inner sep=1pt] at (\M@TupletX,\M@TupletY)
			{\ifthenelse{\equal{#1}{}}{\theM@count}{#1}};
	\end{scope}
}
