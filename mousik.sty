\newcommand{\Head}[1]{
	\node [opacity=0.0] (tmp) at (\theMxpos*0.5,-\theMypos*2-0.2+#1*0.1) {};
	\fill[rotate around={16:(tmp.center)}] (\theMxpos*0.5-0.01,-\theMypos*2-0.195+#1*0.1) ellipse (4pt and 2.75pt);}

\newcommand{\HollowHead}[1]{
	\node [opacity=0.0] (tmp) at (\theMxpos*0.5,-\theMypos*2-0.2+#1*0.1) {};
	\fill[black,rotate around={16:(tmp.center)}] (\theMxpos*0.5-0.01,-\theMypos*2-0.195+#1*0.1) ellipse (4pt and 2.75pt);
	\fill[white,rotate around={19:(tmp.center)}] (\theMxpos*0.5-0.01,-\theMypos*2-0.195+#1*0.1) ellipse (3.2pt and 1.35pt);
}


\newcommand{\Enlarge}[3][0]{
	\draw[line width=0.25mm]  (\theMxpos*0.5+0.115,-\theMypos*2+#2*0.1-0.2) --
		(\theMxpos*0.5+0.115,-\theMypos*2+#3*0.1+#1);
}

\newcommand{\EnlargeDown}[3][0]{
	\draw[line width=0.25mm]  (\theMxpos*0.5-0.14,-\theMypos*2+#2*0.1-0.2) --
		(\theMxpos*0.5-0.14,-\theMypos*2+#3*0.1-0.5-#1);
}

\newcommand{\Ledger}[1]{
	\ifnum1>#1
	\foreach\i in {0,...,#1} {
		\ifthenelse{\isodd{\i}}{}
		{\draw (\theMxpos*0.5-0.25,-\theMypos*2-0.2+\i*0.1) -- (\theMxpos*0.5+0.25,-\theMypos*2-0.2+\i*0.1);}
	}
	\fi\ifnum11<#1
	\foreach\i in {12,...,#1} {
		\ifthenelse{\isodd{\i}}{}
		{\draw (\theMxpos*0.5-0.25,-\theMypos*2-0.2+\i*0.1) -- (\theMxpos*0.5+0.25,-\theMypos*2-0.2+\i*0.1);}
	}
	\fi
}

\newcommand{\Beam}[4]{
	\draw[line width=1mm] (#1*0.5+0.103,-\theMypos*2+#2*0.1#4) -- (\theMxpos*0.5-0.372,-\theMypos*2+#3*0.1#4);}

\newcommand{\BeamDown}[4]{
	\draw[line width=1mm] (#1*0.5-0.153,-\theMypos*2+#2*0.1-0.5-#4) -- (\theMxpos*0.5-0.625,-\theMypos*2+#3*0.1-0.5-#4);}

\newcommand{\BeamS}[1]{
	\ifnum\theMfirst=\theMmin
	\begin{scope}
		\clip (\theMxpos*0.5-0.4,-\theMypos*2+\theMmin*0.1-0.3) rectangle (\theMxpos*0.5+0.125,-\theMypos*2+0.05+\theMmax*0.1#1);
		\draw[line width=1mm] (\theMxpos*0.5-0.411,-\theMypos*2+\theMmin*0.1#1) -- (\theMxpos*0.5+0.147,-\theMypos*2+\theMmax*0.1#1);
	\end{scope}
	\else
	\begin{scope}
		\clip (\theMxpos*0.5-0.4,-\theMypos*2+0.05+\theMmax*0.1#1) rectangle (\theMxpos*0.5+0.125,-\theMypos*2+0.05+\theMmin*0.1-0.3);
		\draw[line width=1mm] (\theMxpos*0.5-0.411,-\theMypos*2+\theMmax*0.1#1) -- (\theMxpos*0.5+0.147,-\theMypos*2+\theMmin*0.1#1);
	\end{scope}
	\fi
}

\newcommand{\BeamSDown}[1]{
	\ifnum\theMfirst=\theMmin
