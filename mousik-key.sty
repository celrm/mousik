	\fi%
	\Modulo{\theaux}{7}
	\setcounter{aux}{\themodulo}
	\addtocounter{aux}{5}
}

\newcommand{\Key}[1]{
	\setcounter{key}{#1}
	\ifnum#1=-1
		\AccF[-0.2]{6}
	\fi\ifnum#1=-2
		\AccF[-0.35]{6}
		\AccF[-0.05]{9}
	\fi\ifnum#1=-3
		\AccF[-0.4]{6}
		\AccF[-0.15]{9}
		\AccF[-0.0]{5}
	\fi\ifnum#1=-4
		\AccF[-0.45]{6}
		\AccF[-0.25]{9}
		\AccF[-0.1]{5}
		\AccF[+0.1]{8}
	\fi\ifnum#1=-5
		\AccF[-0.45]{6}
		\AccF[-0.25]{9}
		\AccF[-0.15]{5}
		\AccF[+0.05]{8}
		\AccF[+0.15]{4}
	\fi\ifnum#1=-6
		\AccF[-0.45]{6}
		\AccF[-0.3]{9}
		\AccF[-0.2]{5}
		\AccF[-0.05]{8}
		\AccF[+0.05]{4}
		\AccF[+0.2]{7}
	\fi\ifnum#1=-7
		\AccF[-0.45]{6}
		\AccF[-0.35]{9}
		\AccF[-0.25]{5}
		\AccF[-0.15]{8}
		\AccF[-0.05]{4}
		\AccF[+0.05]{7}
		\AccF[+0.15]{3}
	\fi		
	\ifnum#1=1
		\AccS[-0.2]{10}
	\fi\ifnum#1=2
		\AccS[-0.35]{10}
		\AccS[-0.05]{7}
	\fi\ifnum#1=3			
		\AccS[-0.425]{10}
		\AccS[-0.2]{7}
		\AccS[-0.025]{11}
	\fi\ifnum#1=4
		\AccS[-0.45]{10}
		\AccS[-0.25]{7}
		\AccS[-0.1]{11}
		\AccS[+0.1]{8}
	\fi\ifnum#1=5
		\AccS[-0.45]{10}
		\AccS[-0.3]{7}
		\AccS[-0.15]{11}
		\AccS[-0.0]{8}
		\AccS[+0.15]{5}
	\fi\ifnum#1=6
		\AccS[-0.4]{10}
		\AccS[-0.3]{7}
		\AccS[-0.2]{11}
		\AccS[-0.1]{8}
		\AccS[+0.0]{5}
		\AccS[+0.1]{9}
	\fi\ifnum#1=7
		\AccS[-0.45]{10}
		\AccS[-0.35]{7}
		\AccS[-0.25]{11}
		\AccS[-0.15]{8}
		\AccS[-0.05]{5}
		\AccS[+0.05]{9}
		\AccS[+0.15]{6}
	\fi

	\OR{#1>0}{#1<0}
	\stepcounter{xpos}
	\fi
}

