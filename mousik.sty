\newcommand{\KB}[1]{
	\setcounter{Maux}{#1}
	\addtocounter{Maux}{-3}
	
	\ifnum\theMclef=1
	\addtocounter{Maux}{-2}
	\fi\ifnum\theMclef=2
	\addtocounter{Maux}{0}
	\fi\ifnum\theMclef=3
	\addtocounter{Maux}{3}
	\fi\ifnum\theMclef=4
	\addtocounter{Maux}{-2}
	\fi\ifnum\theMclef=11
	\addtocounter{Maux}{2}
	\fi\ifnum\theMclef=12
	\addtocounter{Maux}{-3}
	\fi\ifnum\theMclef=13
	\addtocounter{Maux}{-1}
	\fi\ifnum\theMclef=14
	\addtocounter{Maux}{1}
	\fi\ifnum\theMclef=15
	\addtocounter{Maux}{3}
	\fi
	\MModulo{\theMaux}{7}
	\setcounter{Maux}{\theMmodulo}
	\addtocounter{Maux}{3}
}
\newcommand{\KS}[1]{
	\setcounter{Maux}{#1}
	\addtocounter{Maux}{-5}
	
	\ifnum\theMclef=1
	\addtocounter{Maux}{-2}
	\fi\ifnum\theMclef=2
	\addtocounter{Maux}{0}
	\fi\ifnum\theMclef=3
	\addtocounter{Maux}{3}
