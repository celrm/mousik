\newcommand{\Minim}[1]{
	\HollowHead{#1}
	\ifnum#1<6\else
		\@Mswap
	\fi
	\pgfmathsetmacro\@Sstem{\@Mstem+0.1}
	\@Menlarge[\@Sstem]{#1}{#1}
	
\pgfmathsetmacro\@MHigh{int(\ifnoMswap 1 \else -1 \fi * 10*\@Sstem + #1*0.0625*10)}
\setcounter{@Mheight}{\@MHigh}
}
\newcommand{\Crotchet}[1]{
	\Head{#1}
	\ifnum#1<6\else
		\@Mswap
	\fi
