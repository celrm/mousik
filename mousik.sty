		\pgfmathsetmacro\Sstem{\Mstem+0.05}
		\foreach\INDd in {#1} {
			\ifthenelse{\equal{\INDd}{!}}{\addtocounter{MX}{\XM/4}}{
			\addtocounter{MX}{\XM/2}
			\MStringz{\INDd}{=}{\Beam[-0.275+\theMX]{-0.247+\theMX}{\theMevaluate}{\theMevaluate}{+\Sstem}}
			\MStringz{\INDd}{=|}{\Beam[-0.275+\theMX]{-0.5+\theMX}{\theMevaluate}{\theMevaluate}{+\Sstem}}
			\MStringz{\INDd}{|=}{\Beam[\theMX]{-0.247+\theMX}{\theMevaluate}{\theMevaluate}{+\Sstem}}
			\MStringz{\INDd}{//}{\Beam[-0.275+\theMX]{-0.247+\theMX}{\theMevaluate}{\theMevaluate}{+\Sstem}}
			\MStringz{\INDd}{//|}{\Beam[-0.275+\theMX]{-0.5+\theMX}{\theMevaluate}{\theMevaluate}{+\Sstem}}
			\MStringz{\INDd}{|//}{\Beam[\theMX]{-0.247+\theMX}{\theMevaluate}{\theMevaluate}{+\Sstem}}
		}}
	
	\fi\ifnum\theMduration=32
		\pgfmathsetmacro\Sstem{\Mstem+0.3}
		\Beam{\theMaux}{\theMevaluate}{\theMevaluate}{+\Sstem}
		
		\setcounter{MX}{\theMaux}
		\setcounter{Mfirst}{-50}
		\pgfmathsetmacro\Sstem{\Mstem+0.15}
		\foreach\INDd in {#1} {
			\ifthenelse{\equal{\INDd}{!}}{\addtocounter{MX}{\XM/4}}{
			\addtocounter{MX}{\XM/2}
			\MStringz{\INDd}{=}{\Beam[-0.275+\theMX]{-0.247+\theMX}{\theMevaluate}{\theMevaluate}{+\Sstem}}
			\MStringz{\INDd}{=|}{\Beam[-0.275+\theMX]{-0.5+\theMX}{\theMevaluate}{\theMevaluate}{+\Sstem}}
			\MStringz{\INDd}{|=}{\Beam[\theMX]{-0.247+\theMX}{\theMevaluate}{\theMevaluate}{+\Sstem}}
			\MStringz{\INDd}{≡}
				{\Beam[-0.275+\theMX]{-0.247+\theMX}{\theMevaluate}{\theMevaluate}{+\Sstem}
				\Beam[-0.275+\theMX]{-0.247+\theMX}{\theMevaluate}{\theMevaluate}{+\Mstem}}
			\MStringz{\INDd}{≡|}
				{\Beam[-0.275+\theMX]{-0.5+\theMX}{\theMevaluate}{\theMevaluate}{+\Sstem}
				\Beam[-0.275+\theMX]{-0.5+\theMX}{\theMevaluate}{\theMevaluate}{+\Mstem}}
			\MStringz{\INDd}{|≡}
				{\Beam[\theMX]{-0.247+\theMX}{\theMevaluate}{\theMevaluate}{+\Sstem}
				\Beam[\theMX]{-0.247+\theMX}{\theMevaluate}{\theMevaluate}{+\Mstem}}
			%%%%%%%%%%%%%%%%%%%%%%%%%%55
			\MStringz{\INDd}{//}{\Beam[-0.275+\theMX]{-0.247+\theMX}{\theMevaluate}{\theMevaluate}{+\Sstem}}
			\MStringz{\INDd}{//|}{\Beam[-0.275+\theMX]{-0.5+\theMX}{\theMevaluate}{\theMevaluate}{+\Sstem}}
			\MStringz{\INDd}{|//}{\Beam[\theMX]{-0.247+\theMX}{\theMevaluate}{\theMevaluate}{+\Sstem}}
			\MStringz{\INDd}{///}
				{\Beam[-0.275+\theMX]{-0.247+\theMX}{\theMevaluate}{\theMevaluate}{+\Sstem}
				\Beam[-0.275+\theMX]{-0.247+\theMX}{\theMevaluate}{\theMevaluate}{+\Mstem}}
			\MStringz{\INDd}{///|}
				{\Beam[-0.275+\theMX]{-0.5+\theMX}{\theMevaluate}{\theMevaluate}{+\Sstem}
				\Beam[-0.275+\theMX]{-0.5+\theMX}{\theMevaluate}{\theMevaluate}{+\Mstem}}
			\MStringz{\INDd}{|///}
				{\Beam[\theMX]{-0.247+\theMX}{\theMevaluate}{\theMevaluate}{+\Sstem}
				\Beam[\theMX]{-0.247+\theMX}{\theMevaluate}{\theMevaluate}{+\Mstem}}
		}}
	\fi
}

