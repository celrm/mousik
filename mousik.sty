\newcommand{\M@KB}[2]{
	\setcounter{M@aux}{#1}
	\ifnum#2<0 \setcounter{M@max}{3} \else \setcounter{M@max}{5}\fi
	\addtocounter{M@aux}{-\theM@max}
	\pgfmathparse{int(2.74545*\theM@clef-5.01818)}
	\addtocounter{M@aux}{\pgfmathresult}
	\M@odulo{\theM@aux}{7}
	\setcounter{M@aux}{\theM@modulo}
	\addtocounter{M@aux}{\theM@max}
}

\newcommand{\M@WalkKeyOrder}[3]{% #1 order, #2 absolute key size, #3 kept accidentals
    \foreach\IND [count=\INDi] in {#1} {%
        \ifnum\INDi>#2 \else
            \ifnum\INDi>#3
                \M@KB{\IND}{\M@KeySign}%
                \M@Acc[-0.01*\theM@min]{\M@KeyAccType}{\theM@aux}%
            \fi
            \addtocounter{M@min}{\M@result}%
        \fi
    }%
}

\newcommand{\M@WalkKeySignature}[3]{% #1 signed key, #2 kept accidentals, #3 naturals (0/1)
    \ifnum#1=0 \else
        \pgfmathtruncatemacro{\M@KeyAbs}{abs(#1)}%
        \pgfmathparse{int(10*(abs(#1)-1)^(1/2)+20)}\setcounter{M@min}{\pgfmathresult}%
        \pgfmathsetmacro{\M@result}{int(abs(#1)*2-23)}%
        \ifnum#1>0
            \def\M@KeySign{1}%
            \ifnum#3=1 \def\M@KeyAccType{0}\else \def\M@KeyAccType{1}\fi
            \M@WalkKeyOrder{10,7,11,8,5,9,6}{\M@KeyAbs}{#2}%
        \else
            \def\M@KeySign{-1}%
            \ifnum#3=1 \def\M@KeyAccType{0}\else \def\M@KeyAccType{-1}\fi
            \M@WalkKeyOrder{6,9,5,8,4,7,3}{\M@KeyAbs}{#2}%
        \fi
    \fi
}

\newcommand{\M@DrawKey}[1]{\M@WalkKeySignature{#1}{0}{0}}
\newcommand{\M@DrawNoKey}[1]{\M@WalkKeySignature{#1}{0}{1}}
\newcommand{\M@DrawKeyCancellation}[2]{\M@WalkKeySignature{#1}{#2}{1}}

