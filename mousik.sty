% Notes : bits

\newcommand{\Head}[1]{
	\M@EqStr{.}{\M@head}{\RoundHead{#1}}
	\M@EqStr{o}{\M@head}{\HollowHead{#1}}
	\M@EqStr{x}{\M@head}{\CrossHead{#1}}}

\newcommand{\RoundHead}[1]{
	\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
	\ifMnoteBack
		\node [opacity=0.0] (tmp) at (\M@realX-0.265,-\theMY*\M@vsep-0.2+#1*0.1) {};
		\fill[black,rotate around={16:(tmp.center)}] (\M@realX-0.01-0.265,-\theMY*\M@vsep-0.195+#1*0.1) ellipse (4pt and 2.75pt);
	\else 
		\node [opacity=0.0] (tmp) at (\M@realX,-\theMY*\M@vsep-0.2+#1*0.1) {};
		\fill[black,rotate around={16:(tmp.center)}] (\M@realX-0.01,-\theMY*\M@vsep-0.195+#1*0.1) ellipse (4pt and 2.75pt);
	\fi
}

\newcommand{\HollowHead}[1]{
	\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
	\RoundHead{#1}
	\ifMnoteBack
		\fill[\M@color,rotate around={19:(tmp.center)}] (\M@realX-0.01-0.265,-\theMY*\M@vsep-0.195+#1*0.1) ellipse (3.2pt and 1.35pt);
	\else 
		\fill[\M@color,rotate around={19:(tmp.center)}] (\M@realX-0.01,-\theMY*\M@vsep-0.195+#1*0.1) ellipse (3.2pt and 1.35pt);
	\fi
}

\newcommand{\CrossHead}[1]{
	\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
	\ifMnoteBack
		\draw (\M@realX -0.125-0.265,-\theMY*\M@vsep+#1*0.1 -0.1) --
		(\M@realX +0.1-0.265,-\theMY*\M@vsep+#1*0.1 -0.3);
		\draw (\M@realX +0.1-0.265,-\theMY*\M@vsep+#1*0.1 -0.1) --
		(\M@realX -0.125-0.265,-\theMY*\M@vsep+#1*0.1 -0.3);
	\else 
		\draw (\M@realX -0.125,-\theMY*\M@vsep+#1*0.1 -0.1) --
		(\M@realX +0.1,-\theMY*\M@vsep+#1*0.1 -0.3);
		\draw (\M@realX +0.1,-\theMY*\M@vsep+#1*0.1 -0.1) --
		(\M@realX -0.125,-\theMY*\M@vsep+#1*0.1 -0.3);
	\fi
}

\newcommand{\M@enlarge}[3][\M@stem]{
	\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
	\ifnoMswap
		\draw[line width=0.25mm]  (\M@realX+0.115,-\theMY*\M@vsep+#2*0.1-0.2) --
			(\M@realX+0.115,-\theMY*\M@vsep+#3*0.1+#1-0.2);
		
	\else
		\draw[line width=0.25mm]  (\M@realX-0.14,-\theMY*\M@vsep+#2*0.1-0.2) --
			(\M@realX-0.14,-\theMY*\M@vsep+#3*0.1-0.4-#1+0.2);
	\fi
}

\newcommand{\Ledger}[1]{
	\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
	\ifnum1>#1
	\foreach\INDi in {0,...,#1} {
		\ifthenelse{\isodd{\INDi}}{}%
		{\draw (\M@realX-0.25,-\theMY*\M@vsep-0.2+\INDi*0.1) --
		(\M@realX+0.25,-\theMY*\M@vsep-0.2+\INDi*0.1);}
	}
	\fi\ifnum11<#1
	\foreach\INDi in {12,...,#1} {
		\ifthenelse{\isodd{\INDi}}{}%
		{\draw (\M@realX-0.25,-\theMY*\M@vsep-0.2+\INDi*0.1) --
		(\M@realX+0.25,-\theMY*\M@vsep-0.2+\INDi*0.1);}
	}
	\fi
}

\newcommand{\Be@m}[5][\theMX]{
  \pgfmathsetmacro{\M@BeamLeftX}{(#2)*0.0625}%
  \pgfmathsetmacro{\M@BeamRightX}{((#1)-\M@hsep)*0.0625}%
  \pgfmathsetmacro{\M@BeamLeftY}{-\theMY*\M@vsep-0.2+(#3)*0.1}%
  \pgfmathsetmacro{\M@BeamRightY}{-\theMY*\M@vsep-0.2+(#4)*0.1}%
  \pgfmathsetmacro{\M@BeamOffset}{#5}%
  \ifnoMswap
    \draw[line width=\M@beam mm]
      (\M@BeamLeftX+0.103,\M@BeamLeftY+\M@BeamOffset) --
      (\M@BeamRightX+0.128,\M@BeamRightY+\M@BeamOffset);
  \else
    \draw[line width=\M@beam mm]
      (\M@BeamLeftX-0.153,\M@BeamLeftY-\M@BeamOffset) --
      (\M@BeamRightX-0.125,\M@BeamRightY-\M@BeamOffset);
  \fi
}

\newcommand{\M@SetBeamStem}[1]{%
    \ifnum#1<16
        \pgfmathsetmacro\M@Sstem{\M@stem+0.1}%
    \else\ifnum#1=16
        \pgfmathsetmacro\M@Sstem{\M@stem+0.2}%
    \else\ifnum#1=32
        \pgfmathsetmacro\M@Sstem{\M@stem+0.3}%
    \fi\fi\fi
}

\newcommand{\M@DrawBeamLevels}[5][\theMX]{% #1 right cursor, #2 duration, #3 left cursor, #4/#5 endpoint heights
    \M@SetBeamStem{#2}%
    \Be@m[#1]{#3}{#4}{#5}{+\M@Sstem}%
    \ifnum#2=16
        \pgfmathsetmacro\M@Sstem{\M@stem+0.05}%
        \Be@m[#1]{#3}{#4}{#5}{+\M@Sstem}%
    \fi
    \ifnum#2=32
        \pgfmathsetmacro\M@Sstem{\M@stem+0.15}%
        \Be@m[#1]{#3}{#4}{#5}{+\M@Sstem}%
        \Be@m[#1]{#3}{#4}{#5}{+\M@stem}%
    \fi
}

\newcommand{\Fl@g}[2][0]{
	\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
	\ifnoMswap
	\begin{scope}
		\clip (\M@realX+0.13,-\theMY*\M@vsep+#2*0.1-0.95+#1) rectangle (\M@realX+0.35,-\theMY*\M@vsep+#2*0.1-0.15+#1);
		\node at (\M@realX+0.05,-\theMY*\M@vsep-0.5+#2*0.1+#1) {\resizebox{0.55cm}{0.65cm}{\Acht}};
	\end{scope}
	\fill[\M@color] (\M@realX+0.205,-\theMY*\M@vsep-0.508+#2*0.1+#1) circle (1.75pt);
	\else
	\begin{scope}
		\node [opacity=0.0] (tmp) at (\M@realX,-\theMY*\M@vsep+0.2+#2*0.1) {};
		\clip (\M@realX-0.125,-\theMY*\M@vsep+#2*0.1-0.25-#1) rectangle (\M@realX+0.09,-\theMY*\M@vsep+#2*0.1+0.35-#1);
		\node[rotate around={180:(tmp.center)}] at (\M@realX+0.175,-\theMY*\M@vsep+0.265+#2*0.1+#1) {\reflectbox{\resizebox{0.55cm}{0.65cm}{\Acht}}};
	\end{scope}
	\fill[\M@color] (\M@realX-0.035,-\theMY*\M@vsep+0.139+#2*0.1-#1) circle (2pt);
	\fi
}

\newcommand{\Semibreve}[1]{
	\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
	\ifMnoteBack
		\node at (\M@realX-0.265,-\theMY*\M@vsep-0.2+#1*0.1) {\resizebox{0.3cm}{0.2cm}{\Ganz}};
	\else
		\node at (\M@realX,-\theMY*\M@vsep-0.2+#1*0.1) {\resizebox{0.3cm}{0.2cm}{\Ganz}};
	\fi
}

\newcommand{\M@commonStem}[1]{
	\ifnum#1>5 \Swap \fi
	\M@enlarge[\M@Sstem]{#1}{#1}	
	\ifnoMswap \pgfmathparse{1} \else \pgfmathparse{-1} \fi
	\pgfmathsetmacro\M@High{int(#1 + \pgfmathresult * 10*\M@Sstem)}
	\setcounter{M@height}{\M@High}
}

\newcommand{\Minim}[1]{
	\HollowHead{#1}
	\pgfmathsetmacro\M@Sstem{\M@stem+0.1}
	\M@commonStem{#1}
}

\newcommand{\Crotchet}[1]{
	\Head{#1}
	\pgfmathsetmacro\M@Sstem{\M@stem+0.1}
	\M@commonStem{#1}
}

\newcommand{\M@SetUnbeamedStem}[1]{%
	\ifnum#1<8
		\pgfmathsetmacro\M@Sstem{\M@stem+0.1}%
	\else\ifnum#1=8
		\pgfmathsetmacro\M@Sstem{\M@stem+0.2}%
	\else\ifnum#1=16
		\pgfmathsetmacro\M@Sstem{\M@stem+0.3}%
	\else\ifnum#1=32
		\pgfmathsetmacro\M@Sstem{\M@stem+0.4}%
	\fi\fi\fi\fi
}

\newcommand{\M@DrawFlags}[2]{% #1 duration, #2 stem base
	\ifnum#1=8
		\Fl@g[\M@Sstem]{#2}%
	\fi
	\ifnum#1=16
		\Fl@g[\M@Sstem]{#2}%
		\pgfmathsetmacro\M@Sstem{\M@stem+0.15}%
		\Fl@g[\M@Sstem]{#2}%
	\fi
	\ifnum#1=32
		\Fl@g[\M@Sstem]{#2}%
		\pgfmathsetmacro\M@Sstem{\M@stem+0.25}%
		\Fl@g[\M@Sstem]{#2}%
		\pgfmathsetmacro\M@Sstem{\M@stem+0.1}%
		\Fl@g[\M@Sstem]{#2}%
	\fi
}

\newcommand{\M@FlaggedNote}[2]{% #1 duration, #2 height
	\Head{#2}%
	\M@SetUnbeamedStem{#1}%
	\M@commonStem{#2}%
	\M@DrawFlags{#1}{#2}%
}

\newcommand{\Quaver}[1]{\M@FlaggedNote{8}{#1}}
\newcommand{\Semiquaver}[1]{\M@FlaggedNote{16}{#1}}
\newcommand{\Demisemiquaver}[1]{\M@FlaggedNote{32}{#1}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Chords

\newif\ifM@ChordLeft
\newcommand{\M@IfChord}[3]{%
    \def\M@ChordYes{#2}%
    \def\M@ChordNo{#3}%
    \expandafter\M@IfChordAux#1/\@nil
}
\def\M@IfChordAux#1/#2\@nil{%
    \def\M@ChordTail{#2}%
    \ifx\M@ChordTail\@empty
        \M@ChordNo
    \else
        \M@ChordYes
    \fi
}

\def\M@ParseChordHead#1{\expandafter\M@ParseChordHeadAux#1\@nil}
\def\M@ParseChordHeadAux#1#2\@nil{%
    \M@ChordLeftfalse
    \def\M@ChordFirst{#1}%
    \def\M@ChordLeftToken{<}%
    \ifx\M@ChordFirst\M@ChordLeftToken
        \def\M@ChordHeight{#2}%
        \M@ChordLefttrue
    \else
        \def\M@ChordHeight{#1#2}%
    \fi
}

\def\M@ChordStop{\relax}
\def\M@ChordLoop#1/{%
    \def\M@ChordPart{#1}%
    \ifx\M@ChordPart\M@ChordStop
        \let\M@ChordNext\relax
    \else
        \M@ChordAction{#1}%
        \let\M@ChordNext\M@ChordLoop
    \fi
    \M@ChordNext
}
\newcommand{\M@ChordForEach}[1]{%
    \expandafter\M@ChordLoop#1/\relax/
}

\newcommand{\M@ChordScanHead}[1]{%
    \M@ParseChordHead{#1}%
    \M@ax{\M@ChordHeight}%
    \M@in{\M@ChordHeight}%
    \ifnum\theM@first=-50 \setcounter{M@first}{\M@ChordHeight}\fi
}

\newcommand{\M@ChordDrawHead}[2]{% #1 duration, #2 head specification
    \M@ParseChordHead{#2}%
    \begingroup
        \ifM@ChordLeft \MnoteBacktrue\fi
        \ifnum#1=1
            \Semibreve{\M@ChordHeight}%
        \else\ifnum#1=2
            \HollowHead{\M@ChordHeight}%
        \else
            \Head{\M@ChordHeight}%
        \fi\fi
    \endgroup
}

\newcommand{\M@ChordLedgerHead}[1]{%
    \M@ParseChordHead{#1}%
    \ifM@ChordLeft
        \begin{scope}[xshift=-0.265cm]\Ledger{\M@ChordHeight}\end{scope}%
    \else
        \Ledger{\M@ChordHeight}%
    \fi
}

\newcommand{\M@Chord}[2]{% #1 duration, #2 slash-separated chord heads
    \setcounter{M@first}{-50}%
    \setcounter{M@max}{-50}%
    \setcounter{M@min}{50}%
    \let\M@ChordAction\M@ChordScanHead
    \M@ChordForEach{#2}%

    \def\M@ChordAction##1{\M@ChordDrawHead{#1}{##1}}%
    \M@ChordForEach{#2}%

    \ifnum#1=1\relax
    \else
        \ifnum\theM@max<6\else\Swap\fi

        \M@SetUnbeamedStem{#1}%

        \ifnoMswap
            \M@enlarge[\M@Sstem]{\theM@min}{\theM@max}%
            \pgfmathsetmacro\M@ChordStemBase{\theM@max}%
            \pgfmathsetmacro\M@High{int(\theM@max + 10*\M@Sstem)}%
        \else
            \M@enlarge[\M@Sstem]{\theM@max}{\theM@min}%
            \pgfmathsetmacro\M@ChordStemBase{\theM@min}%
            \pgfmathsetmacro\M@High{int(\theM@min - 10*\M@Sstem)}%
        \fi
        \setcounter{M@height}{\M@High}%

        \M@DrawFlags{#1}{\M@ChordStemBase}%
    \fi
}

\newcommand{\M@SimpleColumn}[2]{% #1 duration, #2 one time-position
    \M@IfChord{#2}{%
        \M@Chord{#1}{#2}%
    }{%
        \ifnum#1=1 \Semibreve{#2}\else
        \ifnum#1=2 \Minim{#2}\else
        \ifnum#1=4 \Crotchet{#2}\else
        \ifnum#1=8 \Quaver{#2}\else
        \ifnum#1=16 \Semiquaver{#2}\else
        \ifnum#1=32 \Demisemiquaver{#2}\fi\fi\fi\fi\fi\fi
    }%
}

\newcommand{\M@LedgerColumn}[1]{%
    \M@IfChord{#1}{%
        \let\M@ChordAction\M@ChordLedgerHead
        \M@ChordForEach{#1}%
    }{\Ledger{#1}}%
}


\newcounter{M@columnMin}
\newcounter{M@columnMax}
\newcounter{M@beamFound}
\newcounter{M@beamFirstX}
\newcounter{M@beamLastX}
\newcounter{M@beamFirstH}
\newcounter{M@beamLastH}


\newcommand{\M@BeamColumnScanHead}[1]{%
    \M@ParseChordHead{#1}%
    \ifnum\M@ChordHeight<\theM@columnMin
        \setcounter{M@columnMin}{\M@ChordHeight}%
    \fi
    \ifnum\M@ChordHeight>\theM@columnMax
        \setcounter{M@columnMax}{\M@ChordHeight}%
    \fi
}

\newcommand{\M@BeamColumnBounds}[1]{%
    \setcounter{M@columnMin}{50}%
    \setcounter{M@columnMax}{-50}%
    \M@IfChord{#1}{%
        \let\M@ChordAction\M@BeamColumnScanHead
        \M@ChordForEach{#1}%
    }{%
        \setcounter{M@columnMin}{#1}%
        \setcounter{M@columnMax}{#1}%
    }%
}

\newcommand{\M@BeamDrawChordHead}[1]{%
    \M@ParseChordHead{#1}%
    \begingroup
        \ifM@ChordLeft \MnoteBacktrue\fi
        \Head{\M@ChordHeight}%
    \endgroup
}
\newcommand{\M@BeamDrawColumnHeads}[1]{%
    \M@IfChord{#1}{%
        \let\M@ChordAction\M@BeamDrawChordHead
        \M@ChordForEach{#1}%
    }{\Head{#1}}%
}

\newcommand{\M@BeamColumnAnchor}[1]{%
    \M@BeamColumnBounds{#1}%
    \ifnoMswap
        \pgfmathsetmacro{\M@columnAnchor}{\theM@columnMax}%
        \pgfmathsetmacro{\M@columnStemStart}{\theM@columnMin}%
    \else
        \pgfmathsetmacro{\M@columnAnchor}{\theM@columnMin}%
        \pgfmathsetmacro{\M@columnStemStart}{\theM@columnMax}%
    \fi
}

\newcommand{\M@BeamHeads}[1]{%
    \setcounter{M@max}{-50}%
    \setcounter{M@min}{50}%
    \setcounter{MX}{\theM@aux}%
    \foreach\IND in {#1} {%
        \ifthenelse{\equal{\IND}{!}}{\M@addhalfMX}{%
            \M@NotEmpty{\IND}{%
                \M@BeamColumnBounds{\IND}%
                \M@ax{\theM@columnMax}%
                \M@in{\theM@columnMin}%
                \M@BeamDrawColumnHeads{\IND}%
            }%
            \M@addMX
        }%
    }%
}

\newcommand{\M@ScanBeamEndpoints}[1]{%
    \setcounter{M@beamFound}{0}%
    \setcounter{MX}{\theM@aux}%
    \foreach\IND in {#1} {%
        \ifthenelse{\equal{\IND}{!}}{\M@addhalfMX}{%
            \M@NotEmpty{\IND}{%
                \M@BeamColumnAnchor{\IND}%
                \ifnum\theM@beamFound=0
                    \setcounter{M@beamFirstX}{\theMX}%
                    \setcounter{M@beamFirstH}{\M@columnAnchor}%
                    \setcounter{M@beamFound}{1}%
                \fi
                \setcounter{M@beamLastX}{\theMX}%
                \setcounter{M@beamLastH}{\M@columnAnchor}%
            }%
            \M@addMX
        }%
    }%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Notes : everything together

\newif\ifMnoteBack
\newif\ifM@sloped
\pgfkeys{
	/Mnote/.is family
	, /Mnote
	, default/.style = 
	{	beam = 1
		, sloped = false
		, stem = 5
		, head = .
		, swap = false
		, tuplet = 0
		, tuplet-bracket = false
		, tuplet-xshift = 0
		, tuplet-yshift = 0
		, xshift = 0
		, yshift = 0
	}
	, beam/.estore in=\M@beam
	, sloped/.is if=M@sloped
	, stem/.code={\pgfmathsetmacro{\M@stem}{(#1)/10}}
	, head/.estore in=\M@head
	, tuplet/.estore in=\M@tuplet
	, tuplet-bracket/.is if=M@tupletBracket
	, tuplet-xshift/.estore in=\M@tupletXshift
	, tuplet-yshift/.estore in=\M@tupletYshift
	, swap/.is if=Mswap
	, xshift/.estore in=\M@shiftX
	, yshift/.estore in=\MshiftY
}
\newcounter{M@duration}
\newcommand{\Note}[3][]{ % #1 = options, #2 = duration, #3 = note(s)
	\MnoteBackfalse % internal: displaced chord heads set this only in a local group
	\pgfkeys{/Mnote, default, #1}%
	\Adv \noMswaptrue
	\ifMswap \Swap \fi
	\setcounter{M@aux}{\theMX}	
\begin{scope}[xshift=\M@shiftX cm,yshift=\MshiftY cm]
	\M@Count{#2}\setcounter{M@duration}{\theM@count}
	\M@Count{#3}
\ifnum\theM@duration=1 % only one duration
	\ifnum#2=1 \foreach\IND in {#3} {\M@SimpleColumn{1}{\IND}\M@addMX} \else
	\ifnum#2=2 \foreach\IND in {#3} {\M@SimpleColumn{2}{\IND}\M@addMX} \else
	\ifnum#2=4 \foreach\IND in {#3} {\M@SimpleColumn{4}{\IND}\M@addMX} \else
	\ifnum\theM@count=1 % single note or chord (8 and above)
		\M@SimpleColumn{#2}{#3}
	\else \ifnum\theM@count=2 % two notes together
			\M@TwoNote{#2}{#3}
		\else \ifnum\theM@count>2 % more than two notes together
			\ifM@sloped
				\M@SlopedNote{#2}{#3}
			\else
				\M@FlatNote{#2}{#3}
			\fi
		\fi\fi\fi
	\fi\fi\fi
	
\else \M@MixedNote{#2}{#3} \fi % more than one duration

	\setcounter{MX}{\theM@aux}\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
	\foreach \IND in {#3} {
		\ifthenelse{\equal{\IND}{!}}{\M@addhalfMX}{
		\M@NotEmpty{\IND}{\M@LedgerColumn{\IND}}
		\M@addMX}
	}
	\M@addMX
	
	\ifthenelse{\equal{\M@tuplet}{0}}{}{\Tuplet[\M@tuplet]}
	\end{scope}
}

\newcommand{\M@NormalizeDurationToken}[1]{%
	\def\M@DurationToken{#1}%
	\M@EqStr{#1}{//}{\def\M@DurationToken{=}}%
	\M@EqStr{#1}{//|}{\def\M@DurationToken{=|}}%
	\M@EqStr{#1}{|//}{\def\M@DurationToken{|=}}%
	\M@EqStr{#1}{///}{\def\M@DurationToken{≡}}%
	\M@EqStr{#1}{///|}{\def\M@DurationToken{≡|}}%
	\M@EqStr{#1}{|///}{\def\M@DurationToken{|≡}}%
}

\newcommand{\M@MixedTokenInfo}[1]{%
	\M@NormalizeDurationToken{#1}%
	\def\M@mixDur{0}%
	\def\M@mixStartTwo{0}%
	\def\M@mixEndTwo{0}%
	\def\M@mixStartThree{0}%
	\def\M@mixEndThree{0}%
	\M@EqStr{\M@DurationToken}{-}{\def\M@mixDur{8}}%
	\M@EqStr{\M@DurationToken}{|-}{\def\M@mixDur{8}}%
	\M@EqStr{\M@DurationToken}{-|}{\def\M@mixDur{8}}%
	\M@EqStr{\M@DurationToken}{=}{\def\M@mixDur{16}}%
	\M@EqStr{\M@DurationToken}{|=}{\def\M@mixDur{16}\def\M@mixStartTwo{1}}%
	\M@EqStr{\M@DurationToken}{=|}{\def\M@mixDur{16}\def\M@mixEndTwo{1}}%
	\M@EqStr{\M@DurationToken}{≡}{\def\M@mixDur{32}}%
	\M@EqStr{\M@DurationToken}{|≡}{\def\M@mixDur{32}\def\M@mixStartThree{1}}%
	\M@EqStr{\M@DurationToken}{≡|}{\def\M@mixDur{32}\def\M@mixEndThree{1}}%
}

\newcommand{\M@DrawMixedConnection}[4]{% left cursor, right cursor, beam height, offset
	\pgfmathsetmacro{\M@BeamLeftX}{(#1)*0.0625}%
	\pgfmathsetmacro{\M@BeamRightX}{(#2)*0.0625}%
	\pgfmathsetmacro{\M@BeamY}{-\theMY*\M@vsep-0.2+(#3)*0.1}%
	\pgfmathsetmacro{\M@BeamOffset}{#4}%
	\ifnoMswap
		\draw[line width=\M@beam mm]
			(\M@BeamLeftX+0.103,\M@BeamY+\M@BeamOffset) --
			(\M@BeamRightX+0.128,\M@BeamY+\M@BeamOffset);%
	\else
		\draw[line width=\M@beam mm]
			(\M@BeamLeftX-0.153,\M@BeamY-\M@BeamOffset) --
			(\M@BeamRightX-0.125,\M@BeamY-\M@BeamOffset);%
	\fi
}

\newcommand{\M@DrawMixedHook}[4]{% left/right, cursor, beam height, offset
	\pgfmathsetmacro{\M@BeamX}{(#2)*0.0625}%
	\pgfmathsetmacro{\M@BeamHalf}{0.5*\M@hsep*0.0625}%
	\pgfmathsetmacro{\M@BeamY}{-\theMY*\M@vsep-0.2+(#3)*0.1}%
	\pgfmathsetmacro{\M@BeamOffset}{#4}%
	\def\M@HookSide{#1}%
	\def\M@HookRight{right}%
	\ifnoMswap
		\ifx\M@HookSide\M@HookRight
			\draw[line width=\M@beam mm]
				(\M@BeamX+0.103,\M@BeamY+\M@BeamOffset) --
				(\M@BeamX+\M@BeamHalf,\M@BeamY+\M@BeamOffset);%
		\else
			\draw[line width=\M@beam mm]
				(\M@BeamX-\M@BeamHalf,\M@BeamY+\M@BeamOffset) --
				(\M@BeamX+0.128,\M@BeamY+\M@BeamOffset);%
		\fi
	\else
		\ifx\M@HookSide\M@HookRight
			\draw[line width=\M@beam mm]
				(\M@BeamX-0.153,\M@BeamY-\M@BeamOffset) --
				(\M@BeamX+\M@BeamHalf,\M@BeamY-\M@BeamOffset);%
		\else
			\draw[line width=\M@beam mm]
				(\M@BeamX-\M@BeamHalf,\M@BeamY-\M@BeamOffset) --
				(\M@BeamX-0.125,\M@BeamY-\M@BeamOffset);%
		\fi
	\fi
}

\newcommand{\M@FinalizeMixedEvent}[2]{% right connection at levels 2 and 3
	\ifnum\M@mixPrevDur>15
		\ifnum\M@mixPrevLeftTwo=0 \ifnum#1=0
			\ifnum\M@mixPrevStartTwo=1
				\M@DrawMixedHook{right}{\M@mixPrevX}{\M@heightBeam}{\M@mixSecondOffset}%
			\else\ifnum\M@mixPrevEndTwo=1
				\M@DrawMixedHook{left}{\M@mixPrevX}{\M@heightBeam}{\M@mixSecondOffset}%
			\else\ifnum\M@mixPrevDur=32
				% For an isolated 32nd, the third-beam marker also chooses the
				% direction of the required second beamlet.
				\ifnum\M@mixPrevStartThree=1
					\M@DrawMixedHook{right}{\M@mixPrevX}{\M@heightBeam}{\M@mixSecondOffset}%
				\else\ifnum\M@mixPrevEndThree=1
					\M@DrawMixedHook{left}{\M@mixPrevX}{\M@heightBeam}{\M@mixSecondOffset}%
				\fi\fi
			\fi\fi\fi
		\fi\fi
	\fi
	\ifnum\M@mixPrevDur=32
		\ifnum\M@mixPrevLeftThree=0 \ifnum#2=0
			\ifnum\M@mixPrevStartThree=1
				\M@DrawMixedHook{right}{\M@mixPrevX}{\M@heightBeam}{\M@stem}%
			\else\ifnum\M@mixPrevEndThree=1
				\M@DrawMixedHook{left}{\M@mixPrevX}{\M@heightBeam}{\M@stem}%
			\fi\fi
		\fi\fi
	\fi
}

\newcommand{\M@DrawMixedBeamLevels}[1]{%
	\ifnum\theM@duration=16
		\pgfmathsetmacro{\M@mixSecondOffset}{\M@stem+0.05}%
	\else
		\pgfmathsetmacro{\M@mixSecondOffset}{\M@stem+0.15}%
	\fi
	\def\M@mixHavePrev{0}%
	\setcounter{MX}{\theM@aux}%
	\foreach\INDd in {#1} {%
		\M@MixedTokenInfo{\INDd}%
		\ifnum\M@mixDur>0
			\def\M@mixConnTwo{0}%
			\def\M@mixConnThree{0}%
			\ifnum\M@mixHavePrev=1
				\ifnum\M@mixPrevDur>15 \ifnum\M@mixDur>15
					\ifnum\M@mixPrevEndTwo=0 \ifnum\M@mixStartTwo=0
						\M@DrawMixedConnection{\M@mixPrevX}{\theMX}{\M@heightBeam}{\M@mixSecondOffset}%
						\def\M@mixConnTwo{1}%
					\fi\fi
				\fi\fi
				\ifnum\M@mixPrevDur=32 \ifnum\M@mixDur=32
					\ifnum\M@mixPrevEndThree=0 \ifnum\M@mixStartThree=0
						\M@DrawMixedConnection{\M@mixPrevX}{\theMX}{\M@heightBeam}{\M@stem}%
						\def\M@mixConnThree{1}%
					\fi\fi
				\fi\fi
				\M@FinalizeMixedEvent{\M@mixConnTwo}{\M@mixConnThree}%
			\fi
			\xdef\M@mixPrevDur{\M@mixDur}%
			\xdef\M@mixPrevX{\theMX}%
			\xdef\M@mixPrevStartTwo{\M@mixStartTwo}%
			\xdef\M@mixPrevEndTwo{\M@mixEndTwo}%
			\xdef\M@mixPrevStartThree{\M@mixStartThree}%
			\xdef\M@mixPrevEndThree{\M@mixEndThree}%
			\xdef\M@mixPrevLeftTwo{\M@mixConnTwo}%
			\xdef\M@mixPrevLeftThree{\M@mixConnThree}%
			\xdef\M@mixHavePrev{1}%
		\fi
		\ifthenelse{\equal{\INDd}{!}}{\M@addhalfMX}{\M@addMX}%
	}%
	\ifnum\M@mixHavePrev=1
		\M@FinalizeMixedEvent{0}{0}%
	\fi
}

\newcommand{\M@MixedNote}[2]{
	\setcounter{M@duration}{8}
	\foreach\INDd in {#1} {
		\M@NormalizeDurationToken{\INDd}%
		\ifnum\theM@duration<16
			\M@EqStr{\M@DurationToken}{=}{\setcounter{M@duration}{16}}
			\M@EqStr{\M@DurationToken}{=|}{\setcounter{M@duration}{16}}
			\M@EqStr{\M@DurationToken}{|=}{\setcounter{M@duration}{16}}
		\fi
		\ifnum\theM@duration<32
			\M@EqStr{\M@DurationToken}{≡}{\setcounter{M@duration}{32}}
			\M@EqStr{\M@DurationToken}{≡|}{\setcounter{M@duration}{32}}
			\M@EqStr{\M@DurationToken}{|≡}{\setcounter{M@duration}{32}}
		\fi
	}
	
	\M@BeamHeads{#2}
	\ifnum\theM@max<6
		\ifnoMswap \pgfmathsetmacro{\M@heightBeam}{\theM@max}
		\else \pgfmathsetmacro{\M@heightBeam}{\theM@min} \fi
	\else 
		\Swap
		\ifnoMswap \pgfmathsetmacro{\M@heightBeam}{\theM@min}
		\else \pgfmathsetmacro{\M@heightBeam}{\theM@max} \fi
	\fi
	
	\setcounter{MX}{\theM@aux}
	\M@SetBeamStem{\theM@duration}%
	\foreach\IND in {#2} {
		\ifthenelse{\equal{\IND}{!}}{\M@addhalfMX}{
		\M@NotEmpty{\IND}{%
			\M@BeamColumnAnchor{\IND}%
			\M@enlarge[\M@Sstem]{\M@columnStemStart}{\M@heightBeam}%
		}
		\M@addMX}
	}

\ifnoMswap {\pgfmathparse{1}} \else {\pgfmathparse{-1}} \fi
\pgfmathsetmacro\M@High{int(\M@heightBeam + \pgfmathresult * 10*\M@Sstem)}
\setcounter{M@height}{\M@High}
	\M@SetBeamStem{\theM@duration}%
	\Be@m{\theM@aux}{\M@heightBeam}{\M@heightBeam}{+\M@Sstem}
	\ifnum\theM@duration>8
		\M@DrawMixedBeamLevels{#1}%
	\fi
}
\newcommand{\M@TwoNote}[2]{
    \M@BeamHeads{#2}%

    \ifnum\theM@max<6
    \else
        \Swap
    \fi

    \M@ScanBeamEndpoints{#2}%
    \setcounter{MX}{\theM@aux}\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
    \M@SetBeamStem{#1}%
    \foreach\IND in {#2} {\ifthenelse{\equal{\IND}{!}}{\M@addhalfMX}{%
        \M@NotEmpty{\IND}{%
            \M@BeamColumnAnchor{\IND}%
            \M@enlarge[\M@Sstem]{\M@columnStemStart}{\M@columnAnchor}%
        }%
        \M@addMX}
    }

    \ifnoMswap
        \pgfmathparse{int(max(\theM@beamFirstH,\theM@beamLastH)+10*\M@Sstem)}%
    \else
        \pgfmathparse{int(min(\theM@beamFirstH,\theM@beamLastH)-10*\M@Sstem)}%
    \fi
    \setcounter{M@height}{\pgfmathresult}%

    \M@DrawBeamLevels[\theM@beamLastX+\M@hsep]{#1}{\theM@beamFirstX}{\theM@beamFirstH}{\theM@beamLastH}%
}

\newcommand{\M@SlopedNote}[2]{%
    \M@BeamHeads{#2}%

    \ifnum\theM@max<6
    \else
        \Swap
    \fi

    \M@ScanBeamEndpoints{#2}%
    \setcounter{MX}{\theM@aux}\pgfmathsetmacro{\M@realX}{\theMX*0.0625}%

    \M@SetBeamStem{#1}%

    \foreach\IND in {#2} {%
        \ifthenelse{\equal{\IND}{!}}{\M@addhalfMX}{%
            \M@NotEmpty{\IND}{%
                \M@BeamColumnAnchor{\IND}%
                \pgfmathsetmacro{\M@SlopeH}{%
                    \theM@beamFirstH +
                        (\theMX-\theM@beamFirstX)/(\theM@beamLastX-\theM@beamFirstX)*
                        (\theM@beamLastH-\theM@beamFirstH)}%
                \M@enlarge[\M@Sstem]{\M@columnStemStart}{\M@SlopeH}%
            }%
            \M@addMX
        }%
    }%

    \ifnoMswap
        \pgfmathparse{int(max(\theM@beamFirstH,\theM@beamLastH)+10*\M@Sstem)}%
    \else
        \pgfmathparse{int(min(\theM@beamFirstH,\theM@beamLastH)-10*\M@Sstem)}%
    \fi
    \setcounter{M@height}{\pgfmathresult}%

    \M@DrawBeamLevels[\theM@beamLastX+\M@hsep]{#1}{\theM@beamFirstX}{\theM@beamFirstH}{\theM@beamLastH}%
}

\newcommand{\M@FlatNote}[2]{
    \M@BeamHeads{#2}%

    \ifnum\theM@max<6
    \else
        \Swap
    \fi
    \ifnoMswap
        \pgfmathsetmacro{\M@heightBeam}{\theM@max}%
    \else
        \pgfmathsetmacro{\M@heightBeam}{\theM@min}%
    \fi

    \setcounter{MX}{\theM@aux}\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
    \M@SetBeamStem{#1}%
    \foreach\IND in {#2} {\ifthenelse{\equal{\IND}{!}}{\M@addhalfMX}{%
        \M@NotEmpty{\IND}{%
            \M@BeamColumnAnchor{\IND}%
            \M@enlarge[\M@Sstem]{\M@columnStemStart}{\M@heightBeam}%
        }%
        \M@addMX}
    }

    \ifnoMswap \pgfmathparse{1} \else \pgfmathparse{-1} \fi
    \pgfmathsetmacro\M@High{int(\M@heightBeam + \pgfmathresult * 10*\M@Sstem)}
    \setcounter{M@height}{\M@High}

    \M@DrawBeamLevels{#1}{\theM@aux}{\M@heightBeam}{\M@heightBeam}%
}

