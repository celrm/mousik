\newcounter{Mduration}
\newcommand{\Note}[3][]{
	\pgfkeys{/Mnote, default, #1}%
	\Adv\noswaptrue
	\setcounter{Maux}{\theMX}
	
	\begin{scope}[xshift=\MshiftX cm,yshift=\MshiftY cm]
	\MCount{#2}\setcounter{Mduration}{\theMcount}
	\MCount{#3}
\ifnum\theMduration=1
	\ifnum#2=1
		\foreach\IND in {#3} {\Semibreve{\IND}\addtocounter{MX}{\XM/2}}
	\else\ifnum#2=2
		\foreach\IND in {#3} {\Minim{\IND}\addtocounter{MX}{\XM/2}}
	\else\ifnum#2=4
		\foreach\IND in {#3} {\Crotchet{\IND}\addtocounter{MX}{\XM/2}}
	\else
		\ifnum\theMcount=1
			\ifnum#2=8 \Quaver{#3} \else
			\ifnum#2=16 \Semiquaver{#3} \else
			\ifnum#2=32 \Demisemiquaver{#3} \fi\fi\fi
		\else\ifnum\theMcount=2
			\MTwoNote{#2}{#3}
		\else\ifnum\theMcount>2
			\MFlatNote{#2}{#3}
		\fi\fi\fi
	\fi\fi\fi
	
\else%\MCount{#3}\ifnum\theMduration=\theMcount
	\MMixedNote{#2}{#3}
\fi%\fi

	\setcounter{MX}{\theMaux}
	\foreach \IND in {#3} {
		\ifthenelse{\equal{\IND}{!}}{\addtocounter{MX}{\XM/4}}{
		\MNEmpty{\IND}{\Ledger{\IND}}
		\addtocounter{MX}{\XM/2}}
	}
	\addtocounter{MX}{\XM/2}
	
	\ifswap\Mswap\fi
	\ifthenelse{\equal{\Mtuplet}{0}}{}{
		\Tuplet[\Mtuplet]
	}
	\swapfalse
	
	\end{scope}
}

\newcounter{MMdur}
\newcommand{\MMixedNote}[2]{
	\setcounter{Mduration}{8}
