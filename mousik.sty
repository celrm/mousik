%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcounter{Mevaluate}

\newcounter{Mmodulo}
\newcommand{\MModulo}[2]{
	\setcounter{Mmodulo}{#1}
	\loop
	\setcounter{Mevaluate}{#2}\addtocounter{Mevaluate}{-1}
	\ifnum\theMmodulo>\theMevaluate
		\addtocounter{Mmodulo}{-#2}
		\repeat
	\ifnum\theMmodulo<0
		\addtocounter{Mmodulo}{#2}
		\repeat
}

\newcounter{Mmax}
\newcommand{\MMax}[2][\theMmax]{
	\setcounter{Mmax}{#1}
	\ifnum#2>#1
	\setcounter{Mmax}{#2}
	\fi
}

\newcounter{Mmin}
\newcommand{\MMin}[2][\theMmin]{
	\setcounter{Mmin}{#1}
	\ifnum#2<#1
	\setcounter{Mmin}{#2}
	\fi
}

