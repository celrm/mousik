	\newcommand{\AboveDec}[1]{%
		\ifnum#1<10
		\resizebox{0.3cm}{0.35cm}{#1}
		\else
		\resizebox{0.6cm}{0.35cm}{#1}
		\fi
	}
	\newcommand{\TimeS}[3][0]{
		\Adv
		\ifnum#1=0
		\node at (\thexpos*0.5,-\theypos*2+0.6) {\bf \AboveDec{#2}};
		\node at (\thexpos*0.5,-\theypos*2+0.2) {\bf \AboveDec{#3}};
		\else\ifnum#1=1
		\node at (\thexpos*0.5,-\theypos*2+0.5) {\meterC};
		\else
		\node at (\thexpos*0.5,-\theypos*2+0.575) {\allabreve};
		\fi\fi
		\addtocounter{xpos}{2}
	}

	\newcommand{\Note}[2]{
		\Adv
		%
		\ifnum#1=1
			\node at (\thexpos*0.5,-\theypos*2-0.2+#2*0.1) {\resizebox{0.3cm}{0.2cm}{\Ganz}};
		\else\ifnum#1=2
			\node at (\thexpos*0.5,-\theypos*2-0.2+#2*0.1) {\resizebox{0.3cm}{0.2cm}{\Halb}};
		\else\ifnum#1=4
			\node at (\thexpos*0.5,-\theypos*2-0.2+#2*0.1) {\resizebox{0.3cm}{0.21cm}{\Vier}};
		\else\ifnum#1=8
			\node at (\thexpos*0.5,-\theypos*2+0.02+#2*0.1) {\resizebox{0.45cm}{0.65cm}{\Acht}};
		\else\ifnum#1=16
			\node at (\thexpos*0.5,-\theypos*2+0.02+#2*0.1) {\resizebox{0.45cm}{0.65cm}{\Sech}};
		\else\ifnum#1=32
			\node at (\thexpos*0.5,-\theypos*2+0.095+#2*0.1) {\resizebox{0.45cm}{0.8cm}{\Zwdr}};
		\fi\fi\fi\fi\fi\fi
		%
		\ifnum1>#2
		% si es menor igual a 0
		\foreach\i in {0,...,#2} {
			\ifthenelse{\isodd{\i}}{}
			{\draw (\thexpos*0.5-0.25,-\theypos*2-0.2+\i*0.1) -- (\thexpos*0.5+0.25,-\theypos*2-0.2+\i*0.1);}
		}
		\fi
		\ifnum11<#2
		% si es mayor igual a 12
		\foreach\i in {12,...,#2} {
			\ifthenelse{\isodd{\i}}{}
			{\draw (\thexpos*0.5-0.25,-\theypos*2-0.2+\i*0.1) -- (\thexpos*0.5+0.25,-\theypos*2-0.2+\i*0.1);}
		}
		\fi
		\addtocounter{xpos}{2}
	}
	
	
