		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
	\fi\ifnum#1=15
		\node at (\theMX*0.5+0.1,-\theMY*2+1.2)
		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
	\fi\ifnum#1=0
		\draw[line width=1.5mm] (\theMX*0.5,-\theMY*2+0.2) -- (\theMX*0.5,-\theMY*2+0.6);
		\draw[line width=1.5mm] (\theMX*0.5+0.3,-\theMY*2+0.2) -- (\theMX*0.5+0.3,-\theMY*2+0.6);
	\fi
