\newcommand{\MStaff}{
	\foreach\i in {0,...,\theMypos} {
		\foreach\j in {0,...,4} {
			\ifnum\i=\theMypos
				\ifnum\i=0
					\draw (-0.25+\theMindent*0.5,-\i*2+\j*0.2) -- (\theMxpos*0.5,-\i*2+\j*0.2);
				\else
					\draw (-0.25,-\i*2+\j*0.2) -- (\theMxpos*0.5,-\i*2+\j*0.2);
				\fi
			\else\ifnum\i=0
				\draw (-0.25+\theMindent*0.5,-\i*2+\j*0.2) -- (11,-\i*2+\j*0.2);
				\else
				\draw (-0.25,-\i*2+\j*0.2) -- (11,-\i*2+\j*0.2);
			\fi\fi
		}
	}
}

