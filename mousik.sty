% The main environment

\newcounter{M@first}
\newcounter{MX}
\newcounter{MY}
\newcounter{M@clef}
\newcounter{M@key}

\pgfkeys{
	/mousik/.is family
	, /mousik
	, default/.style = 
	{	indent = 0
		, long = 100
		, color = white
		, hsep = 8
		, vsep = 2
		, tikz =
	}
	, indent/.estore in=\M@indent
	, long/.estore in=\M@long
	, color/.estore in=\M@color
	, hsep/.estore in=\M@hsep
	, vsep/.estore in=\M@vsep
	, tikz/.estore in=\M@TIKz
}

\newcommand{\Init}[1][]{%
\pgfkeys{/mousik, default, #1}%
\setcounter{MX}{0}\setcounter{MY}{0}%
\setcounter{M@clef}{-1}\setcounter{M@key}{0}}

\newenvironment{mousik}[1][]{%
\Init[#1]%
\noindent\begin{tikzpicture}[
	background rectangle/.style={fill=\M@color},
	show background rectangle,\M@TIKz]
\Space[\M@indent]
}{\M@remMX\M@remMX
\M@Staff % paint the staff at the end
\setcounter{MX}{0}\setcounter{MY}{0}
\setcounter{M@clef}{-1}\setcounter{M@key}{0}
\end{tikzpicture}}

% Mswap is used to swap the stem of the note
\newif\ifMswap\Mswapfalse % the user defined
\newif\ifnoMswap\noMswapfalse % the internal
\newcommand{\Swap}{\ifnoMswap \noMswapfalse \else \noMswaptrue \fi}
\newcommand{\M@outMswap}{\ifMswap \Mswapfalse \else \Mswaptrue \fi} %todo not sure slurred

\newcommand{\M@Staff}{
\foreach\INDi in {0,...,\theMY} { % amount of score lines
	\pgfmathsetmacro{\M@XcoordOne}{ % beginning depends on indent
		\ifnum\INDi=0 {-0.25+\M@indent} \else {-0.25} \fi}
	\pgfmathsetmacro{\M@XcoordTwo}{ % end depends on last element
		\ifnum\INDi=\theMY {\theMX*0.0625} \else {\M@long*0.12} \fi}
	\foreach\INDj in {0,...,4} { % draw 5 staff lines
		\pgfmathsetmacro{\M@Ycoord}{-\INDi*\M@vsep+\INDj*0.2}
		\draw (\M@XcoordOne,\M@Ycoord) -- (\M@XcoordTwo,\M@Ycoord);
	}}
}

\newcommand{\Octave}[1]{ % where to place the clefs (hardcoded)
\ifnum#1=8
	\ifnum\theM@clef=1
	\node at (\M@realX+0.15,-\theMY*\M@vsep+0.95) {\scriptsize\bf 8};
	\fi\ifnum\theM@clef=2
	\node at (\M@realX+0.15,-\theMY*\M@vsep+1.1) {\scriptsize\bf 8};
	\fi\ifnum\theM@clef=3
	\node at (\M@realX+0.05,-\theMY*\M@vsep+0.7) {\scriptsize\bf 8};
	\fi\ifnum\theM@clef=4
	\node at (\M@realX+0.05,-\theMY*\M@vsep+0.95) {\scriptsize\bf 8};
	\fi\ifnum\theM@clef=11
	\node at (\M@realX+0.1,-\theMY*\M@vsep+0.6) {\scriptsize\bf 8};
	\fi\ifnum\theM@clef=12
	\node at (\M@realX+0.1,-\theMY*\M@vsep+0.8) {\scriptsize\bf 8};
	\fi\ifnum\theM@clef=13
	\node at (\M@realX+0.1,-\theMY*\M@vsep+1) {\scriptsize\bf 8};
	\fi\ifnum\theM@clef=14
	\node at (\M@realX+0.1,-\theMY*\M@vsep+1.2) {\scriptsize\bf 8};
	\fi\ifnum\theM@clef=15
	\node at (\M@realX+0.1,-\theMY*\M@vsep+1.4) {\scriptsize\bf 8};
	\fi
\fi\ifnum#1=-8
	\ifnum\theM@clef=1
	\node at (\M@realX+0.05,-\theMY*\M@vsep-0.6) {\scriptsize\bf 8};
	\fi\ifnum\theM@clef=2
	\node at (\M@realX+0.05,-\theMY*\M@vsep-0.4) {\scriptsize\bf 8};
	\fi\ifnum\theM@clef=3
	\node at (\M@realX+0.05,-\theMY*\M@vsep-0.2) {\scriptsize\bf 8};
	\fi\ifnum\theM@clef=4
	\node at (\M@realX+0.05,-\theMY*\M@vsep) {\scriptsize\bf 8};
	\fi\ifnum\theM@clef=11
	\node at (\M@realX+0.1,-\theMY*\M@vsep-0.6) {\scriptsize\bf 8};
	\fi\ifnum\theM@clef=12
	\node at (\M@realX+0.1,-\theMY*\M@vsep-0.4) {\scriptsize\bf 8};
	\fi\ifnum\theM@clef=13
	\node at (\M@realX+0.1,-\theMY*\M@vsep-0.2) {\scriptsize\bf 8};
	\fi\ifnum\theM@clef=14
	\node at (\M@realX+0.1,-\theMY*\M@vsep) {\scriptsize\bf 8};
	\fi\ifnum\theM@clef=15
	\node at (\M@realX+0.1,-\theMY*\M@vsep+0.2) {\scriptsize\bf 8};
	\fi
\fi
}

\pgfkeys{
	/MClef/.is family
	, /MClef
	, default/.style = 
	{	t = 2
		, octave = 0
		, xshift = 0
		, yshift = 0
	}
	, t/.estore in=\M@clefT
	, octave/.estore in=\M@clefOct
	, xshift/.estore in=\M@shiftX
	, yshift/.estore in=\MshiftY
}

\newcommand{\Clef}[1][]{
	\pgfkeys{/MClef, default, #1}%
	\setcounter{M@clef}{\M@clefT}
	\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
\begin{scope}[xshift=\M@shiftX cm,yshift=\MshiftY cm]
	
	\Octave{\M@clefOct}
	
	\ifnum\theM@clef=1
		\node at (\M@realX+0.1,-\theMY*\M@vsep+0.15)
		{\trebleclef};
	\fi\ifnum\theM@clef=2
		\node at (\M@realX+0.1,-\theMY*\M@vsep+0.35)
		{\trebleclef};
	\fi\ifnum\theM@clef=3
		\node at (\M@realX+0.1,-\theMY*\M@vsep+0.8)
		{{\resizebox{0.7cm}{0.8cm}{\bassclef}}};
	\fi\ifnum\theM@clef=4
		\node at (\M@realX+0.1,-\theMY*\M@vsep+1)
		{{\resizebox{0.7cm}{0.8cm}{\bassclef}}};
	\fi\ifnum\theM@clef=11
		\node at (\M@realX+0.1,-\theMY*\M@vsep+0.4)
		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
	\fi\ifnum\theM@clef=12
		\node at (\M@realX+0.1,-\theMY*\M@vsep+0.6)
		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
	\fi\ifnum\theM@clef=13
		\node at (\M@realX+0.1,-\theMY*\M@vsep+0.8)
		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
	\fi\ifnum\theM@clef=14
		\node at (\M@realX+0.1,-\theMY*\M@vsep+1)
		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
	\fi\ifnum\theM@clef=15
		\node at (\M@realX+0.1,-\theMY*\M@vsep+1.2)
		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
	\fi\ifnum\theM@clef=0
		\draw[line width=1.5mm] (\M@realX,-\theMY*\M@vsep+0.2) -- (\M@realX,-\theMY*\M@vsep+0.6);
		\draw[line width=1.5mm] (\M@realX+0.3,-\theMY*\M@vsep+0.2) -- (\M@realX+0.3,-\theMY*\M@vsep+0.6);
	\fi
\end{scope}
\M@addMX\M@addMX
}

\newlength{\M@Width}
\newlength{\M@Height}
\newcommand{\M@Resize}[1]{
	\settowidth{\M@Width}{#1}
	\settoheight{\M@Height}{#1}
	\resizebox{1.5\M@Width}{1.5\M@Height}{#1}
}

\pgfkeys{
	/MTimeSig/.is family
	, /MTimeSig
	, default/.style = 
	{	xshift = 0
		, yshift = 0
	}
	, xshift/.estore in=\M@shiftX
	, yshift/.estore in=\MshiftY
}

\newcommand{\TimeSig}[3][]{
	\pgfkeys{/MTimeSig, default, #1}%
	\Adv\M@remquarterMX % todo: check for other keys
\begin{scope}[xshift=\M@shiftX cm,yshift=\MshiftY cm]
	\normalsize
	\ifx&#3&
		\ifthenelse{\equal{#2}{C}}%
			{\node at (\M@realX-0.25,-\theMY*\M@vsep+0.5) {\meterC};}%
		{\ifthenelse{\equal{#2}{C|}}%
			{\node at (\M@realX-0.25,-\theMY*\M@vsep+0.575) {\allabreve};}%
		{\node at (\M@realX-0.25,-\theMY*\M@vsep+0.4) {\bf \M@Resize{#2}};}}
	\else
		\node at (\M@realX-0.25,-\theMY*\M@vsep+0.6) {\bf \M@Resize{#2}};
		\node at (\M@realX-0.25,-\theMY*\M@vsep+0.2) {\bf \M@Resize{#3}};
	\fi
\end{scope}
\M@addMX\M@addMX\M@addquarterMX
}

\newcommand{\M@Dot}[2][1]{
\foreach \IND in {1,...,#1}
	{\M@PlaceNR[+0.15*\IND]{#2}{\resizebox{0.1cm}{0.1cm}{$\bullet$}};}}

\pgfkeys{
	/MDot/.is family
	, /MDot
	, default/.style = 
	{	t = *
		, xshift = 0
		, yshift = 0
	}
	, t/.estore in=\MDotT
	, xshift/.estore in=\M@shiftX
	, yshift/.estore in=\MshiftY
}
\newcommand{\MDot}[2][]{
	\pgfkeys{/MDot, default, #1}%
	\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
	\begin{scope}[xshift=\M@shiftX cm,yshift=\MshiftY cm]
	\M@EqStr{\MDotT}{*}{\M@Dot[1]{#2}}
	\M@EqStr{\MDotT}{.}{\M@Dot[1]{#2}}
	\M@EqStr{\MDotT}{**}{\M@Dot[2]{#2}}
	\M@EqStr{\MDotT}{..}{\M@Dot[2]{#2}}
	\end{scope}
}

\pgfkeys{
	/MDots/.is family
	, /MDots
	, default/.style = 
	{	xshift = 0
		, yshift = 0
	}
	, xshift/.estore in=\M@shiftX
	, yshift/.estore in=\MshiftY
}

\newcounter{M@aux}
\newcommand{\MDots}[2][]{
	\pgfkeys{/MDots, default, #1}%
	\Adv
\begin{scope}[xshift=\M@shiftX cm,yshift=\MshiftY cm]
	\setcounter{M@aux}{\theMX}
	\foreach\INDp/\INDh in {#2} {
		\ifthenelse{\equal{\INDp}{!}}{\M@addhalfMX}{
		\M@NotEmpty{\INDp}{\MDot[t=\INDp]{\INDh}}
		\M@addMX
	}}
	\setcounter{MX}{\theM@aux}\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
\end{scope}
}

\newcounter{M@height}
\newcommand{\Tuplet}[1][]{
	\pgfmathsetmacro{\M@TupletMid}{int(\theMX-\theM@aux-\M@hsep*2)*0.0625*0.5}
	\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
	\pgfmathsetmacro{\M@evMin}{-\theMY*\M@vsep+\theM@min*0.1}
	\pgfmathsetmacro{\M@evMax}{-\theMY*\M@vsep+\theM@max*0.1}
	\ifnoMswap
		\ifnum\theM@max<6
			% \clip (\M@realX-0.4,-0.5+\M@evMin) rectangle (\M@realX+0.125,-0.15+\M@evMax#1);
			% \draw[line width=\M@beam mm] (\M@realX-0.411,-0.2+\M@evMin#1) -- (\M@realX+0.147,-0.2+\M@evMax#1);
		\node at (\theM@aux*0.0625 + \M@TupletMid, -\theMY*\M@vsep+\theM@height*0.1+0.3){a\ifthenelse{\equal{#1}{}}{\theM@count}{#1}};
		\else
			% \clip (\M@realX-0.4,-0.15+\M@evMax#1) rectangle (\M@realX+0.125,-0.5+0.05+\M@evMin);
			% \draw[line width=\M@beam mm] (\M@realX-0.411,-0.2+\M@evMax#1) -- (\M@realX+0.147,-0.2+\M@evMin#1);
		\node at (\theM@aux*0.0625 + \M@TupletMid, -\theMY*\M@vsep+\theM@height*0.1+0.3){b\ifthenelse{\equal{#1}{}}{\theM@count}{#1}};
		\fi
	\else
		\ifnum\theM@max<6
			% \clip (\M@realX-0.645,-0.25+\M@evMin-#1) rectangle (\M@realX-0.129,0.2+\M@evMax);
			% \draw[line width=\M@beam mm] (\M@realX-0.7,-0.18+\M@evMin-#1) -- (\M@realX-0.1,-0.18+\M@evMax-#1);
		\node at (\theM@aux*0.0625 + \M@TupletMid, -\theMY*\M@vsep+\theM@height*0.1-0.3){c\ifthenelse{\equal{#1}{}}{\theM@count}{#1}};
		\else
			% \clip (\M@realX-0.65,-0.25+\M@evMin-#1) rectangle (\M@realX-0.129,0.2+\M@evMax);
			% \draw[line width=\M@beam mm] (\M@realX-0.7,-0.18+\M@evMax-#1) -- (\M@realX-0.1,-0.18+\M@evMin-#1);
		\node at (\theM@aux*0.0625 + \M@TupletMid, -\theMY*\M@vsep+\theM@height*0.1-0.3){d\ifthenelse{\equal{#1}{}}{\theM@count}{#1}};
		\fi
	\fi
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Notes : bits

\newcommand{\Head}[1]{
	\M@EqStr{.}{\M@head}{\RoundHead{#1}}
	\M@EqStr{o}{\M@head}{\HollowHead{#1}}
	\M@EqStr{x}{\M@head}{\CrossHead{#1}}}

\newcommand{\RoundHead}[1]{
	\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
	\ifMnoteBack
		\node [opacity=0.0] (tmp) at (\M@realX-0.265,-\theMY*\M@vsep-0.2+#1*0.1) {};
		\fill[black,rotate around={16:(tmp.center)}] (\M@realX-0.01-0.265,-\theMY*\M@vsep-0.195+#1*0.1) ellipse (4pt and 2.75pt);
	\else 
		\node [opacity=0.0] (tmp) at (\M@realX,-\theMY*\M@vsep-0.2+#1*0.1) {};
		\fill[black,rotate around={16:(tmp.center)}] (\M@realX-0.01,-\theMY*\M@vsep-0.195+#1*0.1) ellipse (4pt and 2.75pt);
	\fi
}

\newcommand{\HollowHead}[1]{
	\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
	\RoundHead{#1}
	\ifMnoteBack
		\fill[\M@color,rotate around={19:(tmp.center)}] (\M@realX-0.01-0.265,-\theMY*\M@vsep-0.195+#1*0.1) ellipse (3.2pt and 1.35pt);
	\else 
		\fill[\M@color,rotate around={19:(tmp.center)}] (\M@realX-0.01,-\theMY*\M@vsep-0.195+#1*0.1) ellipse (3.2pt and 1.35pt);
	\fi
}

\newcommand{\CrossHead}[1]{
	\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
	\ifMnoteBack
		\draw (\M@realX -0.125-0.265,-\theMY*\M@vsep+#1*0.1 -0.1) --
		(\M@realX +0.1-0.265,-\theMY*\M@vsep+#1*0.1 -0.3);
		\draw (\M@realX +0.1-0.265,-\theMY*\M@vsep+#1*0.1 -0.1) --
		(\M@realX -0.125-0.265,-\theMY*\M@vsep+#1*0.1 -0.3);
	\else 
		\draw (\M@realX -0.125,-\theMY*\M@vsep+#1*0.1 -0.1) --
		(\M@realX +0.1,-\theMY*\M@vsep+#1*0.1 -0.3);
		\draw (\M@realX +0.1,-\theMY*\M@vsep+#1*0.1 -0.1) --
		(\M@realX -0.125,-\theMY*\M@vsep+#1*0.1 -0.3);
	\fi
}

\newcommand{\M@enlarge}[3][\M@stem]{
	\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
	\ifnoMswap
		\draw[line width=0.25mm]  (\M@realX+0.115,-\theMY*\M@vsep+#2*0.1-0.2) --
			(\M@realX+0.115,-\theMY*\M@vsep+#3*0.1+#1-0.2);
		
	\else
		\draw[line width=0.25mm]  (\M@realX-0.14,-\theMY*\M@vsep+#2*0.1-0.2) --
			(\M@realX-0.14,-\theMY*\M@vsep+#3*0.1-0.4-#1+0.2);
	\fi
}

\newcommand{\Ledger}[1]{
	\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
	\ifnum1>#1
	\foreach\INDi in {0,...,#1} {
		\ifthenelse{\isodd{\INDi}}{}%
		{\draw (\M@realX-0.25,-\theMY*\M@vsep-0.2+\INDi*0.1) --
		(\M@realX+0.25,-\theMY*\M@vsep-0.2+\INDi*0.1);}
	}
	\fi\ifnum11<#1
	\foreach\INDi in {12,...,#1} {
		\ifthenelse{\isodd{\INDi}}{}%
		{\draw (\M@realX-0.25,-\theMY*\M@vsep-0.2+\INDi*0.1) --
		(\M@realX+0.25,-\theMY*\M@vsep-0.2+\INDi*0.1);}
	}
	\fi
}

\newcommand{\Be@m}[5][\theMX]{
	\ifnoMswap
		\draw[line width=\M@beam mm] (#2*0.0625+0.103,-\theMY*\M@vsep-0.2+#3*0.1#5) -- (#1*0.0625-0.372,-\theMY*\M@vsep-0.2+#4*0.1#5);
	\else
		\draw[line width=\M@beam mm] (#2*0.0625-0.153,-\theMY*\M@vsep-0.2+#3*0.1-#5) -- (#1*0.0625-0.625,-\theMY*\M@vsep-0.2+#4*0.1-#5);
	\fi
}

\newcommand{\Be@mS}[1]{
	\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
	\pgfmathsetmacro{\M@evMin}{-\theMY*\M@vsep+\theM@min*0.1}
	\pgfmathsetmacro{\M@evMax}{-\theMY*\M@vsep+\theM@max*0.1}
	\begin{scope}
	\ifnoMswap
		\ifnum\theM@first=\theM@min
			\clip (\M@realX-0.4,-0.5+\M@evMin) rectangle (\M@realX+0.125,-0.15+\M@evMax#1);
			\draw[line width=\M@beam mm] (\M@realX-0.411,-0.2+\M@evMin#1) -- (\M@realX+0.147,-0.2+\M@evMax#1);
		\else
			\clip (\M@realX-0.4,-0.15+\M@evMax#1) rectangle (\M@realX+0.125,-0.5+0.05+\M@evMin);
			\draw[line width=\M@beam mm] (\M@realX-0.411,-0.2+\M@evMax#1) -- (\M@realX+0.147,-0.2+\M@evMin#1);
		\fi
	\else
		\ifnum\theM@first=\theM@min
			\clip (\M@realX-0.645,-0.25+\M@evMin-#1) rectangle (\M@realX-0.129,0.2+\M@evMax);
			\draw[line width=\M@beam mm] (\M@realX-0.7,-0.18+\M@evMin-#1) -- (\M@realX-0.1,-0.18+\M@evMax-#1);
		\else
			\clip (\M@realX-0.65,-0.25+\M@evMin-#1) rectangle (\M@realX-0.129,0.2+\M@evMax);
			\draw[line width=\M@beam mm] (\M@realX-0.7,-0.18+\M@evMax-#1) -- (\M@realX-0.1,-0.18+\M@evMin-#1);
		\fi
	\fi
	\end{scope}
}

\newcommand{\Fl@g}[2][0]{
	\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
	\ifnoMswap
	\begin{scope}
		\clip (\M@realX+0.13,-\theMY*\M@vsep+#2*0.1-0.95+#1) rectangle (\M@realX+0.35,-\theMY*\M@vsep+#2*0.1-0.15+#1);
		\node at (\M@realX+0.05,-\theMY*\M@vsep-0.5+#2*0.1+#1) {\resizebox{0.55cm}{0.65cm}{\Acht}};
	\end{scope}
	\fill[\M@color] (\M@realX+0.205,-\theMY*\M@vsep-0.508+#2*0.1+#1) circle (1.75pt);
	\else
	\begin{scope}
		\node [opacity=0.0] (tmp) at (\M@realX,-\theMY*\M@vsep+0.2+#2*0.1) {};
		\clip (\M@realX-0.125,-\theMY*\M@vsep+#2*0.1-0.25-#1) rectangle (\M@realX+0.09,-\theMY*\M@vsep+#2*0.1+0.35-#1);
		\node[rotate around={180:(tmp.center)}] at (\M@realX+0.175,-\theMY*\M@vsep+0.265+#2*0.1+#1) {\reflectbox{\resizebox{0.55cm}{0.65cm}{\Acht}}};
	\end{scope}
	\fill[\M@color] (\M@realX-0.035,-\theMY*\M@vsep+0.139+#2*0.1-#1) circle (2pt);
	\fi
}

\newcommand{\Semibreve}[1]{
	\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
	\ifMnoteBack
		\node at (\M@realX-0.265,-\theMY*\M@vsep-0.2+#1*0.1) {\resizebox{0.3cm}{0.2cm}{\Ganz}};
	\else
		\node at (\M@realX,-\theMY*\M@vsep-0.2+#1*0.1) {\resizebox{0.3cm}{0.2cm}{\Ganz}};
	\fi
}

\newcommand{\M@commonStem}[1]{
	\ifnum#1>5 \Swap \fi
	\M@enlarge[\M@Sstem]{#1}{#1}	
	\ifnoMswap \pgfmathparse{1} \else \pgfmathparse{-1} \fi
	\pgfmathsetmacro\M@High{int(\pgfmathresult * 10*\M@Sstem + #1*0.0625*10)}
	\setcounter{M@height}{\M@High}
}

\newcommand{\Minim}[1]{
	\HollowHead{#1}
	\pgfmathsetmacro\M@Sstem{\M@stem+0.1}
	\M@commonStem{#1}
}

\newcommand{\Crotchet}[1]{
	\Head{#1}
	\pgfmathsetmacro\M@Sstem{\M@stem+0.1}
	\M@commonStem{#1}
}

\newcommand{\Quaver}[1]{
	\Head{#1}
	\pgfmathsetmacro\M@Sstem{\M@stem+0.2}
	\M@commonStem{#1}
	\Fl@g[\M@Sstem]{#1}
}

\newcommand{\Semiquaver}[1]{
	\Head{#1}
	\pgfmathsetmacro\M@Sstem{\M@stem+0.3}
	\M@commonStem{#1}
	\Fl@g[\M@Sstem]{#1}
	\pgfmathsetmacro\M@Sstem{\M@stem+0.15}
	\Fl@g[\M@Sstem]{#1}
}

\newcommand{\Demisemiquaver}[1]{
	\Head{#1}
	\pgfmathsetmacro\M@Sstem{\M@stem+0.4}
	\M@commonStem{#1}
	\Fl@g[\M@Sstem]{#1}
	\pgfmathsetmacro\M@Sstem{\M@stem+0.25}
	\Fl@g[\M@Sstem]{#1}
	\pgfmathsetmacro\M@Sstem{\M@stem+0.1}
	\Fl@g[\M@Sstem]{#1}
}

\newcommand{\M@Heads}[1]{
	\setcounter{M@first}{-50}
	\setcounter{M@max}{-50}
	\setcounter{M@min}{50}
	\foreach\IND in {#1} {
		\ifthenelse{\equal{\IND}{!}}{\M@addhalfMX}{
		\M@NotEmpty{\IND}{
			\Head{\IND}
			\M@ax{\IND}\M@in{\IND} % max, min, first
			\ifnum\theM@first=-50 \setcounter{M@first}{\IND} \fi
		}
		\M@addMX
	}}
}

