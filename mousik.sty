		\fi
	}
	\else\ifnum#1<0
	
	\pgfmathsetmacro\result{int(10*(-#1-1)^(1/2)+20)}
	\setcounter{Mmin}{\result}
	
	\pgfmathsetmacro\result{int(-#1*2-23)}
	
	\foreach\IND [count=\INDi] in {6,9,5,8,4,7,3} {
