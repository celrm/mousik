\newcommand{\@Heads}[1]{
	\setcounter{@Mfirst}{-50}
	\setcounter{@max}{-50}
	\setcounter{@min}{50}
	\foreach\IND in {#1} {
		\ifthenelse{\equal{\IND}{!}}{\addtocounter{MX}{\Mhsep/4}}{
		\@NotEmpty{\IND}{
			\Head{\IND}
			\@Max{\IND}\@Min{\IND} % max, min, first
			\ifnum\the@Mfirst=-50\setcounter{@Mfirst}{\IND}\fi
		}
		\addtocounter{MX}{\Mhsep/2}
	}}
}

