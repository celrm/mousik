\newcounter{Mfirst}
\newcounter{MX}
\newcounter{MY}
\newcounter{Mclef}
\newcounter{Mkey}
\newcounter{Mindent}

\newcounter{Mlong}
\setcounter{Mlong}{24}

\newenvironment{mousik}[1][0]
{\setcounter{MX}{0}%
\setcounter{MY}{0}%
\setcounter{Mclef}{0}%
\setcounter{Mkey}{0}%
\setcounter{Mindent}{#1}%
\noindent\begin{tikzpicture}\Space[#1]}
{\addtocounter{MX}{-2}\MStaff
	\setcounter{MX}{0}
	\setcounter{MY}{0}
	\setcounter{Mclef}{0}
	\setcounter{Mkey}{0}
	\setcounter{Mindent}{0}
	\end{tikzpicture}}

\newif\ifswap\swapfalse
\newif\ifnoswap\noswaptrue

\newcommand{\Mswap}{
	\ifnoswap\noswapfalse
	\else\noswaptrue
	\fi
}
\newcommand{\Swap}{
	\ifswap\swapfalse
	\else\swaptrue
	\fi
}

\newcommand{\MStaff}{
	\foreach\INDi in {0,...,\theMY} {
		\foreach\INDj in {0,...,4} {
			\ifnum\INDi=\theMY
				\ifnum\INDi=0
					\draw (-0.25+\theMindent*0.5,-\INDi*2+\INDj*0.2)
					-- (\theMX*0.5,-\INDi*2+\INDj*0.2);
				\else
					\draw (-0.25,-\INDi*2+\INDj*0.2)
					-- (\theMX*0.5,-\INDi*2+\INDj*0.2);
				\fi
			\else\ifnum\INDi=0
				\draw (-0.25+\theMindent*0.5,-\INDi*2+\INDj*0.2)
				-- (\theMlong*0.5,-\INDi*2+\INDj*0.2);
				\else
				\draw (-0.25,-\INDi*2+\INDj*0.2)
				-- (\theMlong*0.5,-\INDi*2+\INDj*0.2);
			\fi\fi
		}
	}
}

