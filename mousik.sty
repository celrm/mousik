%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Tools

\newcounter{M@modulo}
\newcommand{\M@odulo}[2]{
	\setcounter{M@modulo}{#1}
	\pgfmathparse{int(#2-#1)}
	\loop
	\ifnum\theM@modulo>\pgfmathresult
		\addtocounter{M@modulo}{-#2}
	\repeat
	\ifnum\theM@modulo<0
		\addtocounter{M@modulo}{#2}
	\repeat
}

\newcounter{M@max}
\newcommand{\M@ax}[2][\theM@max]{
	\setcounter{M@max}{#1}
	\ifnum#2>#1
		\setcounter{M@max}{#2}
	\fi
}

\newcounter{M@min}
\newcommand{\M@in}[2][\theM@min]{
	\setcounter{M@min}{#1}
	\ifnum#2<#1
		\setcounter{M@min}{#2}
	\fi
}

\newcounter{M@count}
\newcommand{\M@Count}[1]{
	\setcounter{M@count}{0}
	\foreach\IND in {#1} {\ifthenelse{\equal{\IND}{!}}{}{\stepcounter{M@count}}}
}

\newcommand{\M@EqStr}[3]{\ifthenelse{\equal{#1}{#2}}{#3}{}}
\newcommand{\M@NotEmpty}[2]{\ifthenelse{\equal{#1}{}}{}{#2}}

\newcommand{\M@addMX}{\pgfmathparse{int(\M@hsep)}\addtocounter{MX}{\pgfmathresult}\pgfmathsetmacro{\M@realX}{\theMX*0.0625}}
\newcommand{\M@addhalfMX}{\pgfmathparse{int(\M@hsep/2)}\addtocounter{MX}{\pgfmathresult}\pgfmathsetmacro{\M@realX}{\theMX*0.0625}}
\newcommand{\M@addquarterMX}{\pgfmathparse{int(\M@hsep/4)}\addtocounter{MX}{\pgfmathresult}\pgfmathsetmacro{\M@realX}{\theMX*0.0625}}
\newcommand{\M@remMX}{\pgfmathparse{int(-\M@hsep)}\addtocounter{MX}{\pgfmathresult}\pgfmathsetmacro{\M@realX}{\theMX*0.0625}}
\newcommand{\M@remhalfMX}{\pgfmathparse{int(-\M@hsep/2)}\addtocounter{MX}{\pgfmathresult}\pgfmathsetmacro{\M@realX}{\theMX*0.0625}}
\newcommand{\M@remquarterMX}{\pgfmathparse{int(-\M@hsep/4)}\addtocounter{MX}{\pgfmathresult}\pgfmathsetmacro{\M@realX}{\theMX*0.0625}}

