\newcommand{\Clef}[1][]{
	\pgfkeys{/MClef, default, #1}%
	\setcounter{Mclef}{\@MclefT}
	\Adv
\begin{scope}[xshift=\@MshiftX cm,yshift=\MshiftY cm]
	
	\Octave{\@MclefOct}
	
	\ifnum\theMclef=1
		\node at (\theMX*0.0625+0.1,-\theMY*\MY+0.15)
		{\trebleclef};
	\fi\ifnum\theMclef=2
		\node at (\theMX*0.0625+0.1,-\theMY*\MY+0.35)
		{\trebleclef};
	\fi\ifnum\theMclef=3
		\node at (\theMX*0.0625+0.1,-\theMY*\MY+0.8)
		{{\resizebox{0.7cm}{0.8cm}{\bassclef}}};
	\fi\ifnum\theMclef=4
		\node at (\theMX*0.0625+0.1,-\theMY*\MY+1)
		{{\resizebox{0.7cm}{0.8cm}{\bassclef}}};
	\fi\ifnum\theMclef=11
		\node at (\theMX*0.0625+0.1,-\theMY*\MY+0.4)
		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
	\fi\ifnum\theMclef=12
		\node at (\theMX*0.0625+0.1,-\theMY*\MY+0.6)
		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
	\fi\ifnum\theMclef=13
		\node at (\theMX*0.0625+0.1,-\theMY*\MY+0.8)
		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
	\fi\ifnum\theMclef=14
		\node at (\theMX*0.0625+0.1,-\theMY*\MY+1)
		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
	\fi\ifnum\theMclef=15
		\node at (\theMX*0.0625+0.1,-\theMY*\MY+1.2)
		{{\resizebox{0.65cm}{0.8cm}{\altoclef}}};
	\fi\ifnum\theMclef=0
		\draw[line width=1.5mm] (\theMX*0.0625,-\theMY*\MY+0.2) -- (\theMX*0.0625,-\theMY*\MY+0.6);
		\draw[line width=1.5mm] (\theMX*0.0625+0.3,-\theMY*\MY+0.2) -- (\theMX*0.0625+0.3,-\theMY*\MY+0.6);
	\fi
\end{scope}
\pgfmathsetmacro{\@Clefsep}{int(\Mhsep*2)}
\addtocounter{MX}{\@Clefsep}
}

\newlength{\@MWidth}
\newlength{\@MHeight}
\newcommand{\@MResize}[1]{
	\settowidth{\@MWidth}{#1}
	\settoheight{\@MHeight}{#1}
	\resizebox{1.5\@MWidth}{1.5\@MHeight}{#1}
}
\pgfkeys{
	/MTimeSig/.is family
	, /MTimeSig
	, default/.style = 
	{	xshift = 0
		, yshift = 0
	}
	, xshift/.estore in=\@MshiftX
	, yshift/.estore in=\MshiftY
}
\newcommand{\TimeSig}[3][]{
	\pgfkeys{/MTimeSig, default, #1}%
	\Adv
	\begin{scope}[xshift=\@MshiftX cm,yshift=\MshiftY cm]
	\normalsize
	\ifx&#3&
		\ifthenelse{\equal{#2}{C}}%
			{\node at (\theMX*0.0625-0.25,-\theMY*\MY+0.5) {\meterC};}%
		{\ifthenelse{\equal{#2}{C|}}%
			{\node at (\theMX*0.0625-0.25,-\theMY*\MY+0.575) {\allabreve};}%
		{\node at (\theMX*0.0625-0.25,-\theMY*\MY+0.4) {\bf \@MResize{#2}};}%
		}
	\else
		\node at (\theMX*0.0625-0.25,-\theMY*\MY+0.6) {\bf \@MResize{#2}};
		\node at (\theMX*0.0625-0.25,-\theMY*\MY+0.2) {\bf \@MResize{#3}};
	\fi
	\end{scope}
\pgfmathsetmacro{\@Timesep}{int(\Mhsep*2)}
\addtocounter{MX}{\@Timesep}
}

\newcommand{\@Dot}[2][1]{
	\foreach \IND in {1,...,#1}
	{\@MPlaceNR[+0.15*\IND]{#2}{\resizebox{0.1cm}{0.1cm}{$\bullet$}};}
}

\pgfkeys{
	/MDot/.is family
	, /MDot
	, default/.style = 
	{	t = *
		, xshift = 0
		, yshift = 0
	}
	, t/.estore in=\MDotT
	, xshift/.estore in=\@MshiftX
	, yshift/.estore in=\MshiftY
}
\newcommand{\Dot}[2][]{
	\pgfkeys{/MDot, default, #1}%
	\begin{scope}[xshift=\@MshiftX cm,yshift=\MshiftY cm]
	\@EqStr{\MDotT}{*}{\@Dot[1]{#2}}
	\@EqStr{\MDotT}{.}{\@Dot[1]{#2}}
	\@EqStr{\MDotT}{**}{\@Dot[2]{#2}}
	\@EqStr{\MDotT}{..}{\@Dot[2]{#2}}
	\end{scope}
}

\pgfkeys{
	/MDots/.is family
	, /MDots
	, default/.style = 
	{	xshift = 0
		, yshift = 0
	}
	, xshift/.estore in=\@MshiftX
	, yshift/.estore in=\MshiftY
}
\newcommand{\Dots}[2][]{
	\pgfkeys{/MDots, default, #1}%
	\Adv
	\begin{scope}[xshift=\@MshiftX cm,yshift=\MshiftY cm]
	\setcounter{Maux}{\theMX}
	\foreach\INDp/\INDh in {#2} {
		\ifthenelse{\equal{\INDp}{!}}{\addtocounter{MX}{\Mhsep/4}}{
		\@NotEmpty{\INDp}{
			\Dot[t=\INDp]{\INDh}
		}
		\addtocounter{MX}{\Mhsep/2}
	}}
	\setcounter{MX}{\theMaux}
	\end{scope}
}

