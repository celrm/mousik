		{\draw (\theMX*0.0625,-\theMY*\MY+0.8) -- (\theMX*0.0625,-\theMY*\MY);}{}
	\ifthenelse{\equal{\@MBarT}{:}}%
		{\draw[dashed] (\theMX*0.0625,-\theMY*\MY+0.8) -- (\theMX*0.0625,-\theMY*\MY);}{}
	\ifthenelse{\equal{\@MBarT}{||}}%
		{\draw (\theMX*0.0625-0.06,-\theMY*\MY+0.8) -- (\theMX*0.0625-0.06,-\theMY*\MY);
		\draw (\theMX*0.0625+0.06,-\theMY*\MY+0.8) -- (\theMX*0.0625+0.06,-\theMY*\MY);}{}
	\ifthenelse{\equal{\@MBarT}{|.}}%
		{\draw (\theMX*0.0625-0.12,-\theMY*\MY+0.8) -- (\theMX*0.0625-0.12,-\theMY*\MY);
		\draw[line width=1mm] (\theMX*0.0625,-\theMY*\MY+0.807) -- (\theMX*0.0625,-\theMY*\MY-0.007);}{}
	\ifthenelse{\equal{\@MBarT}{:|}}%
		{\node at (\theMX*0.0625-0.24,0.4-\theMY*\MY) {\resizebox{0.175cm}{0.25cm}{:}};
		\draw (\theMX*0.0625-0.12,-\theMY*\MY+0.8) -- (\theMX*0.0625-0.12,-\theMY*\MY);
		\draw[line width=1mm] (\theMX*0.0625,-\theMY*\MY+0.807) -- (\theMX*0.0625,-\theMY*\MY-0.007);}{}
	\ifthenelse{\equal{\@MBarT}{|:}}%
		{\draw[line width=1mm] (\theMX*0.0625,-\theMY*\MY+0.807) -- (\theMX*0.0625,-\theMY*\MY-0.007);
		\node at (\theMX*0.0625+0.24,0.4-\theMY*\MY) {\resizebox{0.175cm}{0.25cm}{:}};
		\draw (\theMX*0.0625+0.12,-\theMY*\MY+0.8) -- (\theMX*0.0625+0.12,-\theMY*\MY);}{}
	\ifthenelse{\equal{\@MBarT}{:|:}}%
		{\node at (\theMX*0.0625-0.24,0.4-\theMY*\MY) {\resizebox{0.175cm}{0.25cm}{:}};
		\draw (\theMX*0.0625-0.12,-\theMY*\MY+0.8) -- (\theMX*0.0625-0.12,-\theMY*\MY);
		\draw[line width=1mm] (\theMX*0.0625,-\theMY*\MY+0.807) -- (\theMX*0.0625,-\theMY*\MY-0.007);
		\node at (\theMX*0.0625+0.24,0.4-\theMY*\MY) {\resizebox{0.175cm}{0.25cm}{:}};
		\draw (\theMX*0.0625+0.12,-\theMY*\MY+0.8) -- (\theMX*0.0625+0.12,-\theMY*\MY);}{}
	\end{scope}
\pgfmathsetmacro{\@Barsep}{int(\Mhsep*2)}
\addtocounter{MX}{\@Barsep}
}

