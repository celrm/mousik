\newcommand{\M@KB}[2]{
	\setcounter{M@aux}{#1}
	\ifnum#2<0 \setcounter{M@max}{3} \else \setcounter{M@max}{5}\fi
	\addtocounter{M@aux}{-\theM@max}
	\pgfmathparse{int(2.74545*\theM@clef-5.01818)}
	\addtocounter{M@aux}{\pgfmathresult}
	\M@odulo{\theM@aux}{7}
	\setcounter{M@aux}{\theM@modulo}
	\addtocounter{M@aux}{\theM@max}
}

\newcommand{\Key}[1]{
	\ifnum#1=0 \else
	\setcounter{M@key}{#1}
	\pgfmathparse{int(10*(abs(#1)-1)^(1/2)+20)}\setcounter{M@min}{\pgfmathresult}
	\pgfmathsetmacro{\M@result}{int(abs(#1)*2-23)}
	\ifnum#1>0
	\foreach\IND [count=\INDi] in {10,7,11,8,5,9,6} {
		\ifnum\INDi>#1 \else
		\M@KB{\IND}{#1}
		\M@Acc[-0.01*\theM@min]{1}{\theM@aux}
		\addtocounter{M@min}{\M@result}
		\fi
	}
	\else \ifnum#1<0
	\foreach\IND [count=\INDi] in {6,9,5,8,4,7,3} {
		\ifnum\INDi>-#1 \else		
		\M@KB{\IND}{#1}
		\M@Acc[-0.01*\theM@min]{-1}{\theM@aux}
		\addtocounter{M@min}{\M@result}
		\fi
	}
	\fi\fi
	\M@addMX \fi
}

\newcommand{\NoKey}[1]{
	\ifnum#1=0 \else
	\pgfmathparse{int(10*(abs(#1)-1)^(1/2)+20)}\setcounter{M@min}{\pgfmathresult}
	\pgfmathsetmacro{\M@result}{int(abs(#1)*2-23)}
	\ifnum#1>0
	\foreach\IND [count=\INDi] in {10,7,11,8,5,9,6} {
		\ifnum\INDi>#1 \else
		\M@KB{\IND}{1}
		\M@Acc[-0.01*\theM@min]{0}{\theM@aux}
		\addtocounter{M@min}{\M@result}
		\fi
	}
	\else\ifnum#1<0
	\foreach\IND [count=\INDi] in {6,9,5,8,4,7,3} {
		\ifnum\INDi>-#1 \else
		\M@KB{\IND}{-1}
		\M@Acc[-0.01*\theM@min]{0}{\theM@aux}
		\addtocounter{M@min}{\M@result}
		\fi
	}
	\fi\fi
	\M@addMX \fi
}


