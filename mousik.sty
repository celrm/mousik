\newif\ifMnoteBack
\pgfkeys{
	/Mnote/.is family
	, /Mnote
	, default/.style = 
	{	back = false
		, beam = 1
		, stem = 0.5
		, head = .
		, swap = false
		, tuplet = 0
		, xshift = 0
		, yshift = 0
	}
	, back/.is if=MnoteBack
	, beam/.estore in=\@Mbeam
	, stem/.estore in=\@Mstem
	, head/.estore in=\@Mhead
	, tuplet/.estore in=\@Mtuplet
	, swap/.is if=Mswap
	, xshift/.estore in=\@MshiftX
	, yshift/.estore in=\MshiftY
}
\newcounter{@Mduration}
\newcommand{\Note}[3][]{
	\pgfkeys{/Mnote, default, #1}%
	\Adv\noMswaptrue
	\setcounter{Maux}{\theMX}
	
	\begin{scope}[xshift=\@MshiftX cm,yshift=\MshiftY cm]
	\@Count{#2}\setcounter{@Mduration}{\the@count}
	\@Count{#3}
\ifnum\the@Mduration=1
	\ifnum#2=1
		\foreach\IND in {#3} {\Semibreve{\IND}\addtocounter{MX}{\Mhsep/2}}
	\else\ifnum#2=2
		\foreach\IND in {#3} {\Minim{\IND}\addtocounter{MX}{\Mhsep/2}}
	\else\ifnum#2=4
		\foreach\IND in {#3} {\Crotchet{\IND}\addtocounter{MX}{\Mhsep/2}}
	\else
		\ifnum\the@count=1
			\ifnum#2=8 \Quaver{#3} \else
			\ifnum#2=16 \Semiquaver{#3} \else
			\ifnum#2=32 \Demisemiquaver{#3} \fi\fi\fi
		\else\ifnum\the@count=2
			\@MTwoNote{#2}{#3}
		\else\ifnum\the@count>2
			\@MFlatNote{#2}{#3}
		\fi\fi\fi
	\fi\fi\fi
	
\else
	\@MMixedNote{#2}{#3}
\fi

	\setcounter{MX}{\theMaux}
	\foreach \IND in {#3} {
		\ifthenelse{\equal{\IND}{!}}{\addtocounter{MX}{\Mhsep/4}}{
		\@NotEmpty{\IND}{\Ledger{\IND}}
		\addtocounter{MX}{\Mhsep/2}}
	}
	\addtocounter{MX}{\Mhsep/2}
	
	\ifMswap\@Mswap\fi
	\ifthenelse{\equal{\@Mtuplet}{0}}{}{
		\Tuplet[\@Mtuplet]
	}
	\Mswapfalse
	
	\end{scope}
}

\newcommand{\@MMixedNote}[2]{
	\setcounter{@Mduration}{8}
	\foreach\INDd in {#1} {
		\ifnum\the@Mduration<16
			\@EqStr{\INDd}{=}{\setcounter{@Mduration}{16}}
			\@EqStr{\INDd}{=|}{\setcounter{@Mduration}{16}}
			\@EqStr{\INDd}{|=}{\setcounter{@Mduration}{16}}
			\@EqStr{\INDd}{//}{\setcounter{@Mduration}{16}}
			\@EqStr{\INDd}{//|}{\setcounter{@Mduration}{16}}
			\@EqStr{\INDd}{|//}{\setcounter{@Mduration}{16}}
		\fi\ifnum\the@Mduration<32
			\@EqStr{\INDd}{≡}{\setcounter{@Mduration}{32}}
			\@EqStr{\INDd}{≡|}{\setcounter{@Mduration}{32}}
			\@EqStr{\INDd}{|≡}{\setcounter{@Mduration}{32}}
			\@EqStr{\INDd}{///}{\setcounter{@Mduration}{32}}
			\@EqStr{\INDd}{///|}{\setcounter{@Mduration}{32}}
			\@EqStr{\INDd}{|///}{\setcounter{@Mduration}{32}}
		\fi
	}
	
	\@Heads{#2}
	\ifnum\the@max<6
		\ifMswap\setcounter{@evaluate}{\the@min}
		\else\setcounter{@evaluate}{\the@max}\fi
	\else\@Mswap
		\ifMswap\setcounter{@evaluate}{\the@max}
		\else\setcounter{@evaluate}{\the@min}\fi
	\fi
	
	\setcounter{MX}{\theMaux}
	\ifnum\the@Mduration<16
	\pgfmathsetmacro\@Sstem{\@Mstem+0.1}
	\fi\ifnum\the@Mduration=16
	\pgfmathsetmacro\@Sstem{\@Mstem+0.2}
	\fi\ifnum\the@Mduration=32
	\pgfmathsetmacro\@Sstem{\@Mstem+0.3}
	\fi
	\foreach\IND in {#2} {
		\ifthenelse{\equal{\IND}{!}}{\addtocounter{MX}{\Mhsep/4}}{
		\@NotEmpty{\IND}{
			\@Menlarge[\@Sstem]{\IND}{\the@evaluate}
		}
		\addtocounter{MX}{\Mhsep/2}}
	}

\pgfmathsetmacro\@MHigh{int(\ifnoMswap 1 \else -1 \fi * 10*\@Sstem + \the@evaluate*0.0625*10)}
\setcounter{@Mheight}{\@MHigh}
	\setcounter{Mlast}{-1}
	\ifnum\the@Mduration<16
		\pgfmathsetmacro\@Sstem{\@Mstem+0.1}
		\Be@m{\theMaux}{\the@evaluate}{\the@evaluate}{+\@Sstem}
	\fi\ifnum\the@Mduration=16
		\pgfmathsetmacro\@Sstem{\@Mstem+0.2}
		\Be@m{\theMaux}{\the@evaluate}{\the@evaluate}{+\@Sstem}
	
		\setcounter{MX}{\theMaux}
		\setcounter{@Mfirst}{-50}
		\pgfmathsetmacro\@Sstem{\@Mstem+0.05}
		\foreach\INDd in {#1} {
			\ifthenelse{\equal{\INDd}{!}}
			{\addtocounter{MX}{\Mhsep/4}}
			{\addtocounter{MX}{\Mhsep/2}}
			\@MMixedBeam{\INDd}
		}
	
	\fi\ifnum\the@Mduration=32
		\pgfmathsetmacro\@Sstem{\@Mstem+0.3}
		\Be@m{\theMaux}{\the@evaluate}{\the@evaluate}{+\@Sstem}
		
		\setcounter{MX}{\theMaux}
		\setcounter{@Mfirst}{-50}
		\pgfmathsetmacro\@Sstem{\@Mstem+0.15}
		\foreach\INDd in {#1} {
			\ifthenelse{\equal{\INDd}{!}}
				{\addtocounter{MX}{\Mhsep/4}}
				{\addtocounter{MX}{\Mhsep/2}}
				\@MMixedBeam{\INDd}
		}
	\fi
}
\newcounter{Mlast}
\newcounter{Mlasted}
\newcommand{\@MMixedBeam}[1]{
	\@EqStr{#1}{!}{\setcounter{Mlasted}{\theMlast}}
	\@EqStr{#1}{}{\setcounter{Mlasted}{-1*\theMlast}}
	%
	\setcounter{Mlast}{8}
	\@EqStr{#1}{=}
		{\setcounter{Mlast}{16}
		\Be@m[-0.275+\theMX]{-0.247+\theMX}{\the@evaluate}{\the@evaluate}{+\@Sstem}}
	\@EqStr{#1}{//}
		{\setcounter{Mlast}{16}
		\Be@m[-0.275+\theMX]{-0.247+\theMX}{\the@evaluate}{\the@evaluate}{+\@Sstem}}
	\@EqStr{#1}{=|}
		{\setcounter{Mlast}{16}
		\Be@m[-0.275+\theMX]{-0.5+\theMX}{\the@evaluate}{\the@evaluate}{+\@Sstem}}
	\@EqStr{#1}{//|}
		{\setcounter{Mlast}{16}
		\Be@m[-0.275+\theMX]{-0.5+\theMX}{\the@evaluate}{\the@evaluate}{+\@Sstem}}
	\@EqStr{#1}{|=}
		{\setcounter{Mlast}{16}
		\Be@m[\theMX]{-0.247+\theMX}{\the@evaluate}{\the@evaluate}{+\@Sstem}}
	\@EqStr{#1}{|//}
		{\setcounter{Mlast}{16}
		\Be@m[\theMX]{-0.247+\theMX}{\the@evaluate}{\the@evaluate}{+\@Sstem}}
	%
	\@EqStr{#1}{≡}
		{\setcounter{Mlast}{32}
		\Be@m[-0.275+\theMX]{-0.247+\theMX}{\the@evaluate}{\the@evaluate}{+\@Sstem}
		\Be@m[-0.275+\theMX]{-0.247+\theMX}{\the@evaluate}{\the@evaluate}{+\@Mstem}}
	\@EqStr{#1}{///}
		{\setcounter{Mlast}{32}
		\Be@m[-0.275+\theMX]{-0.247+\theMX}{\the@evaluate}{\the@evaluate}{+\@Sstem}
		\Be@m[-0.275+\theMX]{-0.247+\theMX}{\the@evaluate}{\the@evaluate}{+\@Mstem}}
	\@EqStr{#1}{≡|}
		{\setcounter{Mlast}{32}
		\Be@m[-0.275+\theMX]{-0.5+\theMX}{\the@evaluate}{\the@evaluate}{+\@Sstem}
		\Be@m[-0.275+\theMX]{-0.5+\theMX}{\the@evaluate}{\the@evaluate}{+\@Mstem}}
	\@EqStr{#1}{///|}
		{\setcounter{Mlast}{32}
		\Be@m[-0.275+\theMX]{-0.5+\theMX}{\the@evaluate}{\the@evaluate}{+\@Sstem}
		\Be@m[-0.275+\theMX]{-0.5+\theMX}{\the@evaluate}{\the@evaluate}{+\@Mstem}}
	\@EqStr{#1}{|≡}
		{\setcounter{Mlast}{32}
		\Be@m[\theMX]{-0.247+\theMX}{\the@evaluate}{\the@evaluate}{+\@Sstem}
		\Be@m[\theMX]{-0.247+\theMX}{\the@evaluate}{\the@evaluate}{+\@Mstem}}
	\@EqStr{#1}{|///}
		{\setcounter{Mlast}{32}
		\Be@m[\theMX]{-0.247+\theMX}{\the@evaluate}{\the@evaluate}{+\@Sstem}
		\Be@m[\theMX]{-0.247+\theMX}{\the@evaluate}{\the@evaluate}{+\@Mstem}}
	%
	\ifnum\theMlast>\theMlasted\else
		\ifnum\theMlast=16
			\Be@m[-0.275+\theMX]{-1.047+\theMX}{\the@evaluate}{\the@evaluate}{+\@Sstem}
		\fi\ifnum\theMlast=32
			\Be@m[-0.275+\theMX]{-1.047+\theMX}{\the@evaluate}{\the@evaluate}{+\@Sstem}
			\Be@m[-0.275+\theMX]{-1.047+\theMX}{\the@evaluate}{\the@evaluate}{+\@Mstem}
		\fi
	\fi\ifnum\theMlast=32\ifnum\theMlasted=16
		\Be@m[-0.275+\theMX]{-1.047+\theMX}{\the@evaluate}{\the@evaluate}{+\@Sstem}
	\fi\fi
	\ifnum\theMlast>-\theMlasted\else
		\ifnum\theMlast=16
			\Be@m[-0.275+\theMX]{-1.247+\theMX}{\the@evaluate}{\the@evaluate}{+\@Sstem}
		\fi\ifnum\theMlast=32
			\Be@m[-0.275+\theMX]{-1.247+\theMX}{\the@evaluate}{\the@evaluate}{+\@Sstem}
			\Be@m[-0.275+\theMX]{-1.247+\theMX}{\the@evaluate}{\the@evaluate}{+\@Mstem}
		\fi
	\fi
	\ifthenelse{\equal{#1}{}}{}{\ifthenelse{\equal{#1}{!}}{}{\setcounter{Mlasted}{-2}}}
}

