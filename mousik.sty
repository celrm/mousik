\newcommand{\Head}[1]{
	\MStringz{.}{\Mhead}{\RoundHead{#1}}
	\MStringz{o}{\Mhead}{\HollowHead{#1}}
	\MStringz{x}{\Mhead}{\CrossHead{#1}}}

\newcommand{\RoundHead}[1]{
	\ifMnoteBack
		\node [opacity=0.0] (tmp) at (\theMX*\MX-0.265,-\theMY*2-0.2+#1*0.1) {};
		\fill[rotate around={16:(tmp.center)}] (\theMX*\MX-0.01-0.265,-\theMY*2-0.195+#1*0.1) ellipse (4pt and 2.75pt);
	\else 
		\node [opacity=0.0] (tmp) at (\theMX*\MX,-\theMY*2-0.2+#1*0.1) {};
		\fill[rotate around={16:(tmp.center)}] (\theMX*\MX-0.01,-\theMY*2-0.195+#1*0.1) ellipse (4pt and 2.75pt);
	\fi
}

\newcommand{\CrossHead}[1]{
	\ifMnoteBack
		\draw (\theMX*\MX -0.125-0.265,-\theMY*2+#1*0.1 -0.1) --
		(\theMX*\MX +0.1-0.265,-\theMY*2+#1*0.1 -0.3);
		\draw (\theMX*\MX +0.1-0.265,-\theMY*2+#1*0.1 -0.1) --
		(\theMX*\MX -0.125-0.265,-\theMY*2+#1*0.1 -0.3);
	\else 
		\draw (\theMX*\MX -0.125,-\theMY*2+#1*0.1 -0.1) --
		(\theMX*\MX +0.1,-\theMY*2+#1*0.1 -0.3);
		\draw (\theMX*\MX +0.1,-\theMY*2+#1*0.1 -0.1) --
		(\theMX*\MX -0.125,-\theMY*2+#1*0.1 -0.3);
	\fi
}

\newcommand{\HollowHead}[1]{
	\ifMnoteBack
		\node [opacity=0.0] (tmp) at (\theMX*\MX-0.265,-\theMY*2-0.2+#1*0.1) {};
		\fill[black,rotate around={16:(tmp.center)}] (\theMX*\MX-0.01-0.265,-\theMY*2-0.195+#1*0.1) ellipse (4pt and 2.75pt);
		\fill[\Mcolor,rotate around={19:(tmp.center)}] (\theMX*\MX-0.01-0.265,-\theMY*2-0.195+#1*0.1) ellipse (3.2pt and 1.35pt);
	\else 
		\node [opacity=0.0] (tmp) at (\theMX*\MX,-\theMY*2-0.2+#1*0.1) {};
		\fill[black,rotate around={16:(tmp.center)}] (\theMX*\MX-0.01,-\theMY*2-0.195+#1*0.1) ellipse (4pt and 2.75pt);
		\fill[\Mcolor,rotate around={19:(tmp.center)}] (\theMX*\MX-0.01,-\theMY*2-0.195+#1*0.1) ellipse (3.2pt and 1.35pt);
	\fi
}

\newcommand{\Menlarge}[3][\Mstem]{
	\ifswap\Mswap\fi
	\ifnoswap
		\draw[line width=0.25mm]  (\theMX*\MX+0.115,-\theMY*2+#2*0.1-0.2) --
			(\theMX*\MX+0.115,-\theMY*2+#3*0.1+#1-0.2);
	\else
		\draw[line width=0.25mm]  (\theMX*\MX-0.14,-\theMY*2+#2*0.1-0.2) --
			(\theMX*\MX-0.14,-\theMY*2+#3*0.1-0.4-#1+0.2);
	\fi
	\ifswap\Mswap\fi
}
\newcommand{\Enlarge}[2]{
\Menlarge{#1}{#2}
\swapfalse
}

\newcommand{\Ledger}[1]{
	\ifnum1>#1
	\foreach\INDi in {0,...,#1} {
		\ifthenelse{\isodd{\INDi}}{}%
		{\draw (\theMX*\MX-0.25,-\theMY*2-0.2+\INDi*0.1) --
		(\theMX*\MX+0.25,-\theMY*2-0.2+\INDi*0.1);}
	}
	\fi\ifnum11<#1
	\foreach\INDi in {12,...,#1} {
		\ifthenelse{\isodd{\INDi}}{}%
		{\draw (\theMX*\MX-0.25,-\theMY*2-0.2+\INDi*0.1) --
		(\theMX*\MX+0.25,-\theMY*2-0.2+\INDi*0.1);}
	}
	\fi
}
\newcommand{\Beam}[5][\theMX]{
	\ifswap\Mswap\fi
	\ifnoswap
		\draw[line width=\Mbeam mm] (#2*\MX+0.103,-\theMY*2-0.2+#3*0.1#5) -- (#1*\MX-0.372,-\theMY*2-0.2+#4*0.1#5);
	\else
		\draw[line width=\Mbeam mm] (#2*\MX-0.153,-\theMY*2-0.2+#3*0.1-#5) -- (#1*\MX-0.625,-\theMY*2-0.2+#4*0.1-#5);
	\fi	
	\ifswap\Mswap\fi
}

\newcommand{\BeamS}[1]{
	\ifswap\Mswap\fi
	\ifnoswap
		\ifnum\theMfirst=\theMmin
		\begin{scope}
			\clip (\theMX*\MX-0.4,-\theMY*2+\theMmin*0.1-0.5) rectangle (\theMX*\MX+0.125,-\theMY*2-0.15+\theMmax*0.1#1);
			\draw[line width=\Mbeam mm] (\theMX*\MX-0.411,-\theMY*2-0.2+\theMmin*0.1#1) -- (\theMX*\MX+0.147,-\theMY*2-0.2+\theMmax*0.1#1);
		\end{scope}
		\else
		\begin{scope}
			\clip (\theMX*\MX-0.4,-\theMY*2-0.15+\theMmax*0.1#1) rectangle (\theMX*\MX+0.125,-\theMY*2+0.05+\theMmin*0.1-0.5);
			\draw[line width=\Mbeam mm] (\theMX*\MX-0.411,-\theMY*2-0.2+\theMmax*0.1#1) -- (\theMX*\MX+0.147,-\theMY*2-0.2+\theMmin*0.1#1);
		\end{scope}
		\fi
	\else
		\ifnum\theMfirst=\theMmin
		\begin{scope}
			\clip (\theMX*\MX-0.645,-\theMY*2+\theMmin*0.1-0.25-#1) rectangle (\theMX*\MX-0.129,-\theMY*2+0.2+\theMmax*0.1);
			\draw[line width=\Mbeam mm] (\theMX*\MX-0.7,-\theMY*2+\theMmin*0.1-#1-0.18) -- (\theMX*\MX-0.1,-\theMY*2+\theMmax*0.1-#1-0.18);
		\end{scope}
		\else
		\begin{scope}
			\clip (\theMX*\MX-0.65,-\theMY*2+\theMmin*0.1-0.25-#1) rectangle (\theMX*\MX-0.129,-\theMY*2+0.2+\theMmax*0.1);
			\draw[line width=\Mbeam mm] (\theMX*\MX-0.7,-\theMY*2+\theMmax*0.1-#1-0.18) -- (\theMX*\MX-0.1,-\theMY*2+\theMmin*0.1-#1-0.18);
		\end{scope}
		\fi
	\fi
	\ifswap\Mswap\fi
}

\newcommand{\Flag}[2][0]{
	\ifswap\Mswap\fi
	\ifnoswap
	\begin{scope}
		\clip (\theMX*\MX+0.13,-\theMY*2+#2*0.1-0.95+#1) rectangle (\theMX*\MX+0.35,-\theMY*2+#2*0.1-0.15+#1);
		\node at (\theMX*\MX+0.05,-\theMY*2-0.5+#2*0.1+#1) {\resizebox{0.55cm}{0.65cm}{\Acht}};
	\end{scope}
	\fill[\Mcolor] (\theMX*\MX+0.205,-\theMY*2-0.508+#2*0.1+#1) circle (1.75pt);
	\else
	\begin{scope}
		\node [opacity=0.0] (tmp) at (\theMX*\MX,-\theMY*2+0.2+#2*0.1) {};
		\clip (\theMX*\MX-0.125,-\theMY*2+#2*0.1-0.25-#1) rectangle (\theMX*\MX+0.09,-\theMY*2+#2*0.1+0.35-#1);
		\node[rotate around={180:(tmp.center)}] at (\theMX*\MX+0.175,-\theMY*2+0.265+#2*0.1+#1) {\reflectbox{\resizebox{0.55cm}{0.65cm}{\Acht}}};
	\end{scope}
	\fill[\Mcolor] (\theMX*\MX-0.035,-\theMY*2+0.139+#2*0.1-#1) circle (2pt);
	\fi
	\ifswap\Mswap\fi
}

\newcommand{\Semibreve}[1]{
	\ifMnoteBack
		\node at (\theMX*\MX-0.265,-\theMY*2-0.2+#1*0.1) {\resizebox{0.3cm}{0.2cm}{\Ganz}};
	\else
		\node at (\theMX*\MX,-\theMY*2-0.2+#1*0.1) {\resizebox{0.3cm}{0.2cm}{\Ganz}};
	\fi
}
\newcommand{\Minim}[1]{
	\HollowHead{#1}
	\ifnum#1<6\else
		\Mswap
	\fi
	\pgfmathsetmacro\Sstem{\Mstem+0.1}
	\Menlarge[\Sstem]{#1}{#1}
	
\pgfmathsetmacro\MHigh{int(\ifnoswap 1 \else -1 \fi * 10*\Sstem + #1*\MX*10)}
\setcounter{Mheight}{\MHigh}
}
\newcommand{\Crotchet}[1]{
	\Head{#1}
	\ifnum#1<6\else
		\Mswap
	\fi
	\pgfmathsetmacro\Sstem{\Mstem+0.1}
	\Menlarge[\Sstem]{#1}{#1}
	
	\pgfmathsetmacro\MHigh{int(\ifnoswap 1 \else -1 \fi * 10*\Sstem + #1*\MX*10)}
	\setcounter{Mheight}{\MHigh}
}

\newcommand{\Quaver}[1]{
	\Head{#1}
	\ifnum#1<6\else
		\Mswap
	\fi
	\pgfmathsetmacro\Sstem{\Mstem+0.2}
	\Menlarge[\Sstem]{#1}{#1}
	\Flag[\Sstem]{#1}
	
	\pgfmathsetmacro\MHigh{int(\ifnoswap 1 \else -1 \fi * 10*\Sstem + #1*\MX*10)}
	\setcounter{Mheight}{\MHigh}
}
\newcommand{\Semiquaver}[1]{
	\Head{#1}
	\ifnum#1<6\else
		\Mswap
	\fi	
	\pgfmathsetmacro\Sstem{\Mstem+0.3}
	\Menlarge[\Sstem]{#1}{#1}
	
	\pgfmathsetmacro\MHigh{int(\ifnoswap 1 \else -1 \fi * 10*\Sstem + #1*\MX*10)}
	\setcounter{Mheight}{\MHigh}
	
	\Flag[\Sstem]{#1}
	\pgfmathsetmacro\Sstem{\Mstem+0.15}
	\Flag[\Sstem]{#1}
}
\newcommand{\Demisemiquaver}[1]{
	\Head{#1}
	\ifnum#1<6\else
		\Mswap
	\fi	
	\pgfmathsetmacro\Sstem{\Mstem+0.4}
	\Menlarge[\Sstem]{#1}{#1}
	
	\pgfmathsetmacro\MHigh{int(\ifnoswap 1 \else -1 \fi * 10*\Sstem + #1*\MX*10)}
	\setcounter{Mheight}{\MHigh}
	
	\Flag[\Sstem]{#1}
