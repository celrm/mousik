%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Tools

\newcounter{@evaluate}

\newcounter{@modulo}
\newcommand{\@Modulo}[2]{
	\setcounter{@modulo}{#1}
	\setcounter{@evaluate}{#2}
	\addtocounter{@evaluate}{-1}
	\loop
	\ifnum\the@modulo>\the@evaluate
		\addtocounter{@modulo}{-#2}
		\repeat
	\ifnum\the@modulo<0
		\addtocounter{@modulo}{#2}
		\repeat
}

\newcounter{@max}
\newcommand{\@Max}[2][\the@max]{
	\setcounter{@max}{#1}
	\ifnum#2>#1
		\setcounter{@max}{#2}
	\fi
}

\newcounter{@min}
\newcommand{\@Min}[2][\the@min]{
	\setcounter{@min}{#1}
	\ifnum#2<#1
		\setcounter{@min}{#2}
	\fi
}

\newcounter{@count}
\newcommand{\@Count}[1]{
	\setcounter{@count}{0}
	\foreach\IND in {#1} {\ifthenelse{\equal{\IND}{!}}{}{\stepcounter{@count}}}
}

\newcommand{\@EqStr}[3]{%
\ifthenelse{\equal{#1}{#2}}%
{#3}{}%
}

\newcommand{\@NotEmpty}[2]{
	\ifthenelse{\equal{#1}{}}
	{}{#2}
}

