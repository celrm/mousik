\newcommand{\Artic}[3][]{
	\pgfkeys{/Martic, default, #1}%
	\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
	\begin{scope}[xshift=\M@shiftX cm,yshift=\MshiftY cm]
