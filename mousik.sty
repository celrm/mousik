\newcommand{\@KB}[2]{
	\setcounter{Maux}{#1}
	\ifnum#2<0\setcounter{@max}{3}\else\setcounter{@max}{5}\fi
	\addtocounter{Maux}{-\the@max}
	\pgfmathsetmacro\@res{int(2.74545*\theMclef-5.01818))}
	\addtocounter{Maux}{\@res}
	\@Modulo{\theMaux}{7}
	\setcounter{Maux}{\the@modulo}
	\addtocounter{Maux}{\the@max}
}

\newcommand{\Key}[1]{
	\setcounter{Mkey}{#1}
	\ifnum#1>0
	
	\pgfmathsetmacro\@result{int(10*(#1-1)^(1/2)+20)}
	\setcounter{@min}{\@result}
	
	\pgfmathsetmacro\@result{int(#1*2-23)}
	
	\foreach\IND [count=\INDi] in {10,7,11,8,5,9,6} {
		\ifnum\INDi>#1\else
			
		\@KB{\IND}{#1}
		\@MAcc[-0.01*\the@min]{1}{\theMaux}
		
		\addtocounter{@min}{\@result}
		\fi
	}
	\else\ifnum#1<0
	
	\pgfmathsetmacro\@result{int(10*(-#1-1)^(1/2)+20)}
	\setcounter{@min}{\@result}
	
	\pgfmathsetmacro\@result{int(-#1*2-23)}
	
	\foreach\IND [count=\INDi] in {6,9,5,8,4,7,3} {
		\ifnum\INDi>-#1\else
		
		\@KB{\IND}{#1}
		\@MAcc[-0.01*\the@min]{-1}{\theMaux}
		
		\addtocounter{@min}{\@result}
		\fi
	}
	\fi\fi
	\ifnum#1=0\else\addtocounter{MX}{\Mhsep/2}\fi
}
\newcommand{\NoKey}[1]{
	\ifnum#1>0
	
	\pgfmathsetmacro\@result{int(10*(#1-1)^(1/2)+20)}
	\setcounter{@min}{\@result}
	
	\pgfmathsetmacro\@result{int(#1*2-23)}
	
	\foreach\IND [count=\INDi] in {10,7,11,8,5,9,6} {
		\ifnum\INDi>#1\else
		
		\@KB{\IND}{1}
		\@MAcc[-0.01*\the@min]{0}{\theMaux}
		
		\addtocounter{@min}{\@result}
		\fi
	}
	\else\ifnum#1<0
	
	\pgfmathsetmacro\@result{int(10*(-#1-1)^(1/2)+20)}
	\setcounter{@min}{\@result}
	
	\pgfmathsetmacro\@result{int(-#1*2-23)}
	
	\foreach\IND [count=\INDi] in {6,9,5,8,4,7,3} {
		\ifnum\INDi>-#1\else
		
		\@KB{\IND}{-1}
		\@MAcc[-0.01*\the@min]{0}{\theMaux}
		
		\addtocounter{@min}{\@result}
		\fi
	}
	\fi\fi
	\ifnum#1=0\else\addtocounter{MX}{\Mhsep/2}\fi
}


