	\newcommand{\Staff}{
		\foreach\i in {0,...,\theypos} {
			\foreach\j in {0,...,4} {
				\ifnum\i=\theypos
					\draw (-0.25,-\i*2+\j*0.2) -- (\thexpos*0.5,-\i*2+\j*0.2);
				\else
					\draw (-0.25,-\i*2+\j*0.2) -- (11,-\i*2+\j*0.2);
				\fi
			}
		}
	}
	
	\newcommand{\Clef}[2][\theypos]{	
