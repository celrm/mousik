\newcommand{\Acc}[3][-0.25]{
	\ifnum#2=0
		\node at (\thexpos*0.5#1,-\theypos*2-0.2+0.1*#3)
		{{\resizebox{0.15cm}{0.35cm}{\natural}}};
	\fi\ifnum#2=1
		\node at (\thexpos*0.5#1,-\theypos*2-0.2+0.1*#3)
		{{\resizebox{0.15cm}{0.35cm}{\sharp}}};
	\fi\ifnum#2=-1
		\node at (\thexpos*0.5#1,-\theypos*2-0.1+0.1*#3) 
		{{\resizebox{0.15cm}{0.35cm}{\flat}}};
	\fi\ifnum#2=2
		\node at (\thexpos*0.5#1,-\theypos*2-0.205+0.1*#3)
		{{\resizebox{0.15cm}{0.15cm}{\doublesharp}}};
	\fi\ifnum#2=-2
	\node at (\thexpos*0.5#1,-\theypos*2-0.1+0.1*#3) 
	{{\resizebox{0.2cm}{0.35cm}{\doubleflat}}};
	\fi
}

\newcounter{aux}
\newcommand{\AccFN}[2][-0.25]{%
	\KB{#2}
	\Acc[#1]{0}{\theaux}}
\newcommand{\AccSN}[2][-0.25]{%
	\KS{#2}
	\Acc[#1]{0}{\theaux}}
\newcommand{\AccF}[2][-0.25]{%
	\KB{#2}
	\Acc[#1]{-1}{\theaux}}
\newcommand{\AccS}[2][-0.25]{%	
	\KS{#2}
	\Acc[#1]{1}{\theaux}}

\newcommand{\OR}[2]{\ifnum\ifnum#1 1\else\ifnum#2 1\else0\fi\fi
	=1%
}

\newcommand{\KB}[1]{%
	\setcounter{aux}{#1}
	\addtocounter{aux}{-3}
	%
	\ifnum\theclef=1%
	\addtocounter{aux}{-2}
	\fi\ifnum\theclef=2%
	\addtocounter{aux}{0}
	\fi\ifnum\theclef=3%
	\addtocounter{aux}{3}
	\fi\ifnum\theclef=4%
	\addtocounter{aux}{-2}
	\fi\ifnum\theclef=11%
	\addtocounter{aux}{2}
	\fi\ifnum\theclef=12%
	\addtocounter{aux}{-3}
	\fi\ifnum\theclef=13%
	\addtocounter{aux}{-1}
	\fi\ifnum\theclef=14%
	\addtocounter{aux}{1}
	\fi\ifnum\theclef=15%
	\addtocounter{aux}{3}
	\fi%
	\Modulo{\theaux}{7}
	\setcounter{aux}{\themodulo}
	\addtocounter{aux}{3}
}
\newcommand{\KS}[1]{%
