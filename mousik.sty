	\ifnoswap
		\begin{scope}
			\clip (\theMxpos*0.5+0.13,-\theMypos*2+#2*0.1-0.75+#1) rectangle (\theMxpos*0.5+0.35,-\theMypos*2+#2*0.1+0.05+#1);
			\node at (\theMxpos*0.5+0.05,-\theMypos*2-0.3+#2*0.1+#1) {\resizebox{0.55cm}{0.65cm}{\Acht}};
		\end{scope}
