			\draw[line width=1mm] (\theMxpos*0.5-0.411,-\theMypos*2+\theMmin*0.1#1) -- (\theMxpos*0.5+0.147,-\theMypos*2+\theMmax*0.1#1);
		\end{scope}
		\else
		\begin{scope}
			\clip (\theMxpos*0.5-0.4,-\theMypos*2+0.05+\theMmax*0.1#1) rectangle (\theMxpos*0.5+0.125,-\theMypos*2+0.05+\theMmin*0.1-0.3);
			\draw[line width=1mm] (\theMxpos*0.5-0.411,-\theMypos*2+\theMmax*0.1#1) -- (\theMxpos*0.5+0.147,-\theMypos*2+\theMmin*0.1#1);
		\end{scope}
		\fi
	\else
		\ifnum\theMfirst=\theMmin
