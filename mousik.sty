\pgfkeys{
	/Mtext/.is family
	, /Mtext
	, default/.style = 
	{	xshift = 0
		, yshift = 0
	}
	, xshift/.estore in=\M@shiftX
	, yshift/.estore in=\MshiftY
}
\newcommand{\Text}[2][]{
	\pgfkeys{/Mtext, default, #1}%
	\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
	\begin{scope}[xshift=\M@shiftX cm,yshift=\MshiftY cm]
	\node at (\M@realX,-\theMY*\M@vsep-0.7) {#2};
	\end{scope}
}

\newcommand{\muskern}{\kern-.15ex }
\newcommand\dynmark[1]{{\normalfont\bfseries\itshape
		\@tfor\next:=#1\do{\put@muskern\next}\/}}
\newcommand{\put@muskern}{\let\put@muskern\muskern}

\newcommand{\Dynamics}[2][]{\Text[#1]{\Large\dynmark{#2}}}

\newcommand{\Back}[1][1]{
	\setcounter{M@afterBar}{0}%
	\pgfmathparse{int(-\M@hsep-#1*\M@hsep)}
	\addtocounter{MX}{\pgfmathresult}
}

\newcommand{\Space}[1][1]{
	\setcounter{M@afterBar}{0}% explicit spacing cancels bar-to-key kerning
	\pgfmathsetmacro\SPac{int((#1) * \M@hsep * 2)}
	\ifnum\SPac<0 \else {\Adv} \fi
	\addtocounter{MX}{\SPac} \pgfmathsetmacro\M@realX{\theMX*0.0625}
}

\pgfkeys{
	/Barline/.is family
	, /Barline
	, default/.style = 
	{	t = |%
		, xshift = 0
		, yshift = 0
	}
	, t/.estore in=\M@BarT
	, xshift/.estore in=\M@shiftX
	, yshift/.estore in=\MshiftY
}
\newcommand{\M@SetBarGeometry}{%
	\M@barTwoMidsfalse
	\pgfmathsetmacro{\M@BarTopY}{-\theMY*\M@vsep+\M@staffTop}%
	\pgfmathsetmacro{\M@BarBottomY}{-\theMY*\M@vsep+\M@staffBottom}%
	\pgfmathsetmacro{\M@BarMidA}{-\theMY*\M@vsep+\M@staffMid}%
	\ifM@piano
		\ifM@pianoJoinedBars
			\M@barTwoMidstrue
			\ifnum\theM@staff=1
				\pgfmathsetmacro{\M@BarBottomY}{-\theMY*\M@vsep-\M@pianoSep+\M@staffBottom}%
				\pgfmathsetmacro{\M@BarMidB}{-\theMY*\M@vsep-\M@pianoSep+\M@staffMid}%
			\else
				\pgfmathsetmacro{\M@BarTopY}{-\theMY*\M@vsep+\M@pianoSep+\M@staffTop}%
				\pgfmathsetmacro{\M@BarMidB}{-\theMY*\M@vsep+\M@pianoSep+\M@staffMid}%
			\fi
		\fi
	\fi
	\pgfmathsetmacro{\M@BarThickTopY}{\M@BarTopY+0.007}%
	\pgfmathsetmacro{\M@BarThickBottomY}{\M@BarBottomY-0.007}%
}

\newcommand{\M@BarThin}[1][0]{%
	\draw (\M@realX+#1,\M@BarTopY) -- (\M@realX+#1,\M@BarBottomY);}
\newcommand{\M@BarThick}[1][0]{%
	\draw[line width=1mm] (\M@realX+#1,\M@BarThickTopY) -- (\M@realX+#1,\M@BarThickBottomY);}
\newcommand{\M@BarDots}[1]{%
	\node at (\M@realX+#1,\M@BarMidA) {\resizebox{0.175cm}{0.25cm}{:}};%
	\ifM@barTwoMids
		\node at (\M@realX+#1,\M@BarMidB) {\resizebox{0.175cm}{0.25cm}{:}};%
	\fi}

\newcommand{\Barline}[1][]{
	\pgfmathsetmacro\M@COmp{int(\theMX*0.0625*100-\M@long*12)}
	\pgfmathsetmacro{\M@realX}{\theMX*0.0625}
	\pgfkeys{/Barline, default, #1}%
	\M@SetBarGeometry
	\begin{scope}[xshift=\M@shiftX cm,yshift=\MshiftY cm]
	\ifthenelse{\equal{\M@BarT}{|}}%
		{\M@BarThin}{}
	\ifthenelse{\equal{\M@BarT}{:}}%
		{\draw[dashed] (\M@realX,\M@BarTopY) -- (\M@realX,\M@BarBottomY);}{}
	\ifthenelse{\equal{\M@BarT}{||}}%
		{\M@BarThin[-0.06]\M@BarThin[0.06]}{}
	\ifthenelse{\equal{\M@BarT}{|.}}%
		{\M@BarThin[-0.12]\M@BarThick}{}
	\ifthenelse{\equal{\M@BarT}{:|}}%
		{\M@BarDots{-0.24}\M@BarThin[-0.12]\M@BarThick}{}
	\ifthenelse{\equal{\M@BarT}{|:}}%
		{\M@BarThick\M@BarDots{0.24}\M@BarThin[0.12]}{}
	\ifthenelse{\equal{\M@BarT}{:|:}}%
		{\M@BarDots{-0.24}\M@BarThin[-0.12]\M@BarThick\M@BarDots{0.24}\M@BarThin[0.12]}{}
	\end{scope}
	\M@addMX \ifnum\M@COmp<0 {\M@addMX}\fi
	\setcounter{M@afterBar}{1}%
}

\newcommand{\Adv}{
	\M@addhalfMX
	\pgfmathsetmacro\C@mp{int(\M@realX*100-\M@long*12)}
	\ifnum\C@mp>0
		\BreakLine
		\ifnum\theM@clef=0 \else {\Clef[t=\theM@clef]} \fi
		\Key{\theM@key}
	\else {\M@remhalfMX} \fi
}

\newcommand{\BreakLine}{
	\Space[-1]
	\ifM@lengthSet\else
		\ifnum\theMY=0
			\pgfmathsetmacro{\M@long}{(\theMX+1)*6.25/12}%
			\M@lengthSettrue
		\fi
	\fi
	\setcounter{MX}{0}\pgfmathsetmacro{\M@realX}{0}
	\addtocounter{MY}{1}
}

\newcommand{\Tempo}[3][]{
	\ifnum#2=1
	\Text[#1]{\tikz[baseline]{\Note{#2}{3}}\Large\textbf{ = #3}}
	\else
	\Text[#1]{\tikz{\Note{#2}{1}}\Large\textbf{ = #3}}
	\fi
	\Space[-1]
}

\newcommand{\Tie}[2][]{
	\Slur[#1]{#2}{#2}
}

\newif\ifMslurSwap
\newif\ifMslurBelow
\pgfkeys{
	/MSlur/.is family
	, /MSlur
	, default/.style = 
	{	angle = 20
		, b = 0
		, e = 1
		, swap = false
		, width = 0.15
		, xshift = 0
		, yshift = 0
	}
	, angle/.estore in=\MSlurAng
	, b/.estore in=\MSlurB
	, e/.estore in=\MSlurE
	, swap/.is if=MslurSwap
	, width/.estore in=\MSlurW
	, xshift/.estore in=\M@shiftX
	, yshift/.estore in=\MshiftY
}
\newcommand{\Slur}[3][]{%
	\begingroup
	\pgfkeys{/MSlur, default, #1}%
	\pgfmathsetmacro{\M@realX}{\theMX*0.0625}%
	\pgfmathsetmacro{\M@SlurDX}{(\MSlurE)-(\MSlurB)}%
	\pgfmathsetmacro{\M@SlurDY}{0.1*((#3)-(#2))}%
	\pgfmathsetmacro{\M@SlurSlope}{atan2(\M@SlurDY,\M@SlurDX)}%
	\ifnum#2<6 \MslurBelowtrue \else \MslurBelowfalse \fi
	\ifMslurSwap
		\ifMslurBelow \MslurBelowfalse \else \MslurBelowtrue \fi
	\fi
	\begin{scope}[xshift=\M@shiftX cm,yshift=\MshiftY cm]
	\ifMslurBelow
		\pgfmathsetmacro{\M@SlurOut}{\M@SlurSlope-\MSlurAng}%
		\pgfmathsetmacro{\M@SlurIn}{\M@SlurSlope+180+\MSlurAng}%
		\draw[line width=\MSlurW mm] (-1+\MSlurB+\M@realX,-\theMY*\M@vsep+0.1*#2-0.35) to[out=\M@SlurOut,in=\M@SlurIn] (-1+\MSlurE+\M@realX,-\theMY*\M@vsep+0.1*#3-0.35);
	\else
		\pgfmathsetmacro{\M@SlurOut}{\M@SlurSlope+\MSlurAng}%
		\pgfmathsetmacro{\M@SlurIn}{\M@SlurSlope+180-\MSlurAng}%
		\draw[line width=\MSlurW mm]
		 (-1+\MSlurB+\M@realX,-\theMY*\M@vsep+0.1*#2-0.05) to[out=\M@SlurOut,in=\M@SlurIn] (-1+\MSlurE+\M@realX,-\theMY*\M@vsep+0.1*#3-0.05);
	\fi
	\end{scope}
	\endgroup
}

\newif\ifMswapS
\pgfkeys{
	/MSlurred/.is family
	, /MSlurred
	, default/.style = 
	{	angle = 20
		, b = 0
		, e = 1
		, swap = false
		, width = 0.15
		, xshift = 0
		, yshift = 0
	}
	, angle/.estore in=\MSlurredAng
	, b/.estore in=\MSlurredB
	, e/.estore in=\MSlurredE
	, swap/.is if=MswapS
	, width/.estore in=\MSlurredW
	, xshift/.estore in=\MSlurredX
	, yshift/.estore in=\MSlurredY
}
\newcounter{Mslurred}
\newcounter{MslurredB}
\newcounter{MslurredE}
\newcommand{\M@DrawSlurred}[1]{%
	\Slur[#1angle=\MSlurredAng%
		, b=\MSlurredB%
		, e=\theMslurred*0.0625+\MSlurredE-1
		, width=\MSlurredW%
		, xshift=\MSlurredX%
		, yshift=\MSlurredY%
		]%
		{\theMslurredB}{\theMslurredE}%
}
\newenvironment{Slurred}[3][]{%
\pgfmathsetmacro{\Slurraux}{int(\theMX+\M@hsep*2)}
\setcounter{Mslurred}{\Slurraux}
\pgfkeys{/MSlurred, default, #1}%
\setcounter{MslurredB}{#2}
\setcounter{MslurredE}{#3}
}{
\setcounter{M@aux}{\theMX}
\setcounter{MX}{\theMslurred}
\setcounter{Mslurred}{\theM@aux}
\addtocounter{Mslurred}{-\theMX}
\ifMswapS
	\M@DrawSlurred{swap,}%
\else
	\M@DrawSlurred{}%
\fi
\setcounter{MX}{\theM@aux}
}

\newcounter{Mcres}
\newcounter{McresMY}
\pgfkeys{
    /Mhairpin/.is family
    , /Mhairpin
    , common/.style = {
        height = 0
        , b = 0.1
        , e = -0.1
        , width = 0.15
        , xshift = 0
        , yshift = 0
    }
    , crescendo/.style = {common, begin = 0, end = 0.4}
    , decrescendo/.style = {common, begin = 0.4, end = 0}
    , height/.estore in=\M@HairpinHeight
    , begin/.estore in=\M@HairpinBeginOpen
    , end/.estore in=\M@HairpinEndOpen
    , b/.estore in=\M@HairpinB
    , e/.estore in=\M@HairpinE
    , width/.estore in=\M@HairpinW
    , xshift/.estore in=\M@HairpinX
    , yshift/.estore in=\M@HairpinY
}

\newcommand{\M@HairpinStartEnv}[2]{% #1 style, #2 key-value options
    \pgfkeys{/Mhairpin,#1}%
    \def\M@HairpinRaw{#2}%
    \ifx\M@HairpinRaw\@empty\else
        \pgfkeys{/Mhairpin,#2}%
    \fi
    \setcounter{Mcres}{\theMX}%
    \setcounter{McresMY}{\theMY}%
}

\newcommand{\M@HairpinFinishEnv}{%
    \ifnum\theMY=\theMcresMY\else
        \PackageWarning{mousik}{Hairpin crossed a score line; split it into two environments and match end/begin apertures}%
    \fi
    \pgfmathsetmacro{\M@HairpinStartX}{\theMcres*0.0625 + \M@HairpinB}%
    \pgfmathsetmacro{\M@HairpinLastNoteX}{(\theMX-2*\M@hsep)*0.0625}%
    \pgfmathsetmacro{\M@HairpinEndX}{\M@HairpinLastNoteX + \M@HairpinE}%
    \pgfmathsetmacro{\M@HairpinCenterY}{-\theMY*\M@vsep + 0.1*\M@HairpinHeight - 0.7}%
    \pgfmathsetmacro{\M@HairpinBeginHalf}{0.5*\M@HairpinBeginOpen}%
    \pgfmathsetmacro{\M@HairpinEndHalf}{0.5*\M@HairpinEndOpen}%
    \begin{scope}[xshift=\M@HairpinX cm,yshift=\M@HairpinY cm]
        \draw[line width=\M@HairpinW mm]
            (\M@HairpinStartX,\M@HairpinCenterY+\M@HairpinBeginHalf) --
            (\M@HairpinEndX,\M@HairpinCenterY+\M@HairpinEndHalf);
        \draw[line width=\M@HairpinW mm]
            (\M@HairpinStartX,\M@HairpinCenterY-\M@HairpinBeginHalf) --
            (\M@HairpinEndX,\M@HairpinCenterY-\M@HairpinEndHalf);
    \end{scope}%
}

\newenvironment{Crescendo}[1][]
    {\M@HairpinStartEnv{crescendo}{#1}}
    {\M@HairpinFinishEnv}

\newenvironment{Decrescendo}[1][]
    {\M@HairpinStartEnv{decrescendo}{#1}}
    {\M@HairpinFinishEnv}


