% The main environment

\newcounter{Mfirst}
\newcounter{MX}
\newcounter{MY}
\newcounter{Mclef}
\newcounter{Mkey}

\pgfkeys{
	/mousik/.is family
	, /mousik
	, default/.style = 
	{	indent = 0
		, long = 240
	}
	, indent/.estore in=\Mindent
	, long/.estore in=\Mlong
}

\newenvironment{mousik}[1][]{
\pgfkeys{/mousik, default, #1}%
\setcounter{MX}{0}%
\setcounter{MY}{0}%
