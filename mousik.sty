	\Flag[\Sstem]{#1}
	\pgfmathsetmacro\Sstem{\Mstem+0.1}
	\Flag[\Sstem]{#1}
}

\newcommand{\MHeads}[1]{
	\setcounter{Mfirst}{-50}
	\setcounter{Mmax}{-50}
	\setcounter{Mmin}{50}
	\foreach\IND in {#1} {
		\ifthenelse{\equal{\IND}{!}}{\addtocounter{MX}{\XM/4}}{
		\MNEmpty{\IND}{
			\Head{\IND}
			\MMax{\IND}\MMin{\IND} % max, min, first
			\ifnum\theMfirst=-50\setcounter{Mfirst}{\IND}\fi
		}
		\addtocounter{MX}{\XM/2}
	}}
}

