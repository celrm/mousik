	\ifthenelse{\equal{\M@BarT}{||}}%
		{\draw (\M@realX-0.06,-\theMY*\M@vsep+0.8) -- (\M@realX-0.06,-\theMY*\M@vsep);
		\draw (\M@realX+0.06,-\theMY*\M@vsep+0.8) -- (\M@realX+0.06,-\theMY*\M@vsep);}{}
	\ifthenelse{\equal{\M@BarT}{|.}}%
		{\draw (\M@realX-0.12,-\theMY*\M@vsep+0.8) -- (\M@realX-0.12,-\theMY*\M@vsep);
		\draw[line width=1mm] (\M@realX,-\theMY*\M@vsep+0.807) -- (\M@realX,-\theMY*\M@vsep-0.007);}{}
	\ifthenelse{\equal{\M@BarT}{:|}}%
		{\node at (\M@realX-0.24,0.4-\theMY*\M@vsep) {\resizebox{0.175cm}{0.25cm}{:}};
		\draw (\M@realX-0.12,-\theMY*\M@vsep+0.8) -- (\M@realX-0.12,-\theMY*\M@vsep);
		\draw[line width=1mm] (\M@realX,-\theMY*\M@vsep+0.807) -- (\M@realX,-\theMY*\M@vsep-0.007);}{}
	\ifthenelse{\equal{\M@BarT}{|:}}%
		{\draw[line width=1mm] (\M@realX,-\theMY*\M@vsep+0.807) -- (\M@realX,-\theMY*\M@vsep-0.007);
		\node at (\M@realX+0.24,0.4-\theMY*\M@vsep) {\resizebox{0.175cm}{0.25cm}{:}};
		\draw (\M@realX+0.12,-\theMY*\M@vsep+0.8) -- (\M@realX+0.12,-\theMY*\M@vsep);}{}
	\ifthenelse{\equal{\M@BarT}{:|:}}%
		{\node at (\M@realX-0.24,0.4-\theMY*\M@vsep) {\resizebox{0.175cm}{0.25cm}{:}};
		\draw (\M@realX-0.12,-\theMY*\M@vsep+0.8) -- (\M@realX-0.12,-\theMY*\M@vsep);
		\draw[line width=1mm] (\M@realX,-\theMY*\M@vsep+0.807) -- (\M@realX,-\theMY*\M@vsep-0.007);
		\node at (\M@realX+0.24,0.4-\theMY*\M@vsep) {\resizebox{0.175cm}{0.25cm}{:}};
		\draw (\M@realX+0.12,-\theMY*\M@vsep+0.8) -- (\M@realX+0.12,-\theMY*\M@vsep);}{}
	\end{scope}
	\M@addMX \ifnum\M@COmp<0 {\M@addMX}\fi
}

